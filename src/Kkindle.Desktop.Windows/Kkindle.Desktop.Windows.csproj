<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Thin platform head: owns Main, picks the Windows implementations of the
         Kkindle.Core platform interfaces, and hands them to the portable UI in
         Kkindle.App. All UI code lives there; nothing but wiring belongs here.
         A Linux or macOS head is a sibling of this project. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Kkindle.Desktop.Windows</RootNamespace>
    <AssemblyName>Kkindle</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Kkindle.App.WinUI\Assets\Kkindle.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Version>0.5.2</Version>
    <Product>Kkindle</Product>
    <Authors>kingstacker</Authors>
    <RepositoryUrl>https://github.com/kingstacker/Kkindle</RepositoryUrl>
    <!-- Set this at publish time to bundle a Calibre Portable/runtime directory. -->
    <KkindleCalibreRuntime Condition="'$(KkindleCalibreRuntime)' == ''">$(KKINDLE_CALIBRE_RUNTIME)</KkindleCalibreRuntime>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kkindle.App\Kkindle.App.csproj" />
    <ProjectReference Include="..\Kkindle.Core\Kkindle.Core.csproj" />
    <ProjectReference Include="..\Kkindle.Platform.Windows\Kkindle.Platform.Windows.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <Content Include="..\Kkindle.App.WinUI\Assets\Kkindle.ico" Link="Assets\Kkindle.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Kkindle.App.WinUI\Assets\Calibre-THIRD-PARTY-NOTICE.txt" Link="Calibre-THIRD-PARTY-NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Kkindle.App.WinUI\Assets\KFX-Input-THIRD-PARTY-NOTICE.txt" Link="KFX-Input-THIRD-PARTY-NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyBundledCalibreToPublish" AfterTargets="Publish" Condition="'$(KkindleCalibreRuntime)' != '' and Exists('$(KkindleCalibreRuntime)\ebook-convert.exe')">
    <ItemGroup>
      <BundledCalibreFiles Include="$(KkindleCalibreRuntime)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BundledCalibreFiles)"
      DestinationFiles="@(BundledCalibreFiles-&gt;'$(PublishDir)Calibre\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
