<Application
    x:Class="Kkindle.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="InkBrush" Color="#000000" />
            <SolidColorBrush x:Key="MutedInkBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="BorderBrush" Color="#000000" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="#000000" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="BorderBrush" Value="#000000" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,2,0,2" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="BorderBrush" Value="#000000" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
