<Application
    x:Class="Kkindle.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="InkBrush" Color="#000000" />
            <SolidColorBrush x:Key="MutedInkBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="BorderBrush" Color="#000000" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SidebarIndicatorBrush" Color="#BFBFBF" />

            <!-- Monochrome WinUI visual-state resources. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F2F2F2" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#000000" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#BFBFBF" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#000000" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#F2F2F2" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#000000" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#000000" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#BFBFBF" />

            <!-- Force every native selected/checked/focused state to the same
                 monochrome language instead of inheriting the Windows accent. -->
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#000000" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#000000" />
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#000000" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#000000" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#000000" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#000000" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#000000" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#000000" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#000000" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#000000" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#000000" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />

            <!-- Monochrome ToggleSwitch on-states. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#BFBFBF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#BFBFBF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobStrokeOn" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchKnobStrokeOnPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchKnobStrokeOnPressed" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchKnobStrokeOnDisabled" Color="#BFBFBF" />

            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#000000" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#000000" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#000000" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#000000" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#000000" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeCheckedPressed" Color="#FFFFFF" />

            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#000000" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#000000" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#000000" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="#FFFFFF" />

            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#000000" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#000000" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#000000" />
            <SolidColorBrush x:Key="GridViewItemForegroundSelected" Color="#FFFFFF" />
            <FontFamily x:Key="DefaultAppFontFamily">ms-appx:///Assets/Fonts/KingHwaOldSong-v3.0.ttf#KingHwaOldSong</FontFamily>

            <!-- Black-and-white MenuFlyout resources used by both the book context
                 menu and its nested submenus. These names are consumed by the
                 WinUI MenuFlyout templates through ThemeResource lookups. -->
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#000000" />
            <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
            <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#D9D9D9" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="#F2F2F2" />
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundBrush" Color="Transparent" />
            <Thickness x:Key="MenuFlyoutItemBorderThickness">0</Thickness>
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPressed" Color="#D9D9D9" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundDisabled" Color="#F2F2F2" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForeground" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundSubMenuOpened" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundBrush" Color="Transparent" />
            <Thickness x:Key="MenuFlyoutSubItemBorderThickness">0</Thickness>
            <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPressed" Color="#000000" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemChevronDisabled" Color="#8A8A8A" />
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#000000" />

            <Style x:Key="MonochromeMenuFlyoutPresenterStyle"
                   TargetType="MenuFlyoutPresenter"
                   BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="IsDefaultShadowEnabled" Value="False" />
            </Style>
            <Style TargetType="MenuFlyoutPresenter"
                   BasedOn="{StaticResource MonochromeMenuFlyoutPresenterStyle}" />
            <Style TargetType="MenuFlyoutItem"
                   BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="MenuFlyoutSubItem"
                   BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#000000" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#000000" />
            <Thickness x:Key="ContentDialogBorderWidth">1</Thickness>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="#000000" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="BorderBrush" Value="#000000" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            </Style>

            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="12,2,0,2" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#5A5A5A" />
                <Setter Property="BorderBrush" Value="{StaticResource SidebarIndicatorBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChildBackground" Background="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChildBackground" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#F2F2F2" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChildBackground" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#D9D9D9" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChildContent" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid x:Name="ChildContent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="3"
                                               Height="16"
                                               Fill="{TemplateBinding BorderBrush}"
                                               VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="2"
                                                      Content="{TemplateBinding Content}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SidebarSectionButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#5A5A5A" />
                <Setter Property="BorderBrush" Value="#000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SectionBackground"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <Style x:Key="LibraryIconButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource QuietButtonStyle}">
                <Setter Property="Width" Value="38" />
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ReaderToolbarButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="9,5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#242424" />
                <Setter Property="BorderBrush" Value="#D5D5D1" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ReaderButtonBackground"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ReaderButtonBackground" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#ECECEA" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ReaderButtonBackground" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#D9D9D5" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ReaderButtonContent" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ReaderButtonContent"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Stable chrome sizes keep the reader header aligned when the
                 WebView area becomes narrow or an auxiliary panel is open. -->
            <Style x:Key="ReaderHeaderButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource ReaderToolbarButtonStyle}">
                <Setter Property="Width" Value="56" />
                <Setter Property="MinWidth" Value="56" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="6,4" />
            </Style>
            <Style x:Key="ReaderHeaderIconButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource ReaderToolbarButtonStyle}">
                <Setter Property="Width" Value="38" />
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ReaderTocItemStyle" TargetType="ListViewItem">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="ReaderTocItemRoot" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ReaderTocItemRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#EFEFED" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ReaderTocItemRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#DDDDDA" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ReaderTocItemRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#DEDEDB" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ReaderTocSelectionBar" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#111111" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ReaderTocItemRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#D5D5D1" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ReaderTocSelectionBar" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#111111" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ReaderTocItemRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#CACAC6" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ReaderTocSelectionBar" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#111111" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="ReaderTocSelectionBar" Fill="Transparent" />
                                <ContentPresenter Grid.Column="1"
                                                  Padding="13,9,11,9"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="EjectButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="Width" Value="25" />
                <Setter Property="Height" Value="23" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EjectBackground" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EjectTriangle" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EjectBackground" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#D9D9D9" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EjectTriangle" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EjectTriangle" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="EjectBackground"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" />
                                <Polygon x:Name="EjectTriangle"
                                         Points="0,8 7,0 14,8"
                                         Width="14"
                                         Height="8"
                                         Fill="#000000"
                                         Stroke="#000000"
                                         StrokeThickness="1"
                                         Stretch="Fill"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Book cover shelf item container. Spacing (18/22) lives on the container, outside
                 the GridViewItem content area, so the card footprint stays exactly 154 DIP and
                 no border can ever include the inter-card spacing.
                 This style replaces the default ListViewItemPresenter (which draws no border in
                 the normal state and has no working pointer-over border thickness) with an
                 explicit ControlTemplate that draws one outline Border over the exact card
                 footprint (cover + title + author + format). VisualStateManager drives it:
                 Normal = light default border, PointerOver/Pressed = pure black, Selected*
                 states = monochrome black (keeps the Kindle device list selection behavior). -->
            <Style x:Key="BookCardItemStyle" TargetType="GridViewItem">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="Margin" Value="0,0,18,22" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <Grid x:Name="BookCardItemRoot"
                                  Background="Transparent"
                                  controls:Control.IsTemplateFocusTarget="True">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BookCardOutline"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BookCardOutline"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BookCardOutline"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#BFBFBF" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualState x:Name="Unselected" />
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BookCardOutline"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="SelectedUnfocused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BookCardOutline"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="SelectedDisabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BookCardOutline"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#BFBFBF" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BookCardOutline"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BookCardOutline"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="BookCardContent"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Border x:Name="BookCardOutline"
                                        BorderBrush="#BFBFBF"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TitleBarCaptionButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="CaptionBackground" Background="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CaptionBackground" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CaptionContent" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CaptionBackground" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#D9D9D9" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CaptionContent" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="CaptionContent"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
