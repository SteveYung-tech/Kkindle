<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Kkindle"
        xmlns:core="using:Kkindle.Core"
        xmlns:infra="using:Kkindle.Infrastructure"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        x:Class="Kkindle.MainWindow"
        x:DataType="local:MainWindow"
        Title="Kkindle"
        Width="1536"
        Height="808"
        MinWidth="1024"
        MinHeight="664"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        UseLayoutRounding="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        KeyDown="MainWindow_KeyDown">

    <Window.Resources>
        <!-- Library-presence glyph shared by the PC grid, the PC list and the
             Kindle cards. The three states (PC only / Kindle only / both) are
             drawn at the exact coordinates of the WinUI reference template:
             laptop outline with 1.5 rounded corners, reader body, open book. -->
        <DataTemplate x:Key="LibraryPresenceGlyph" x:CompileBindings="False">
            <Grid Width="23" Height="21" IsHitTestVisible="False">
                <!-- PC only: a simple laptop outline. -->
                <Grid IsVisible="{Binding ComputerOnlyPresenceVisibility}">
                    <Border Width="17"
                            Height="12"
                            Margin="3,2,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="1.5"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1.6" />
                    <Path Data="M 1,15 L 22,15 L 20,19 L 3,19 Z"
                          Fill="{StaticResource InkBrush}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top" />
                    <Rectangle Width="7"
                               Height="1.2"
                               Margin="8,15,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Fill="{StaticResource PaperBrush}" />
                </Grid>

                <!-- Kindle only: reader body, text page and home bar. -->
                <Grid Width="15"
                      Height="21"
                      IsVisible="{Binding KindleOnlyPresenceVisibility}">
                    <Border CornerRadius="2.5"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1.6">
                        <Grid>
                            <Border Margin="2.5,2.5,2.5,5"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1.2">
                                <StackPanel Margin="2,2" Spacing="1.3">
                                    <Rectangle Height="1" Fill="{StaticResource InkBrush}" />
                                    <Rectangle Height="1" Fill="{StaticResource InkBrush}" />
                                    <Rectangle Width="5" Height="1" HorizontalAlignment="Left" Fill="{StaticResource InkBrush}" />
                                    <Rectangle Height="1" Fill="{StaticResource InkBrush}" />
                                </StackPanel>
                            </Border>
                            <Rectangle Width="5"
                                       Height="1.5"
                                       Margin="0,0,0,1.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Fill="{StaticResource InkBrush}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Both libraries: an open book displayed on a laptop. -->
                <Grid IsVisible="{Binding BothLibrariesPresenceVisibility}">
                    <Border Width="18"
                            Height="13"
                            Margin="2.5,1,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="1.5"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1.6" />
                    <Path Data="M 1,15 L 22,15 L 20,19 L 3,19 Z"
                          Fill="{StaticResource InkBrush}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top" />
                    <Rectangle Width="7"
                               Height="1.2"
                               Margin="8,15,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Fill="{StaticResource PaperBrush}" />
                    <Path Data="M 5,4 L 11.5,6 L 11.5,13 L 5,11 Z"
                          Fill="{StaticResource PaperBrush}"
                          Stroke="{StaticResource InkBrush}"
                          StrokeThickness="1.3"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top" />
                    <Path Data="M 11.5,6 L 18,4 L 18,11 L 11.5,13 Z"
                          Fill="{StaticResource PaperBrush}"
                          Stroke="{StaticResource InkBrush}"
                          StrokeThickness="1.3"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top" />
                    <Ellipse Width="2.5"
                             Height="1.5"
                             Margin="10.25,12,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Fill="{StaticResource InkBrush}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Transparent window with a shadowed content host: the UI floats on the
         desktop with a soft drop shadow around the whole main interface. Two
         shadow layers (tight + diffuse) read softer than a single heavy one.
         A hairline (sub-pixel) light-grey outline marks the main interface
         edge so the floating surface stays visible against any desktop
         background. The invisible resize handles beside the shadow restore
         window resizing, which layered windows lose. -->
    <Grid>
        <Border x:Name="WindowShadowHost"
                Margin="4"
                Background="{StaticResource PaperBrush}"
                BorderBrush="#808080"
                BorderThickness="0.5"
                BoxShadow="0 1 4 0 #26000000, 0 6 20 0 #12000000">
        <Grid Background="{StaticResource PaperBrush}">
        <!-- Self-drawn square title bar. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Background="Transparent"
              Height="38"
              VerticalAlignment="Top"
              ZIndex="50">
            <Grid Grid.Column="0">
                <Border x:Name="TitleBarDragRegion"
                        Background="Transparent"
                        PointerPressed="TitleBarDragRegion_PointerPressed" />
                <TextBlock x:Name="WindowBrandText"
                           Text="Kreader"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           LetterSpacing="1.08"
                           IsHitTestVisible="False"
                           IsVisible="False" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                <Button x:Name="ReaderZenTitleTocButton"
                        Classes="caption"
                        Width="92"
                        Height="38"
                        Padding="0"
                        FontSize="11"
                        Content="极简目录"
                        AutomationProperties.Name="切换极简目录"
                        ToolTip.Tip="显示或隐藏禅模式极简目录"
                        IsVisible="False"
                        Click="ReaderZenMinimalTocButton_Click" />
                <Button x:Name="ReaderZenTitleExitButton"
                        Classes="caption"
                        Width="104"
                        Height="38"
                        Padding="0"
                        FontSize="11"
                        Content="退出禅模式"
                        AutomationProperties.Name="退出禅模式"
                        ToolTip.Tip="退出禅模式，恢复目录与阅读助手"
                        IsVisible="False"
                        Click="ReaderExitZenButton_Click" />
                <Button x:Name="MinimizeWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="MinimizeWindowButton_Click"
                        AutomationProperties.Name="最小化">
                    <Path Data="M 0,0 H 10" />
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="MaximizeWindowButton_Click"
                        AutomationProperties.Name="最大化">
                    <Path x:Name="MaximizeWindowGlyph" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                </Button>
                <Button x:Name="CloseWindowButton"
                        Classes="caption"
                        Width="46"
                        Height="38"
                        Padding="0"
                        Click="CloseWindowButton_Click"
                        AutomationProperties.Name="关闭">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="LibraryRoot"
              Grid.Row="0"
              ColumnDefinitions="200,*,0"
              Background="{StaticResource PaperBrush}"
              ZIndex="0"
              SizeChanged="LibraryRoot_SizeChanged">
            <!-- Left navigation -->
            <Border Grid.Column="0"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="18,24,18,18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="34" Height="34" Background="{StaticResource InkBrush}">
                            <TextBlock Text="K"
                                       Foreground="{StaticResource PaperBrush}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Kkindle"
                                       FontSize="18"
                                       FontWeight="Bold" />
                            <TextBlock Text="个人电子书架"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,24,0,16"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="3">
                                <Button x:Name="BookManagementSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="书籍管理" />
                                            <Path x:Name="BookManagementChevron"
                                                  Data="M 1,2 L 5,6 L 9,2"
                                                  Width="10"
                                                  Height="8"
                                                  Stroke="{StaticResource MutedInkBrush}"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="BookManagementChildren" Spacing="3">
                                    <Button x:Name="AllBooksButton"
                                            Classes="sidebarItem active"
                                            ToolTip.Tip="电脑书库：本地导入的书籍"
                                            Click="ShowAllBooksButton_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <TextBlock Text="电脑书库" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarCountText" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="KindleBooksButton"
                                            Classes="sidebarItem"
                                            ToolTip.Tip="Kindle 书库：设备上的书籍"
                                            Click="KindleBooksButton_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <TextBlock Text="Kindle书库" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DeviceBookCountText" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="ZLibraryBooksButton"
                                            Classes="sidebarItem"
                                            Content="Z-Library 在线书库"
                                            ToolTip.Tip="Z-Library 在线书库：搜索并下载电子书"
                                            Click="ZLibraryBooksButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="DeviceManagementSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="设备管理" />
                                            <Path x:Name="DeviceManagementChevron"
                                                  Data="M 2,1 L 6,5 L 2,9"
                                                  Width="10"
                                                  Height="10"
                                                  Stroke="{StaticResource MutedInkBrush}"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="DeviceManagementChildren" Spacing="3" IsVisible="False">
                                <Button x:Name="FontManagementButton"
                                            Classes="sidebarItem"
                                            Content="字体管理"
                                            ToolTip.Tip="管理 Kindle 上的字体"
                                            Click="FontManagementButton_Click" />
                                <Button x:Name="DictionaryManagementButton"
                                            Classes="sidebarItem"
                                            Content="字典管理"
                                            ToolTip.Tip="管理 Kindle 上的字典"
                                            Click="DictionaryManagementButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="ReadingSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="阅读资料" />
                                            <Path x:Name="ReadingChevron"
                                                  Data="M 1,2 L 5,6 L 9,2"
                                                  Width="10"
                                                  Height="8"
                                                  Stroke="{StaticResource MutedInkBrush}"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="ReadingChildren" Spacing="3" IsVisible="False">
                                    <Button x:Name="ReaderNotesNavigationButton"
                                            Classes="sidebarItem"
                                            Content="笔记与标注"
                                            ToolTip.Tip="统一浏览本地书籍与 Kindle 的划线、笔记和批注"
                                            Click="ReaderNotesNavigationButton_Click" />
                                    <Button x:Name="ReaderExportNavigationButton"
                                            Classes="sidebarItem"
                                            Content="导出记录"
                                            ToolTip.Tip="筛选并导出阅读资料"
                                            Click="ReaderExportNavigationButton_Click" />
                                    <Button x:Name="ReadingDashboardButton"
                                            Classes="sidebarItem"
                                            Content="阅读数据"
                                            ToolTip.Tip="查看阅读进度、时长与标注统计"
                                            Click="ReadingDashboardButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <Button x:Name="SystemSectionButton"
                                        Classes="sidebarSection"
                                        Click="SidebarSectionButton_Click">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="系统设置" />
                                            <Path x:Name="SystemChevron"
                                                  Data="M 2,1 L 6,5 L 2,9"
                                                  Width="10"
                                                  Height="10"
                                                  Stroke="{StaticResource MutedInkBrush}"
                                                  StrokeThickness="1.25"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                                <StackPanel x:Name="SystemChildren" Spacing="3" IsVisible="False">
                                    <Button x:Name="SettingsNavigationButton"
                                            Classes="sidebarItem"
                                            Content="基础设置"
                                            ToolTip.Tip="应用基础设置：常规、书库、Kindle、阅读、备份"
                                            Click="SettingsButton_Click" />
                                    <Button x:Name="KindleEmailSettingsNavigationButton"
                                            Classes="sidebarItem"
                                            Content="Kindle 邮箱设置"
                                            ToolTip.Tip="配置 SMTP 发送到 Kindle 个人文档邮箱"
                                            Click="KindleEmailSettingsButton_Click" />
                                    <Button x:Name="ZLibraryAccountNavigationButton"
                                            Classes="sidebarItem"
                                            Content="Z-Library 账号设置"
                                            ToolTip.Tip="配置 Z-Library 账号用于下载书籍"
                                            Click="ZLibraryAccountButton_Click" />
                                    <Button x:Name="ReaderAiSettingsNavigationButton"
                                            Classes="sidebarItem"
                                            Content="AI 助手设置"
                                            ToolTip.Tip="配置阅读 AI 助手的服务与 API Key"
                                            Click="ReaderAiSettingsButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="DeviceStatusBox"
                            Grid.Row="2"
                            Padding="10"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Tapped="DeviceStatusBox_Tapped"
                            ToolTip.Tip="点击选择或自定义设备型号（按串码记忆）；未连接时点击可重新检测 Kindle">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock x:Name="KindleStatusText"
                                           Text="正在检查设备…"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button x:Name="DeviceStatusEjectButton"
                                        Grid.Column="1"
                                        Classes="eject"
                                        Width="25"
                                        MinWidth="25"
                                        Height="23"
                                        IsEnabled="False"
                                        LayoutUpdated="DeviceStatusEjectButton_LayoutUpdated"
                                        ToolTip.Tip="未连接设备"
                                        AutomationProperties.Name="弹出设备"
                                        Click="EjectDeviceButton_Click">
                                    <Polygon x:Name="DeviceEjectTriangleGlyph"
                                             Classes="ejectGlyph"
                                             Points="0,8 7,0 14,8"
                                             Width="14"
                                             Height="8"
                                             Fill="Transparent"
                                             Stroke="{StaticResource InkBrush}"
                                             StrokeThickness="1"
                                             Stretch="Fill"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="KindleConnectionText" Foreground="{StaticResource MutedInkBrush}" FontSize="10" />
                            <Grid x:Name="DeviceStorageBar"
                                  Height="10"
                                  Background="{StaticResource PaperBrush}"
                                  SizeChanged="DeviceStorageBar_SizeChanged">
                                <Rectangle x:Name="DeviceStorageUsedBar" HorizontalAlignment="Left" Fill="{StaticResource InkBrush}" Width="0" />
                                <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="1" />
                            </Grid>
                            <TextBlock x:Name="DeviceStorageText" Text="无存储信息" Foreground="{StaticResource MutedInkBrush}" FontSize="10" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Rectangle Width="7" Height="7" Fill="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="已用" FontSize="9" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Rectangle Width="7" Height="7" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1" VerticalAlignment="Center" />
                                    <TextBlock Text="剩余" FontSize="9" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Local library -->
            <Grid x:Name="LibraryWorkspace"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  RowDefinitions="Auto,Auto,Auto,*,Auto">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="本地" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="电脑书库" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="LibrarySummaryText"
                               Text="{Binding ViewModel.StatusText}"
                               FontSize="12"
                               Foreground="#666666" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,18" ColumnDefinitions="420,*">
                    <TextBox x:Name="SearchBox"
                             Height="38"
                             Padding="13,7"
                             PlaceholderText="搜索标题或作者"
                             Text="{Binding ViewModel.SearchText, Mode=TwoWay}"
                             TextChanged="SearchBox_TextChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                        <Button x:Name="FilterButton" Classes="icon" ToolTip.Tip="显示或隐藏筛选条件" Click="FilterButton_Click" AutomationProperties.Name="筛选">
                            <Path Data="M 2,3 H 20 L 13,11 V 19 L 9,16 V 11 Z"
                                  Fill="Transparent"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.5" />
                        </Button>
                        <Button x:Name="LibraryViewToggleButton"
                                Classes="icon"
                                ToolTip.Tip="网格 / 列表 / 收藏夹视图"
                                AutomationProperties.Name="切换视图">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem x:Name="LibraryViewGridItem"
                                              Header="网格视图"
                                              ToggleType="Radio"
                                              IsChecked="True"
                                              Tag="Grid"
                                              Click="LibraryViewMenuItem_Click" />
                                    <MenuItem x:Name="LibraryViewListItem"
                                              Header="列表视图"
                                              ToggleType="Radio"
                                              Tag="List"
                                              Click="LibraryViewMenuItem_Click" />
                                    <MenuItem x:Name="LibraryViewCollectionsItem"
                                              Header="收藏夹视图"
                                              ToggleType="Radio"
                                              Tag="Collections"
                                              Click="LibraryViewMenuItem_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <Path x:Name="LibraryViewToggleIcon"
                                  Data="M 2,2 H 8 V 8 H 2 Z M 14,2 H 20 V 8 H 14 Z M 2,14 H 8 V 20 H 2 Z M 14,14 H 20 V 20 H 14 Z"
                                  Fill="Transparent"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.5" />
                        </Button>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource HairlineBrush}" VerticalAlignment="Center" Margin="2,0" />
                        <Button x:Name="ImportButton" Classes="icon" ToolTip.Tip="导入书籍文件或文件夹" Click="ImportButton_Click" AutomationProperties.Name="导入">
                            <Path Data="M 4,2 H 13 L 19,8 V 21 H 4 Z M 13,2 V 8 H 19 M 13,14 A 4,4 0 1,1 10,10 M 13,14 L 11,11 M 13,14 L 10,14"
                                  Fill="Transparent"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.4" />
                        </Button>
                        <Button x:Name="ExportBackupButton" Classes="icon" ToolTip.Tip="导出 Kkindle 备份" Click="ExportBackupButton_Click" AutomationProperties.Name="导出备份">
                            <Path Data="M 11,20 V 5 M 6,10 L 11,5 L 16,10 M 3,20 H 19"
                                  Fill="Transparent"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.5" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="FilterPanel"
                        Grid.Row="2"
                        Margin="0,0,0,12"
                        Padding="10"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        MaxHeight="0"
                        Opacity="0"
                        IsVisible="False">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="MaxHeight" Duration="0:0:0.18" />
                            <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*,Auto" ColumnSpacing="10">
                        <ComboBox x:Name="AuthorFilterBox" PlaceholderText="作者" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="TagFilterBox" Grid.Column="1" PlaceholderText="标签" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="FormatFilterBox" Grid.Column="2" PlaceholderText="格式" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="CategoryFilterBox" Grid.Column="3" PlaceholderText="分类" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="ReadingStatusFilterBox" Grid.Column="4" PlaceholderText="阅读状态" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <ComboBox x:Name="LibrarySortBox" Grid.Column="5" PlaceholderText="排序" SelectionChanged="FilterComboBox_SelectionChanged" />
                        <CheckBox x:Name="FavoritesOnlyCheckBox" Grid.Column="6" Content="收藏" VerticalAlignment="Center" Click="FavoritesOnlyCheckBox_Click" />
                        <Button Grid.Column="7" Classes="quiet" Content="清除筛选" Click="ClearFiltersButton_Click" />
                    </Grid>
                </Border>

            <Grid x:Name="LibraryContentHost"
                  Grid.Row="3"
                  RowDefinitions="Auto,*"
                  Background="Transparent"
                  PointerPressed="LibraryContentHost_PointerPressed"
                  DragDrop.AllowDrop="True"
                      DragDrop.DragOver="LibraryPane_DragOver"
                      DragDrop.DragLeave="LibraryPane_DragLeave"
                      DragDrop.Drop="LibraryPane_Drop">
                    <Border x:Name="CollectionHeader"
                            Padding="0,0,0,10"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="BackToCollectionsButton"
                                    Content="返回收藏夹"
                                    Padding="10,5"
                                    ToolTip.Tip="返回收藏夹列表"
                                    Click="BackToCollectionsButton_Click" />
                            <Button Content="返回全部书籍" Padding="10,5" Click="ShowAllBooksButton_Click" />
                            <TextBlock x:Name="ActiveCollectionTitleText" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                            <Button x:Name="CreateCollectionButton" Content="新建收藏夹" Padding="10,5" Click="CreateCollectionButton_Click" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="BookGrid" Classes="bookGrid" ItemsSource="{Binding ViewModel.Books}" SelectionMode="Multiple" SelectionChanged="BookList_SelectionChanged" PointerPressed="BookGrid_PointerPressed" PointerMoved="BookGrid_PointerMoved" PointerReleased="BookGrid_PointerReleased" PointerCaptureLost="BookGrid_PointerCaptureLost" KeyDown="BookGrid_KeyDown" Focusable="True" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="166" ItemHeight="292" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate>                                 <DataTemplate x:DataType="local:BookCardViewModel">                                     <Grid Width="154"                                           Margin="0,0,12,16"                                           RowDefinitions="214,Auto"                                           PointerPressed="BookCard_PointerPressed"                                           ContextRequested="BookCard_ContextRequested"                                           DoubleTapped="BookCard_DoubleTapped">                                         <Border Grid.Row="0"                                                 Classes="bookCover"                                                 Background="#D9D9D9"                                                 BorderThickness="1">                                             <Grid Background="Transparent">                                                 <TextBlock Text="BOOK"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center"                                                            Foreground="{StaticResource MutedInkBrush}"                                                            FontSize="17"                                                            IsHitTestVisible="False" />                                                 <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />                                             </Grid>                                         </Border>                                         <StackPanel Grid.Row="1"                                                     Margin="2,9,2,0"                                                     Spacing="2"                                                     IsVisible="{Binding GalleryTextVisibility}">                                             <TextBlock Text="{Binding Title}"                                                        FontSize="15"                                                        FontWeight="SemiBold"                                                        TextTrimming="CharacterEllipsis" />                                             <TextBlock Text="{Binding Authors}"                                                        FontSize="11"                                                        Foreground="{StaticResource MutedInkBrush}"                                                        TextTrimming="CharacterEllipsis" />                                             <TextBlock Text="{Binding FormatLabel}"                                                        FontSize="10"                                                            Foreground="#777777" />                                         </StackPanel>                                         <Border Grid.Row="0"                                                 Width="28"                                                 Height="28"                                                 Margin="0,5,5,0"                                                 HorizontalAlignment="Right"                                                 VerticalAlignment="Top"                                                 Background="{StaticResource PaperBrush}"                                                 BorderBrush="{StaticResource InkBrush}"                                                 BorderThickness="1"                                                 ToolTip.Tip="{Binding PresenceLabel}"                                                 AutomationProperties.Name="{Binding PresenceLabel}"                                                 IsVisible="{Binding PresenceVisibility}">                                             <ContentControl Content="{Binding}"                                                 Padding="0"                                                 HorizontalAlignment="Center"                                                 VerticalAlignment="Center"                                                 HorizontalContentAlignment="Center"                                                 VerticalContentAlignment="Center"                                                 ContentTemplate="{StaticResource LibraryPresenceGlyph}" /> </Border>                                         <!-- 格式转换进度徽标：点击可恢复转换弹窗 -->                                         <Border Grid.Row="0"                                                 Width="68"                                                 Height="25"                                                 Margin="0,0,5,38"                                                 HorizontalAlignment="Right"                                                 VerticalAlignment="Bottom"                                                 Background="{StaticResource PaperBrush}"                                                 BorderBrush="{StaticResource InkBrush}"                                                 BorderThickness="1"                                                 Tapped="BookConversionProgressIndicator_Tapped"                                                 AutomationProperties.Name="打开格式转换进度"                                                 ToolTip.Tip="格式转换进行中，点击恢复进度窗口"                                                 IsVisible="{Binding ConversionProgressVisibility}">                                             <Grid Width="66" Height="23">                                                 <ProgressBar Minimum="0"                                                              Maximum="100"                                                              Value="{Binding ConversionProgress}"                                                              Height="5"                                                              Margin="5,0,5,3"                                                              VerticalAlignment="Bottom"                                                              Background="{StaticResource PaperBrush}" />                                                 <TextBlock Text="{Binding ConversionProgressLabel}"                                                            FontSize="10"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center" />                                             </Grid>                                         </Border>                                         <Border Grid.RowSpan="2"                                                 Classes="bookOutline"                                                 BorderBrush="{StaticResource CardBorderBrush}"                                                 BorderThickness="1"                                                 IsHitTestVisible="False" />                                         <Border Grid.RowSpan="2"                                                 BorderBrush="{StaticResource InkBrush}"                                                 BorderThickness="3"                                                 IsVisible="{Binding IsMultiSelected}"                                                 IsHitTestVisible="False">                                             <Border Width="22"                                                     Height="22"                                                     Margin="6"                                                     HorizontalAlignment="Left"                                                     VerticalAlignment="Top"                                                     Background="{StaticResource InkBrush}">                                                 <TextBlock Text="✓"                                                            Foreground="{StaticResource PaperBrush}"                                                            FontSize="14"                                                            FontWeight="Bold"                                                            HorizontalAlignment="Center"                                                            VerticalAlignment="Center" />                                             </Border>                                         </Border>                                     </Grid>                                 </DataTemplate>                             </ListBox.ItemTemplate>
                        </ListBox>

                        <Canvas IsHitTestVisible="False" ZIndex="25">
                            <Border x:Name="RubberBandRectangle"
                                    Background="#33000000"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1"
                                    IsVisible="False" />
                        </Canvas>

                        <ListBox x:Name="BookList"
                                 Classes="bookList"
                                 ItemsSource="{Binding ViewModel.Books}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="BookList_SelectionChanged"
                                 IsVisible="False"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:BookCardViewModel">
                                    <Border Margin="0,0,0,7"
                                            Padding="10"
                                            Classes="bookRow"
                                            Background="{StaticResource PaperBrush}"
                                            BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1"
                                            PointerPressed="BookCard_PointerPressed"
                                            ContextRequested="BookCard_ContextRequested"
                                            DoubleTapped="BookCard_DoubleTapped">
                                        <Grid ColumnDefinitions="48,1.55*,1.65*,1.2*,140" ColumnSpacing="12">
                                            <Border Width="40" Height="56" VerticalAlignment="Center" Background="#F2F2F2" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Authors}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FileSummaryLabel}" FontSize="10" Foreground="#777777" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding OrganizationLabel}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PublicationLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding IdentifierLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding ReadingStateLabel}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DescriptionSummaryLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="5">
                                                <TextBlock Text="{Binding UpdatedLabel}" Foreground="#777777" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Border Width="26"
                                                            Height="26"
                                                            Background="{StaticResource PaperBrush}"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1"
                                                            ToolTip.Tip="{Binding PresenceLabel}"
                                                            AutomationProperties.Name="{Binding PresenceLabel}"
                                                            IsVisible="{Binding PresenceVisibility}">
                                                        <ContentControl Content="{Binding}"
                                                       Padding="0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       HorizontalContentAlignment="Center"
                                                       VerticalContentAlignment="Center"
                                                       ContentTemplate="{StaticResource LibraryPresenceGlyph}" />
</Border>
                                                    <Button Tag="{Binding}" Content="打开" Padding="10,5" Click="OpenCardButton_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.ColumnSpan="5"
                                                    BorderBrush="{StaticResource InkBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding IsSelected}"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer x:Name="CollectionScroll"
                                      IsVisible="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ContextRequested="CollectionScroll_ContextRequested">
                            <ItemsControl x:Name="CollectionList" ItemsSource="{Binding CollectionFolders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemWidth="210" ItemHeight="142" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:BookCollectionFolderViewModel">
                                        <Grid Width="210"
                                              Height="142"
                                              Tapped="CollectionFolder_Tapped"
                                              ContextRequested="CollectionFolder_ContextRequested">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="94" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <!-- Folder icon: light-grey body, top tab and
                                                 three overlapping cover thumbnails. -->
                                            <Grid Width="174" Height="86" Margin="8,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Border Margin="0,14,0,0"
                                                        Background="#F1F1F1"
                                                        BorderBrush="{StaticResource InkBrush}"
                                                        BorderThickness="1" />
                                                <Border Width="72"
                                                        Height="21"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="#F1F1F1"
                                                        BorderBrush="{StaticResource InkBrush}"
                                                        BorderThickness="1,1,1,0" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="-6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="0,6,0,0">
                                                    <Border Width="44"
                                                            Height="62"
                                                            Background="#E4E4E4"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#5A5A5A"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover1}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="44"
                                                            Height="62"
                                                            Margin="0,4,0,0"
                                                            Background="#E4E4E4"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#5A5A5A"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover2}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="44"
                                                            Height="62"
                                                            Background="#E4E4E4"
                                                            BorderBrush="{StaticResource InkBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="BOOK"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#5A5A5A"
                                                                       FontSize="8" />
                                                            <Image Source="{Binding Cover3}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="9,7,1,0" Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding BookCountLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyLibraryState"
                                    Width="320"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    IsVisible="False"
                                    IsHitTestVisible="False">
                            <!-- Open-book illustration for the empty state. -->
                            <Grid Width="64" Height="52" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Path Data="M 4,8 L 30,5 L 30,44 L 4,47 Z M 30,5 L 60,8 L 60,47 L 30,44 Z"
                                      Stroke="{StaticResource InkBrush}"
                                      StrokeThickness="1.5"
                                      Fill="{StaticResource PaperBrush}" />
                                <Path Data="M 30,5 L 30,44"
                                      Stroke="{StaticResource InkBrush}"
                                      StrokeThickness="1.5" />
                                <StackPanel Margin="10,11,0,0" Spacing="5" IsHitTestVisible="False">
                                    <Rectangle Width="12" Height="2" Fill="{StaticResource InkBrush}" />
                                    <Rectangle Width="12" Height="2" Fill="{StaticResource InkBrush}" />
                                    <Rectangle Width="8" Height="2" Fill="{StaticResource InkBrush}" />
                                </StackPanel>
                                <StackPanel Margin="34,11,0,0" Spacing="5" IsHitTestVisible="False">
                                    <Rectangle Width="12" Height="2" Fill="{StaticResource InkBrush}" />
                                    <Rectangle Width="12" Height="2" Fill="{StaticResource InkBrush}" />
                                    <Rectangle Width="9" Height="2" Fill="{StaticResource InkBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="EmptyLibraryTitleText"
                                       Text="电脑书库还是空的"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="EmptyLibraryMessageText"
                                       Text="拖入书籍文件，或使用上方的导入按钮"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border x:Name="LibraryDropOverlay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="34,24"
                                Background="{StaticResource PaperBrush}"
                                BorderBrush="{StaticResource InkBrush}"
                                BorderThickness="2"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                ZIndex="30">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <TextBlock Text="松开以导入书籍"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="支持 EPUB、PDF、MOBI、AZW3"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="MultiSelectionBar"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,16"
                            Padding="14,8"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="2"
                            IsVisible="False"
                            ZIndex="20">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="MultiSelectionText" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button Content="发送到 Kindle" Padding="12,6" Click="SendSelectedBooksToKindleBatchButton_Click" />
                            <Button Content="邮件发送" Padding="12,6" Click="SendSelectedBooksByEmailBatchButton_Click" />
                            <Button x:Name="DeleteSelectedBooksButton" Content="删除所选" Padding="12,6" Click="DeleteSelectedBooksButton_Click" />
                            <Button Content="取消选择" Padding="12,6" Click="ClearMultiSelectionButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock x:Name="TaskStatusText" Text="准备就绪" FontSize="11" Foreground="#666666" VerticalAlignment="Center" />
                    <ProgressBar x:Name="LibraryBusyProgress" Grid.Column="1" Width="120" Height="5" IsIndeterminate="True" IsVisible="False" />
                </Grid>
            </Grid>

            <!-- Details panel: the layout follows the old WinUI detail pane:
                 cover and three square action buttons first, then labelled
                 metadata fields and the save/delete row. -->
            <Border x:Name="LibraryDetailPane"
                    Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,70,24,24" Spacing="13">
                            <Grid HorizontalAlignment="Left" ColumnDefinitions="180,34" ColumnSpacing="12">
                                <Border Width="180"
                                        Height="250"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource PaperBrush}"
                                        BorderBrush="{StaticResource InkBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="DetailCoverImage" Stretch="UniformToFill" />
                                        <TextBlock x:Name="DetailCoverPlaceholder"
                                                   Text="未选择书籍"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1"
                                      Height="250"
                                      VerticalAlignment="Top"
                                      RowDefinitions="*,*,*">
                                    <Button x:Name="DetailDoubanButton"
                                            Classes="quiet"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="从豆瓣匹配书籍信息"
                                            ToolTip.Tip="豆瓣匹配"
                                            Click="DoubanMatchButton_Click">
                                        <!-- Magnifier glyph (WinUI E721). -->
                                        <Path Data="M 3,8 a 5,5 0 1,0 10,0 a 5,5 0 1,0 -10,0 M 11.5,11.5 L 16,16"
                                              Stroke="{StaticResource InkBrush}"
                                              StrokeThickness="1.5"
                                              Fill="Transparent"
                                              Width="18"
                                              Height="18" />
                                    </Button>
                                    <Button x:Name="DetailFavoriteButton"
                                            Grid.Row="1"
                                            Classes="quiet"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="收藏状态"
                                            ToolTip.Tip="收藏状态"
                                            Click="DetailFavoriteButton_Click">
                                        <!-- Five-point star (WinUI E734/E735); the
                                             code-behind fills it when favorite. -->
                                        <Path x:Name="DetailFavoriteIcon"
                                              Data="M 8,2 L 9.8,6.3 L 14.5,6.6 L 11,9.7 L 12.1,14.2 L 8,11.8 L 3.9,14.2 L 5,9.7 L 1.5,6.6 L 6.2,6.3 Z"
                                              Stroke="{StaticResource InkBrush}"
                                              StrokeThickness="1.2"
                                              Fill="Transparent"
                                              Width="18"
                                              Height="18" />
                                    </Button>
                                    <Button x:Name="DetailReadingStatusButton"
                                            Grid.Row="2"
                                            Classes="quiet"
                                            Width="34"
                                            MinWidth="0"
                                            Height="34"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="阅读状态"
                                            ToolTip.Tip="阅读状态"
                                            Click="DetailReadingStatusButton_Click">
                                        <!-- Reading-state glyph (WinUI E8A4/E736/E73E):
                                             the code-behind swaps the outline. -->
                                        <Path x:Name="DetailReadingStatusIcon"
                                              Data="M 5,2.5 L 12,2 L 12,14 L 5,14.5 Z M 5,5 L 12,4.5 M 5,8 L 12,7.5 M 5,11 L 12,10.5"
                                              Stroke="{StaticResource InkBrush}"
                                              StrokeThickness="1.2"
                                              Fill="Transparent"
                                              Width="18"
                                              Height="18" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <StackPanel Spacing="5">
                                <TextBlock Text="标题" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailTitleText" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="作者" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailAuthorsText" FontSize="13" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="豆瓣评分（只读）" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailDoubanRatingBox" IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="标签" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailTagsBox" PlaceholderText="多个标签用逗号分隔" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="分类" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailCategoryBox" PlaceholderText="例如：技术、文学" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="简介" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailDescriptionBox" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="出版信息"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedInkBrush}" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="系列" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailSeriesBox" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="出版社" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBox x:Name="DetailPublisherBox" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="出版年" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailPublishDateBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="ISBN" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailIsbnBox" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="页数" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailPageCountBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="装帧" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBox x:Name="DetailBindingBox" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,8,0,2" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button x:Name="SaveDetailsButton"
                                        Content="保存修改"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="SaveDetailsButton_Click" />
                                <Button Grid.Column="1"
                                        Classes="detailDelete"
                                        Content="从书库删除"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="DeleteSelectedBookButton_Click" />
                            </Grid>

                            <!-- Compatibility fields used by the current
                                 Avalonia handlers but hidden because the old
                                 detail pane does not show these sections. -->
                            <StackPanel IsVisible="False">
                                <TextBlock x:Name="DetailStateText" />
                                <TextBlock x:Name="DetailOrganizationText" />
                                <TextBlock x:Name="DetailPublicationText" />
                                <TextBlock x:Name="DetailIdentifierText" />
                                <TextBlock x:Name="DetailDescriptionText" />
                                <ItemsControl x:Name="DetailFiles" />
                                <ComboBox x:Name="DetailCollectionBox" />
                                <Button x:Name="CollectionMembershipButton" Click="CollectionMembershipButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Keep scrolled detail content out of the custom title-bar
                         drag area, as in the old WinUI pane. -->
                    <Border Height="38"
                            VerticalAlignment="Top"
                            Background="{StaticResource PaperBrush}"
                            IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Stage 3: Kindle book library. The page stays deliberately
                 simple and monochrome; all device work is performed by the
                 platform service behind the portable UI. -->
            <Grid x:Name="DevicePage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*,Auto">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="设备" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Kindle书库" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                        <Button x:Name="DeviceNameButton"
                                Classes="quiet"
                                Padding="6,3"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                AutomationProperties.Name="设备型号"
                                ToolTip.Tip="点击选择设备型号"
                                Click="DeviceNameButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="DevicePageDeviceText"
                                           Text="未检测到设备"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           VerticalAlignment="Center" />
                                <Path Data="M 1,2 L 5,6 L 9,2"
                                      Width="10"
                                      Height="8"
                                      Stroke="{StaticResource MutedInkBrush}"
                                      StrokeThickness="1.25"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="DevicePageStatusText" Text="正在检查设备…" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Classes="quiet"
                                Width="38"
                                MinWidth="38"
                                Height="38"
                                Padding="0"
                                ToolTip.Tip="刷新设备"
                                AutomationProperties.Name="刷新设备"
                                Click="RefreshDevicesButton_Click">
                            <Path Data="M 10,4 A 6,6 0 1,1 4,10 M 10,4 L 10,1 M 4,10 L 1,10"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.6"
                                  Fill="Transparent"
                                  Width="18"
                                  Height="18" />
                        </Button>
                        <Button x:Name="DeviceViewToggleButton"
                                Classes="quiet"
                                Width="38"
                                MinWidth="38"
                                Height="38"
                                Padding="0"
                                ToolTip.Tip="网格 / 列表视图"
                                AutomationProperties.Name="切换视图">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem x:Name="DeviceViewGridItem"
                                              Header="网格视图"
                                              ToggleType="Radio"
                                              IsChecked="True"
                                              Tag="Grid"
                                              Click="DeviceViewMenuItem_Click" />
                                    <MenuItem x:Name="DeviceViewListItem"
                                              Header="列表视图"
                                              ToggleType="Radio"
                                              Tag="List"
                                              Click="DeviceViewMenuItem_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <Path x:Name="DeviceViewToggleIcon"
                                  Data="M 2,2 H 8 V 8 H 2 Z M 14,2 H 20 V 8 H 14 Z M 2,14 H 8 V 20 H 2 Z M 14,14 H 20 V 20 H 14 Z"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.4"
                                  Fill="Transparent"
                                  Width="18"
                                  Height="18" />
                        </Button>
                        <Button x:Name="EjectDeviceButton"
                                Classes="quiet"
                                Width="38"
                                MinWidth="38"
                                Height="38"
                                Padding="0"
                                Click="EjectDeviceButton_Click"
                                IsEnabled="False">
                            <Polygon Points="0,8 7,0 14,8"
                                     Width="14"
                                     Height="8"
                                     Fill="{StaticResource InkBrush}"
                                     Stroke="{StaticResource InkBrush}"
                                     StrokeThickness="1" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="DeviceBookGridScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DeviceBooks}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="154" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:KindleBookCardViewModel">
                                <Grid Width="154"
                                      Margin="0,0,20,24"
                                      PointerPressed="DeviceBook_PointerPressed"
                                      PointerEntered="DeviceBook_PointerEntered"
                                      PointerExited="DeviceBook_PointerExited"
                                      DoubleTapped="DeviceBook_DoubleTapped"
                                      ContextRequested="DeviceBook_ContextRequested">
                                    <Grid RowDefinitions="214,Auto">
                                        <Border Classes="bookCover" Background="#D9D9D9" BorderThickness="1">
                                            <ToolTip.Tip>
                                                <ToolTip>
                                                    <StackPanel MaxWidth="360" Spacing="4">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Authors}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding RelativePath}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToolTip.Tip>
                                            <Grid>
                                                <TextBlock Text="KINDLE" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#777777" FontSize="13" />
                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                <Border Height="4" VerticalAlignment="Top" Background="{StaticResource InkBrush}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="2,9,2,0" Spacing="2" IsVisible="{Binding GalleryTextVisibility}">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                            <TextBlock Text="{Binding Authors}" FontSize="11" Foreground="#666666" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding InfoLabel}" FontSize="10" Foreground="#777777" />
                                        </StackPanel>
                                        <!-- 与电脑书库一致：悬停或选中时整卡黑色细边框，
                                             多选时左上角附加 ✓ 徽标。 -->
                                        <Border Grid.RowSpan="2" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" IsVisible="{Binding IsFrameVisible}" IsHitTestVisible="False">
                                            <Border Width="22" Height="22" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource InkBrush}" IsVisible="{Binding IsMultiSelected}">
                                                <TextBlock Text="✓" Foreground="{StaticResource PaperBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Border>
                                        <Border Width="28" Height="28" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" ToolTip.Tip="{Binding PresenceLabel}" AutomationProperties.Name="{Binding PresenceLabel}">
                                            <ContentControl Content="{Binding}"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ContentTemplate="{StaticResource LibraryPresenceGlyph}" />
</Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ScrollViewer x:Name="DeviceBookListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <ItemsControl ItemsSource="{Binding DeviceBooks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:KindleBookCardViewModel">
                                <Border BorderBrush="{StaticResource HairlineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,9"
                                        PointerPressed="DeviceBook_PointerPressed"
                                        DoubleTapped="DeviceBook_DoubleTapped"
                                        ContextRequested="DeviceBook_ContextRequested">
                                    <Grid ColumnDefinitions="54,2*,*,180" ColumnSpacing="10" MinHeight="72">
                                        <Grid Width="42" Height="56" VerticalAlignment="Center">
                                            <Border Background="#D9D9D9" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border Width="18"
                                                    Height="18"
                                                    Margin="0,0,0,2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Background="{StaticResource PaperBrush}"
                                                    BorderBrush="{StaticResource InkBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding PresenceVisibility}"
                                                    ToolTip.Tip="{Binding PresenceLabel}"
                                                    AutomationProperties.Name="{Binding PresenceLabel}">
                                                <ContentControl Content="{Binding}"
                                                                Padding="0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                ContentTemplate="{StaticResource LibraryPresenceGlyph}"
                                                                RenderTransformOrigin="0.5,0.5">
                                                    <ContentControl.RenderTransform>
                                                        <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                                                    </ContentControl.RenderTransform>
                                                </ContentControl>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding GalleryTextVisibility}">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Authors}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FileName}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding InfoLabel}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ModifiedLabel}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding RelativePath}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip.Tip="{Binding RelativePath}" />
                                            <TextBlock Text="{Binding HashLabel}" Foreground="#999999" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border x:Name="DeviceBookSelectionBar"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        Padding="12,8"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2"
                        IsVisible="False"
                        ZIndex="20">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="DeviceBookSelectionText" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Content="导出到电脑书库" Padding="11,6" Click="ExportSelectedDeviceBooksButton_Click" />
                        <Button Content="删除所选" Padding="11,6" Click="DeleteSelectedDeviceBooksButton_Click" />
                        <Button Content="取消选择" Padding="11,6" Click="ClearDeviceBookSelectionButton_Click" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="2" x:Name="DeviceBookEmptyText" Text="连接 Kindle 后扫描书籍。" Foreground="#666666" Margin="0,10,0,0" />
            </Grid>

            <!-- Stage 3: fonts and dictionaries on the connected Kindle. -->
            <Grid x:Name="DeviceResourcePage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*,Auto"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragOver="DeviceResourcePage_DragOver"
                  DragDrop.Drop="DeviceResourcePage_Drop">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="设备" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="DeviceResourcePageTitle" Text="Kindle 字体" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Name="DeviceResourceDeviceText" Text="未检测到设备" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="USB 磁盘" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock x:Name="DeviceResourcePathText" Text="Kindle\fonts" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                            <TextBlock x:Name="DeviceResourceCountText" Text="0 个文件" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="DeviceResourceStatusText" Text="请连接 Kindle" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Name="ImportDeviceResourceButton" Content="导入到 Kindle" Padding="11,6" Click="ImportDeviceResourceButton_Click" />
                        <Button x:Name="ExportDeviceResourceButton" Content="导出所选" Classes="quiet" IsEnabled="False" Padding="11,6" Click="ExportDeviceResourceButton_Click" />
                        <Button x:Name="DeleteDeviceResourceButton" Content="删除所选" Classes="quiet" IsEnabled="False" Padding="11,6" Click="DeleteDeviceResourceButton_Click" />
                        <Button Content="刷新" Classes="quiet" Padding="11,6" Click="RefreshDeviceResourcesButton_Click" />
                        <Button Content="返回书架" Padding="11,6" Click="ShowAllBooksButton_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <ListBox x:Name="DeviceResourceList"
                             ItemsSource="{Binding DeviceResources}"
                             SelectionMode="Single"
                             SelectionChanged="DeviceResourceList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:KindleDeviceResource">
                                <Border BorderBrush="#BFBFBF" BorderThickness="1" Padding="10,8">
                                    <Grid ColumnDefinitions="2*,90,110" ColumnSpacing="16">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Format}" Foreground="{StaticResource MutedInkBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="DeviceResourceEmptyText"
                               Text="此目录中没有可管理的文件"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedInkBrush}" />
                </Grid>
                <TextBlock Grid.Row="2" x:Name="DeviceResourceSafetyText" Margin="0,12,0,0" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
            </Grid>

            <!-- Stage 3: local and Kindle reading materials. -->
            <Grid x:Name="ReadingMaterialsPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,Auto,Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="资料" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="ReadingMaterialsPageTitle" Text="笔记与标注" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock x:Name="ReadingMaterialsStatusText" Text="本地资料已读取 · Kindle 0 条" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ReadingMaterialsNotesActions" Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Name="ReadingMaterialsLocateButton" Content="在阅读器中定位" Classes="quiet" IsEnabled="False" Padding="11,6" Click="ReadingMaterialsLocateButton_Click" />
                        <Button x:Name="DeleteReadingMaterialsButton" Content="删除所选" Classes="quiet" IsEnabled="False" Padding="11,6" Click="DeleteReadingMaterialsButton_Click" />
                        <Button Content="刷新" Classes="quiet" Padding="11,6" Click="RefreshReadingMaterialsButton_Click" />
                        <Button x:Name="ReadingMaterialsBackButton" Content="返回书架" Padding="11,6" Click="ShowAllBooksButton_Click" />
                    </StackPanel>
                    <StackPanel x:Name="ReadingMaterialsExportActions" Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" IsVisible="False">
                        <Button Content="刷新资料" Classes="quiet" Padding="11,6" Click="RefreshReadingMaterialsButton_Click" />
                        <Button Content="返回书架" Padding="11,6" Click="ShowAllBooksButton_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,14,0,14" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                        <StackPanel Spacing="11">
                            <TextBlock Text="来源" FontSize="12" />
                            <ComboBox x:Name="ReadingMaterialsSourceBox" SelectedIndex="0" SelectionChanged="ReadingMaterialsSourceBox_SelectionChanged">
                                <ComboBoxItem Content="全部来源" Tag="all" />
                                <ComboBoxItem Content="本地书库" Tag="local" />
                                <ComboBoxItem Content="Kindle" Tag="kindle" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="11">
                            <TextBlock Text="搜索" FontSize="12" />
                            <TextBox x:Name="ReadingMaterialsSearchBox" PlaceholderText="书名、划线、笔记或位置" TextChanged="ReadingMaterialsSearchBox_TextChanged" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border x:Name="ReadingMaterialsSummaryBorder"
                        Grid.Row="2"
                        Padding="16,12"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2">
                    <TextBlock x:Name="ReadingMaterialsSummaryText" Text="本地 0 条 · Kindle 0 条 · 当前显示 0 条" FontSize="16" FontWeight="Bold" />
                </Border>
                <Border x:Name="ReadingMaterialsExportPanel"
                        Grid.Row="2"
                        Padding="16,14"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2"
                        IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="导出当前筛选结果" FontSize="16" FontWeight="Bold" />
                            <TextBlock x:Name="ReadingMaterialsExportScopeText"
                                       Text="当前筛选范围：全部来源 · 共 0 条记录"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Markdown 适合保留标题层级；纯文本适合在任意设备上阅读。"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="导出 Markdown" Padding="11,6" Click="ExportReadingMaterialsMarkdownButton_Click" />
                            <Button Content="导出文本" Classes="quiet" Padding="11,6" Click="ExportReadingMaterialsTextButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="ReadingMaterialsExportSummaryBorder"
                        Grid.Row="3"
                        Margin="0,18,0,0"
                        Padding="16,12"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2"
                        IsVisible="False">
                    <TextBlock x:Name="ReadingMaterialsExportSummaryText" Text="导出预览 · 本地 0 条 · Kindle 0 条 · 当前将导出 0 条" FontSize="16" FontWeight="Bold" />
                </Border>
                <Grid Grid.Row="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReadingMaterialGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:Stage3ReadingMaterialGroupViewModel">
                                    <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="1" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="12" Margin="12">
                                                <Border Width="48" Height="64" Background="#E4E4E4" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="BOOK" FontSize="8" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoCover}" />
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BookTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                                        <TextBlock Text="{Binding CountLabel}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                                    </StackPanel>
                                                    <StackPanel IsVisible="{Binding IsCollapsed}" Spacing="2">
                                                        <TextBlock Text="{Binding PreviewQuoteLabel}" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        <TextBlock Text="{Binding PreviewNoteLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        <TextBlock Text="{Binding PreviewDateLabel}" FontSize="10" Foreground="#777777" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Tag="{Binding}"
                                                        Content="{Binding ExpandLabel}"
                                                        Classes="quiet"
                                                        Padding="10,5"
                                                        VerticalAlignment="Center"
                                                        Click="ReadingMaterialGroupToggleButton_Click" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:Stage3ReadingMaterialViewModel">
                                                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="12,10" DoubleTapped="ReadingMaterialEntry_DoubleTapped">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                                          VerticalAlignment="Top"
                                                                          Click="ReadingMaterialSelectionChanged" />
                                                                <StackPanel Grid.Column="1" Spacing="3">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding ChapterLabel}" FontSize="11" Foreground="#555555" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding QuoteLabel}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding NoteLabel}" FontSize="11" Foreground="#555555" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Location}" FontSize="11" Foreground="#777777" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="#777777" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="ReadingMaterialsEmptyText" Text="没有符合条件的阅读资料。" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Reading dashboard keeps the WinUI statistics surface separate
                 from editable application settings. -->
            <Grid x:Name="ReadingDashboardPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="统计" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="阅读数据" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock x:Name="ReadingDashboardSummaryText"
                                   Text="已开始 0 本 · 已读完 0 本 · 累计 0.0 小时"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ReadingDashboardDetailText"
                                   Text="平均进度 0% · 书签 0 条 · 批注 0 条"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel IsVisible="False">
                            <TextBlock x:Name="ReadingDashboardStatusText" />
                            <TextBlock x:Name="DashboardAverageProgressText" />
                            <TextBlock x:Name="DashboardAnnotationsText" />
                            <TextBlock x:Name="DashboardRecentText" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="刷新统计" Click="RefreshReadingDashboardButton_Click" />
                        <Button Content="导出 CSV" Classes="quiet" Click="ExportReadingDashboardButton_Click" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                            <Border Padding="14" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="累计阅读" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardTotalTimeText" Text="0 秒" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="14" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="已开始" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBooksStartedText" Text="0 本" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="14" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="已读完" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBooksFinishedText" Text="0 本" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Padding="14" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="书签 / 批注" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock x:Name="DashboardBookmarksText" Text="0 / 0" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="270,270" ColumnSpacing="16" RowSpacing="16">
                            <Border Padding="14" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="近 14 天阅读时长" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="每天有效阅读分钟数" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                    <ItemsControl ItemsSource="{Binding DashboardDays}" AutomationProperties.Name="近十四天每天阅读时长柱状图">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardDayViewModel">
                                                <Grid Width="52" Height="190" RowDefinitions="*,Auto,Auto" Margin="0,0,5,0">
                                                    <Border VerticalAlignment="Bottom" Height="{Binding BarHeight}" Background="{StaticResource InkBrush}" ToolTip.Tip="{Binding TimeLabel}" />
                                                    <TextBlock Grid.Row="1" Text="{Binding TimeLabel}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <TextBlock Grid.Row="2" Text="{Binding DateLabel}" FontSize="9" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="14" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="单本阅读时长" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="累计阅读时长最高的书籍" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                    <ItemsControl ItemsSource="{Binding DashboardBookTimes}" AutomationProperties.Name="单本书累计阅读时长排行">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardBarViewModel">
                                                <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8" Margin="0,3" ToolTip.Tip="{Binding ValueLabel}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Width="{Binding BarWidth}" Height="12" Background="{StaticResource InkBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Padding="14" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="阅读进度分布" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="按当前阅读百分比分组" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                    <ItemsControl ItemsSource="{Binding DashboardProgressBuckets}" AutomationProperties.Name="阅读进度区间分布柱状图">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardBarViewModel">
                                                <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8" Margin="0,3" ToolTip.Tip="{Binding ValueLabel}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Width="{Binding BarWidth}" Height="12" Background="{StaticResource InkBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Padding="14" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="阅读状态分布" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="阅读中与已完成书籍数量" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                    <ItemsControl ItemsSource="{Binding DashboardReadingStatuses}" AutomationProperties.Name="阅读中与已完成书籍分布柱状图">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Stage3DashboardBarViewModel">
                                                <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8" Margin="0,3" ToolTip.Tip="{Binding ValueLabel}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Width="{Binding BarWidth}" Height="12" Background="{StaticResource InkBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Stage 3: Z-Library search and download. -->
            <Grid x:Name="ZLibraryPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,*,Auto">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="{StaticResource InkBrush}" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="在线" Foreground="{StaticResource PaperBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="Z-Library 在线书库" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="让全球的知识和文献对所有人触手可及"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ZLibraryStatusText"
                               Margin="0,3,0,0"
                               Text="未配置账号，可搜索书籍；下载前需要登录 Z-Library。"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,22,0,18">
                    <TextBox x:Name="ZLibrarySearchBox"
                             Height="38"
                             Padding="13,7"
                             PlaceholderText="搜索书名或作者"
                             KeyDown="ZLibrarySearchBox_KeyDown" />
                    <ComboBox x:Name="ZLibraryExtensionBox"
                              Grid.Column="1"
                              Width="110"
                              Height="38"
                              SelectedIndex="0">
                        <ComboBoxItem Content="全部格式" Tag="" />
                        <ComboBoxItem Content="EPUB" Tag="epub" />
                        <ComboBoxItem Content="PDF" Tag="pdf" />
                        <ComboBoxItem Content="MOBI" Tag="mobi" />
                        <ComboBoxItem Content="AZW3" Tag="azw3" />
                        <ComboBoxItem Content="FB2" Tag="fb2" />
                        <ComboBoxItem Content="DJVU" Tag="djvu" />
                        <ComboBoxItem Content="TXT" Tag="txt" />
                    </ComboBox>
                    <ComboBox x:Name="ZLibraryLanguageBox"
                              Grid.Column="2"
                              Width="110"
                              Height="38"
                              SelectedIndex="0">
                        <ComboBoxItem Content="全部语言" Tag="" />
                        <ComboBoxItem Content="中文" Tag="chinese" />
                        <ComboBoxItem Content="英文" Tag="english" />
                        <ComboBoxItem Content="日文" Tag="japanese" />
                        <ComboBoxItem Content="韩文" Tag="korean" />
                        <ComboBoxItem Content="俄文" Tag="russian" />
                        <ComboBoxItem Content="德文" Tag="german" />
                        <ComboBoxItem Content="法文" Tag="french" />
                        <ComboBoxItem Content="西班牙文" Tag="spanish" />
                    </ComboBox>
                    <Button x:Name="ZLibrarySearchButton"
                            Grid.Column="3"
                            Width="38"
                            Height="38"
                            Padding="0"
                            Background="{StaticResource InkBrush}"
                            Foreground="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            AutomationProperties.Name="搜索"
                            ToolTip.Tip="搜索"
                            Click="ZLibrarySearchButton_Click">
                        <Path Data="M 10,2 A 8,8 0 1 0 10,18 A 8,8 0 1 0 10,2 M 16,16 L 22,22"
                              Stroke="{StaticResource PaperBrush}"
                              StrokeThickness="1.8" />
                    </Button>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding ZLibraryBooks}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ZLibraryBookCardViewModel">
                                    <Border BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,0,8"
                                            Padding="10,10,22,10"
                                            MinHeight="112"
                                            Tapped="ZLibraryBookRow_Tapped">
                                        <Grid ColumnDefinitions="66,*,Auto" ColumnSpacing="14">
                                            <Border Width="66"
                                                    Height="92"
                                                    VerticalAlignment="Center"
                                                    Background="#D9D9D9"
                                                    BorderBrush="{StaticResource HairlineBrush}"
                                                    BorderThickness="1">
                                                <Grid Background="Transparent">
                                                    <TextBlock Text="BOOK"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="#5A5A5A"
                                                               FontSize="10" />
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2" />
                                                <TextBlock Text="{Binding Authors}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PublicationLabel}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding InfoLabel}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ExtraInfoLabel}"
                                                           Foreground="#777777"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Grid Grid.Column="2" Width="110" VerticalAlignment="Center">
                                                <Button Content="↓  下载"
                                                        Width="110"
                                                        Height="38"
                                                        Padding="0"
                                                        Classes="quiet"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding IsNotDownloading}"
                                                        AutomationProperties.Name="下载"
                                                        ToolTip.Tip="下载"
                                                        Click="ZLibraryDownloadButton_Click" />
                                                <TextBlock Text="{Binding StatusMessage}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Bottom"
                                                           MaxWidth="110"
                                                           Margin="0,0,0,-22"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Value="{Binding DownloadProgress}"
                                                             IsVisible="{Binding IsDownloading}"
                                                             Height="4"
                                                             VerticalAlignment="Bottom"
                                                             Margin="0,0,0,-8" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="ZLibraryDetailPanel"
                            x:DataType="local:ZLibraryBookCardViewModel"
                            Grid.Column="1"
                            Width="330"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            IsVisible="False">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Margin="16,12,10,10" ColumnDefinitions="*,Auto">
                                <TextBlock Text="书籍详情" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="icon" Content="×" Click="ZLibraryDetailCloseButton_Click" AutomationProperties.Name="关闭书籍详情" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,4,16,16" Spacing="10">
                                    <Border Width="112" Height="156" HorizontalAlignment="Left" Background="#D9D9D9" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="BOOK" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666" FontSize="11" />
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Authors}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailMetadataLabel}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Text="卷号" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding VolumeLabel}" FontSize="11" />
                                    </Grid>
                                    <TextBlock Text="简介" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding DetailDescription}"
                                               Foreground="#555555"
                                               FontSize="11"
                                               LineHeight="18"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Margin="16,12,16,16" Spacing="7">
                                <Button Content="官网详情" HorizontalAlignment="Stretch" IsEnabled="{Binding CanOpenOfficialDetail}" Click="ZLibraryOfficialDetailButton_Click" />
                                <Button Content="在线阅读" Classes="quiet" HorizontalAlignment="Stretch" IsEnabled="{Binding CanReadOnline}" Click="ZLibraryReadOnlineButton_Click" />
                                <Button Content="发送到 Kindle 邮箱" Classes="quiet" HorizontalAlignment="Stretch" IsEnabled="{Binding CanSendToEmail}" Click="ZLibrarySendEmailButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                    <TextBlock Grid.Column="0"
                               x:Name="ZLibraryResultText"
                               Text="输入书名或作者开始搜索。"
                               Foreground="{StaticResource MutedInkBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ZLibraryPrevPageButton"
                                Content="上一页"
                                Classes="quiet"
                                IsEnabled="False"
                                Click="ZLibraryPrevPageButton_Click" />
                        <TextBlock x:Name="ZLibraryPageText"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ZLibraryNextPageButton"
                                Content="下一页"
                                Classes="quiet"
                                IsEnabled="False"
                                Click="ZLibraryNextPageButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Stage 3: the settings surface follows the WinUI reference:
                 title/subtitle, a narrow category rail, and one focused card
                 at a time. All fields remain in this view so the Avalonia port
                 stays testable without platform-specific flyouts. -->
            <Grid x:Name="SettingsPage"
                  Grid.Column="1"
                  Margin="30,24,30,18"
                  IsVisible="False"
                  RowDefinitions="Auto,*">
                  <Grid.Transitions>
                      <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                      </Transitions>
                  </Grid.Transitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="基础设置" FontSize="28" FontWeight="Bold" />
                    <TextBlock x:Name="SettingsStatusText"
                               Text="管理本地数据、阅读偏好与设备设置。"
                               FontSize="12"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,0" RowDefinitions="*,Auto" ColumnDefinitions="168,*" ColumnSpacing="26">
                    <StackPanel Grid.RowSpan="2" Spacing="2">
                        <TextBlock Text="分类"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   Margin="2,0,0,6" />
                        <Button x:Name="SettingsGeneralButton"
                                Classes="settingsCategory active"
                                Content="常规"
                                Tag="General"
                                Click="SettingsCategoryButton_Click" />
                        <Button x:Name="SettingsLibraryButton"
                                Classes="settingsCategory"
                                Content="书库"
                                Tag="Library"
                                Click="SettingsCategoryButton_Click" />
                        <Button x:Name="SettingsKindleButton"
                                Classes="settingsCategory"
                                Content="Kindle"
                                Tag="Kindle"
                                Click="SettingsCategoryButton_Click" />
                        <Button x:Name="SettingsReadingButton"
                                Classes="settingsCategory"
                                Content="阅读"
                                Tag="Reading"
                                Click="SettingsCategoryButton_Click" />
                        <Button x:Name="SettingsBackupButton"
                                Classes="settingsCategory"
                                Content="备份"
                                Tag="Backup"
                                Click="SettingsCategoryButton_Click" />
                        <Button x:Name="SettingsAboutButton"
                                Classes="settingsCategory"
                                Content="关于"
                                Tag="About"
                                Click="SettingsCategoryButton_Click" />
                    </StackPanel>

                    <ScrollViewer x:Name="SettingsScrollViewer"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Border x:Name="SettingsGeneralSection"
                                    Padding="18,18,18,32"
                                    Background="{StaticResource PaperBrush}"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="常规" FontSize="18" FontWeight="SemiBold" />
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="默认打开格式" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                        <ComboBox x:Name="PreferredOpenFormatBox" SelectedIndex="0">
                                            <ComboBoxItem Content="EPUB" Tag="epub" />
                                            <ComboBoxItem Content="PDF" Tag="pdf" />
                                            <ComboBoxItem Content="AZW3" Tag="azw3" />
                                            <ComboBoxItem Content="MOBI（转换为 EPUB）" Tag="mobi" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="28" Margin="0,11,0,0">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="启用 AI 阅读助手" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="AiEnabledCheck" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" ToolTip.Tip="启用阅读器内的 AI 对话与解释" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="允许网络功能" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="NetworkEnabledCheck" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" ToolTip.Tip="关闭后豆瓣匹配、Z-Library 与邮件发送等联网功能不可用" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="收藏夹互斥" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="CollectionsMutuallyExclusiveCheck" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="False">
                                        <TextBlock Text="笔记批注默认收起" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="ReadingMaterialsCollapsedByDefaultCheck" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SettingsLibrarySection"
                                    IsVisible="False"
                                    Padding="18,18,18,32"
                                    Background="{StaticResource PaperBrush}"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="书库" FontSize="18" FontWeight="SemiBold" />
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Calibre ebook-convert 路径" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox x:Name="CalibrePathBox" PlaceholderText="留空时自动查找" />
                                            <Button Grid.Column="1" Content="浏览" Classes="quiet" Click="BrowseCalibreButton_Click" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="28" Margin="0,11,0,0">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="导入后补齐 EPUB 与 AZW3" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="AutoGenerateReaderFormatsCheck" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" ToolTip.Tip="导入后自动为缺失的格式生成 EPUB 与 AZW3 文件" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="比较 Kindle 与电脑书库" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="CompareKindleLibraryCheck" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" ToolTip.Tip="在书卡角标显示书籍在电脑与 Kindle 上的分布" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="网格画廊显示" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="GridGalleryDisplayCheck" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" ToolTip.Tip="网格只显示封面，隐藏标题与作者文字" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SettingsKindleSection"
                                    IsVisible="False"
                                    Padding="18"
                                    Background="{StaticResource PaperBrush}"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Kindle" FontSize="18" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,11,0,0">
                                        <TextBlock Text="发现 Kindle 后自动连接" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="AutoConnectDeviceCheck" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" ToolTip.Tip="开启后检测到 Kindle 自动连接；关闭时每次询问" />
                                    </Grid>
                                    <Rectangle Height="1" Margin="0,9,0,0" Fill="{StaticResource HairlineBrush}" />
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="邮件与账号" FontSize="13" FontWeight="SemiBold" />
                                        <Button Content="Kindle 邮箱设置"
                                                Classes="quiet"
                                                HorizontalAlignment="Left"
                                                Click="KindleEmailSettingsButton_Click" />
                                        <Button Content="Z-Library 账号设置"
                                                Classes="quiet"
                                                HorizontalAlignment="Left"
                                                Click="ZLibraryAccountButton_Click" />
                                        <Button Content="AI 助手设置"
                                                Classes="quiet"
                                                HorizontalAlignment="Left"
                                                Click="ReaderAiSettingsButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SettingsReadingSection"
                                    IsVisible="False"
                                    Padding="18"
                                    Background="{StaticResource PaperBrush}"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="28">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="默认阅读排版" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="这些设置会作为新打开书籍的默认排版，单本书仍可在阅读器中单独调整。"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="字号比例" FontSize="11" />
                                            <NumericUpDown x:Name="DefaultFontScaleBox" Minimum="0.8" Maximum="1.8" Increment="0.1" Value="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="行高" FontSize="11" />
                                            <NumericUpDown x:Name="DefaultLineHeightBox" Minimum="1.3" Maximum="2.6" Increment="0.05" Value="1.7" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="正文宽度" FontSize="11" />
                                            <NumericUpDown x:Name="DefaultMaxWidthBox" Minimum="480" Maximum="1200" Increment="20" Value="760" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="4">
                                            <TextBlock Text="页边距" FontSize="11" />
                                            <NumericUpDown x:Name="DefaultBodyPaddingBox" Minimum="24" Maximum="160" Increment="8" Value="48" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="默认正文字体" FontSize="11" />
                                        <ComboBox x:Name="DefaultFontFamilyBox" SelectedIndex="0">
                                            <ComboBoxItem Content="京华老宋体" Tag="京华老宋体" />
                                            <ComboBoxItem Content="微软雅黑 Microsoft YaHei UI" Tag="Microsoft YaHei UI" />
                                            <ComboBoxItem Content="宋体 SimSun" Tag="SimSun" />
                                            <ComboBoxItem Content="黑体 SimHei" Tag="SimHei" />
                                            <ComboBoxItem Content="楷体 KaiTi" Tag="KaiTi" />
                                            <ComboBoxItem Content="等线 DengXian" Tag="DengXian" />
                                            <ComboBoxItem Content="思源宋体 / Noto Serif CJK" Tag="Source Han Serif SC, Noto Serif CJK SC" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="新书默认使用竖排" FontSize="13" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="DefaultVerticalWritingCheck" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border x:Name="LocalResourcesSettingsSection"
                                            Margin="0,11,0,0"
                                            Padding="14"
                                            BorderBrush="{StaticResource InkBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Kreader 本地字体" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="导入 TTF、OTF、WOFF 或 WOFF2 字体，导入后可作为每本书的阅读排版设置中选择。请自行确认字体许可。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap" />
                                            <ListBox x:Name="ManagedFontList" ItemsSource="{Binding ManagedFonts}" MaxHeight="150" SelectionMode="Single">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="core:ManagedFont">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="导入字体" Click="ImportFontButton_Click" />
                                                <Button Content="移除所选" Classes="quiet" Click="RemoveFontButton_Click" />
                                                <Button Content="刷新" Classes="quiet" IsVisible="False" Click="RefreshLocalResourcesButton_Click" />
                                                <TextBlock x:Name="FontManagementStatusText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DictionaryManagementSection"
                                            Padding="14"
                                            BorderBrush="{StaticResource InkBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Kreader 本地词典" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="支持 UTF-8 文本词典，每行使用“词条 + Tab + 释义”或“词条=释义”。阅读时选中文字可直接查词。"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap" />
                                            <ListBox x:Name="ManagedDictionaryList" ItemsSource="{Binding ManagedDictionaries}" MaxHeight="150" SelectionMode="Single">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="core:DictionaryDefinition">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="导入词典" Click="ImportDictionaryButton_Click" />
                                                <Button Content="移除所选" Classes="quiet" Click="RemoveDictionaryButton_Click" />
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox x:Name="DictionaryTestBox" PlaceholderText="输入词条测试查询" KeyDown="DictionaryTestBox_KeyDown" />
                                                <Button Grid.Column="1" Content="查询" Classes="quiet" Click="DictionaryTestButton_Click" />
                                            </Grid>
                                            <TextBlock x:Name="DictionaryResultText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SettingsBackupSection"
                                    IsVisible="False"
                                    Padding="18"
                                    Background="{StaticResource PaperBrush}"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="数据备份与迁移" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="一键打包书籍文件、封面、书库信息和阅读记录，生成 .kkindle 备份文件。导入备份会覆盖当前书库；导入前会自动校验备份内容。"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="AI API Key 和 Kindle 邮箱密码不会导出；导入后保留当前设备已有的密钥，没有密钥时需要重新填写。"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="启动时自动备份（每日）" FontSize="13" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="AutoBackupCheck" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" ToolTip.Tip="启动时若距上次备份超过 20 小时则自动生成备份" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                                        <TextBlock Text="自动备份保留数量" FontSize="13" VerticalAlignment="Center" />
                                        <NumericUpDown x:Name="AutoBackupRetentionBox" Grid.Column="1" Minimum="1" Maximum="30" Increment="1" Value="5" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="导出备份" Click="ExportBackupButton_Click" />
                                        <Button Content="导入备份" Classes="quiet" Click="ImportBackupButton_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsBackupStatusText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="SettingsAboutSection"
                                        IsVisible="False"
                                        Spacing="16">
                                <Border Padding="18"
                                        Background="{StaticResource PaperBrush}"
                                        BorderBrush="{StaticResource InkBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="本地数据目录" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SettingsDataPathText"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="书籍和阅读记录保存在本机；备份包可以复制到其他 Windows 设备使用。"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="打开数据目录" Classes="quiet" Click="OpenDataDirectoryButton_Click" />
                                            <Button Content="迁移数据目录" Classes="quiet" Click="MigrateDataDirectoryButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Padding="18"
                                        Background="{StaticResource PaperBrush}"
                                        BorderBrush="{StaticResource InkBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="开发者" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                                <TextBlock Text="kingstacker" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="AboutVersionText"
                                                   Text="版本未知"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedInkBrush}" />
                                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <!-- Minimal black-and-white cat: outline, eyes and nose only. -->
                                                <Grid Width="32" Height="30">
                                                    <Polygon Points="4,11 6,2 13,8" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                                    <Polygon Points="19,8 26,2 28,11" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                                    <Ellipse Margin="3,6,3,1" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                                                    <Ellipse Width="2.5" Height="3" Margin="9,14,0,0" Fill="{StaticResource InkBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    <Ellipse Width="2.5" Height="3" Margin="0,14,9,0" Fill="{StaticResource InkBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                    <Polygon Points="14,20 18,20 16,22.5" Fill="{StaticResource InkBrush}" />
                                                </Grid>
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="请我喝杯咖啡" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="感谢你的支持" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Width="88"
                                                    Height="88"
                                                    Background="{StaticResource PaperBrush}"
                                                    BorderBrush="{StaticResource InkBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="二维码预留"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,14,0,0"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <TextBlock x:Name="ApplicationSettingsStatusText"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Content="保存应用设置"
                                ToolTip.Tip="保存所有设置页中的选项和默认阅读排版设置（修改后也会自动保存）"
                                Click="SaveApplicationSettingsButton_Click" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- The three system-setting forms are separate right-side panes in
                 the reference UI. Keeping them outside the Kindle category
                 preserves the same navigation flow on Avalonia. -->
            <Border x:Name="KindleEmailSettingsPane"
                    Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,50,10,12">
                        <TextBlock Text="Kindle 邮箱设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,0" />
                        <Button Width="32"
                                Height="32"
                                Padding="0"
                                Classes="quiet"
                                HorizontalAlignment="Right"
                                Click="KindleEmailSettingsCancelButton_Click"
                                AutomationProperties.Name="关闭 Kindle 邮箱设置">
                            <Path Data="M 4,4 L 16,16 M 16,4 L 4,16"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.5" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,14" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="通过 SMTP 将 EPUB 或 PDF 发送到你的 Kindle 个人文档邮箱。请把 Kindle 收件地址加入发件邮箱的信任列表；密码建议使用应用专用密码。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="Kindle 收件邮箱" FontSize="11" />
                                <TextBox x:Name="KindleEmailRecipientBox" PlaceholderText="例如 name@kindle.com" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="发件邮箱" FontSize="11" />
                                <TextBox x:Name="KindleEmailSenderBox" PlaceholderText="例如 you@example.com" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="SMTP 服务器" FontSize="11" />
                                    <TextBox x:Name="KindleEmailSmtpHostBox" PlaceholderText="smtp.example.com" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="端口" FontSize="11" />
                                    <TextBox x:Name="KindleEmailSmtpPortBox" Text="587" PlaceholderText="587" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="SMTP 用户名" FontSize="11" />
                                <TextBox x:Name="KindleEmailUsernameBox" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="SMTP 密码 / 应用专用密码" FontSize="11" />
                                <TextBox x:Name="KindleEmailPasswordBox" PasswordChar="●" PlaceholderText="输入密码或应用专用密码" />
                            </StackPanel>
                            <CheckBox x:Name="KindleEmailSslCheck" Content="使用 SSL/TLS" IsChecked="True" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="20,12,20,20"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock x:Name="KindleEmailSettingsStatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="取消" Classes="quiet" Click="KindleEmailSettingsCancelButton_Click" />
                        <Button Grid.Column="2" Content="保存" Click="KindleEmailSettingsSaveButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ZLibraryAccountPane"
                    Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,50,10,12">
                        <TextBlock Text="Z-Library 账号设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Width="32"
                                Height="32"
                                Padding="0"
                                Classes="quiet"
                                HorizontalAlignment="Right"
                                Click="ZLibraryAccountCancelButton_Click"
                                AutomationProperties.Name="关闭 Z-Library 账号设置">
                            <Path Data="M 4,4 L 16,16 M 16,4 L 4,16"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.5" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,14" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="使用 Z-Library 账号登录后即可搜索和下载书籍。下载受账号每日额度限制；密码仅加密保存在本机，不会写入备份包。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="Z-Library 账号邮箱" FontSize="11" />
                                <TextBox x:Name="ZLibraryEmailBox" PlaceholderText="例如 name@example.com" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="密码" FontSize="11" />
                                <TextBox x:Name="ZLibraryPasswordBox" PasswordChar="●" PlaceholderText="输入 Z-Library 账号密码" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="API 服务地址" FontSize="11" />
                                <TextBox x:Name="ZLibraryBaseUrlBox" PlaceholderText="https://api.z-lib.org" />
                                <TextBlock Text="默认使用官方 API；域名变更或访问受限时可在此修改为可用的镜像地址。"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="20,12,20,20"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock x:Name="ZLibraryAccountStatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="取消" Classes="quiet" Click="ZLibraryAccountCancelButton_Click" />
                        <Button Grid.Column="2" Content="保存并验证" Click="ZLibraryAccountSaveButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ReaderAiSettingsPane"
                    Grid.Column="2"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,50,10,12">
                        <TextBlock Text="AI 助手设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Width="32"
                                Height="32"
                                Padding="0"
                                Classes="quiet"
                                HorizontalAlignment="Right"
                                Click="MainReaderAiSettingsCancelButton_Click"
                                AutomationProperties.Name="关闭 AI 助手设置">
                            <Path Data="M 4,4 L 16,16 M 16,4 L 4,16"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.5" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,14" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="API Key 使用当前用户加密后保存在本机。DeepSeek、OpenAI 与自定义 OpenAI-compatible 服务均可在此配置。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="服务" FontSize="11" />
                                <ComboBox x:Name="MainReaderAiProviderBox"
                                          SelectedIndex="0"
                                          SelectionChanged="MainReaderAiProviderBox_SelectionChanged">
                                    <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                    <ComboBoxItem Content="OpenAI" Tag="openai" />
                                    <ComboBoxItem Content="自定义 OpenAI-compatible" Tag="custom" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Base URL" FontSize="11" />
                                <TextBox x:Name="MainReaderAiBaseUrlBox" PlaceholderText="https://api.deepseek.com" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="模型" FontSize="11" />
                                <TextBox x:Name="MainReaderAiModelBox" PlaceholderText="模型名称" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="API Key" FontSize="11" />
                                <TextBox x:Name="MainReaderAiApiKeyBox" PasswordChar="●" PlaceholderText="输入 API Key" />
                            </StackPanel>
                            <TextBlock Text="自定义服务可填写本地模型或其他兼容接口；Base URL 应填写到 /v1 或服务根地址。"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="20,12,20,20"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock x:Name="MainReaderAiSettingsStatusText"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="取消" Classes="quiet" Click="MainReaderAiSettingsCancelButton_Click" />
                        <Button Grid.Column="2" Content="保存" Click="MainReaderAiSettingsSaveButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Format conversion progress, anchored bottom-right like the
                 WinUI reference. Tapping the card badge restores this popup;
                 tapping the popup background sends it back to the card. -->
            <Border x:Name="BookConversionPopup"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="2"
                    IsVisible="False"
                    ZIndex="80"
                    Tapped="BookConversionPopup_Tapped">
                <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="BookConversionPopupTitleText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock x:Name="BookConversionPopupFormatText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <Button x:Name="BookConversionBackgroundButton"
                                    Classes="quiet"
                                    Content="后台"
                                    Padding="8,4"
                                    Click="BookConversionBackgroundButton_Click" />
                            <Button x:Name="BookConversionCancelButton"
                                    Classes="quiet"
                                    Content="取消"
                                    Padding="8,4"
                                    Click="BookConversionCancelButton_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ProgressBar x:Name="BookConversionPopupProgress"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="10"
                                     VerticalAlignment="Center" />
                        <TextBlock x:Name="BookConversionPopupPercentageText"
                                   Grid.Column="1"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   MinWidth="28"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="BookConversionPopupMessageText"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Unified task progress surface for import/backup/douban/email
                 and other long operations, matching the WinUI reference. -->
            <Border x:Name="TaskProgressPopup"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="2"
                    IsVisible="False"
                    ZIndex="75"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="9">
                    <TextBlock Text="任务进度" FontSize="15" FontWeight="SemiBold" />
                    <Border Height="10"
                            Padding="1"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1">
                        <ProgressBar x:Name="TaskProgressPopupBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Background="Transparent"
                                     IsIndeterminate="False" />
                    </Border>
                    <TextBlock x:Name="TaskProgressPopupText"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Transfer toast: the progress surface for Kindle send/export
                 operations. It replaces the generic task popup while active. -->
            <Border x:Name="TransferToast"
                    Grid.ColumnSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,30"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="2"
                    IsVisible="False"
                    ZIndex="90"
                    IsHitTestVisible="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="7">
                    <TextBlock x:Name="TransferToastTitleText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TransferToastMessageText"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="TransferToastProgress"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="5"
                                 Background="{StaticResource PaperBrush}"
                                 IsVisible="False" />
                </StackPanel>
            </Border>

            <!-- Device connection confirmation from the WinUI reference. Keep
                 this separate from destructive confirmations so the two
                 actions retain their original labels and keyboard behavior. -->
            <Grid x:Name="DevicePromptOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100"
                  Focusable="True"
                  KeyDown="DevicePromptOverlay_KeyDown">
                <Border Width="560"
                        MaxWidth="560"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10"
                                           Height="24"
                                           Margin="0,-2,0,0"
                                           Fill="{StaticResource InkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DevicePromptTitleText"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DevicePromptMessageText"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="28,18,28,22"
                              Background="{StaticResource PaperBrush}"
                              ColumnDefinitions="*,12,*">
                            <Button x:Name="DevicePromptPrimaryButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DevicePromptPrimaryButton_Click" />
                            <Button x:Name="DevicePromptCancelButton"
                                    Grid.Column="2"
                                    Content="取消"
                                    Classes="quiet"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DevicePromptCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Confirmation overlay -->
            <Grid x:Name="ConfirmationOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="430"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ConfirmationTitleText" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="ConfirmationMessageText" TextWrapping="Wrap" Foreground="#555555" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7" Margin="0,8,0,0">
                            <Button Content="取消" Padding="13,7" Click="ConfirmationCancelButton_Click" />
                            <Button x:Name="ConfirmationOkButton" Content="确认删除" Padding="13,7" Click="ConfirmationOkButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Collection-name overlay -->
            <Grid x:Name="CollectionNameOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="101">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="430"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock Text="新建收藏夹" FontSize="18" FontWeight="Bold" />
                        <TextBox x:Name="CollectionNameBox" PlaceholderText="收藏夹名称" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7" Margin="0,8,0,0">
                            <Button Content="取消" Padding="13,7" Click="CollectionNameCancelButton_Click" />
                            <Button Content="创建" Padding="13,7" Click="CollectionNameOkButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Device model editor opened from the lower-left Kindle card. -->
            <Grid x:Name="DeviceModelInputOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="100">
                <Border Width="560"
                        MaxWidth="560"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10"
                                           Height="24"
                                           Margin="0,-2,0,0"
                                           Fill="{StaticResource InkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DeviceModelInputTitleText"
                                           Text="自定义设备型号"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceModelInputMessageText"
                                       Text="输入该设备的型号名称，下次连接时会按 USB 串码自动匹配。"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                            <TextBox x:Name="DeviceModelInputBox"
                                     FontSize="15"
                                     Padding="10,7"
                                     MaxLength="80"
                                     PlaceholderText="例如 Kindle Paperwhite 11 代"
                                     BorderBrush="{StaticResource InkBrush}"
                                     BorderThickness="1"
                                     KeyDown="DeviceModelInputBox_KeyDown" />
                            <TextBlock x:Name="DeviceModelInputStatusText"
                                       IsVisible="False"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="28,18,28,22"
                              Background="{StaticResource PaperBrush}"
                              ColumnDefinitions="*,12,*">
                            <Button x:Name="DeviceModelInputOkButton"
                                    Content="确定"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DeviceModelInputOkButton_Click" />
                            <Button Grid.Column="2"
                                    Content="取消"
                                    Classes="quiet"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="DeviceModelInputCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Douban candidate picker: keep the old version's explicit
                 choice instead of silently applying the first search hit. -->
            <Grid x:Name="DoubanCandidateOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="102">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="680"
                        MaxHeight="620"
                        Padding="20"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <TextBlock Text="选择豆瓣条目" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1"
                                   Text="请选择与当前书籍匹配的结果，确认后再读取详细元数据。"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <ListBox x:Name="DoubanCandidateList"
                                 Grid.Row="2"
                                 ItemsSource="{Binding DoubanCandidates}"
                                 SelectionChanged="DoubanCandidateList_SelectionChanged"
                                 DoubleTapped="DoubanCandidateList_DoubleTapped"
                                 Background="Transparent"
                                 BorderBrush="{StaticResource HairlineBrush}"
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8"
                                            Margin="3"
                                            BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="7">
                            <Button Content="取消" Padding="13,7" Click="DoubanCandidateCancelButton_Click" />
                            <Button x:Name="DoubanCandidateSourceButton"
                                    Content="打开豆瓣来源"
                                    Classes="quiet"
                                    Padding="13,7"
                                    IsEnabled="False"
                                    Click="DoubanCandidateSourceButton_Click" />
                            <Button x:Name="DoubanCandidateApplyButton"
                                    Content="查看详情"
                                    Padding="13,7"
                                    IsEnabled="False"
                                    Click="DoubanCandidateApplyButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Douban metadata preview: shows the fetched details and lets the
                 user choose which fields are written back, with a back button
                 to return to the candidate list (WinUI reference flow). -->
            <Grid x:Name="DoubanPreviewOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="102"
                  Focusable="True"
                  KeyDown="DoubanPreviewOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="720"
                        MaxHeight="660"
                        Padding="22"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10"
                                       Height="24"
                                       Fill="{StaticResource InkBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="确认豆瓣匹配结果" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="核对书籍信息并选择需要写入本地书库的字段；未勾选的本地字段不会被修改。"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Grid.Row="2" ColumnDefinitions="104,*" ColumnSpacing="14" Margin="0,4,0,2">
                            <Border Width="96" Height="132" HorizontalAlignment="Left" Background="#E4E4E4" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="BOOK"
                                               FontSize="9"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image x:Name="DoubanPreviewCoverImage" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Column="1" MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="DoubanPreviewSummaryText"
                                           FontSize="12"
                                           LineHeight="20"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      BorderBrush="{StaticResource HairlineBrush}"
                                      BorderThickness="1"
                                      Padding="12,8">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="DoubanUpdateTitleCheck" Content="更新书名" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateAuthorsCheck" Content="更新作者" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateSeriesCheck" Content="更新系列（丛书）" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateDescriptionCheck" Content="更新简介" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdatePublicationCheck" Content="更新出版信息（出版社、出版年、ISBN、页数、装帧、评分）" FontSize="13" />
                                <CheckBox x:Name="DoubanUpdateCoverCheck" Content="下载并更新封面" FontSize="13" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                            <TextBlock x:Name="DoubanPreviewStatusText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="DoubanPreviewSourceButton"
                                    Grid.Column="1"
                                    Content="打开豆瓣来源"
                                    Classes="quiet"
                                    Padding="13,7"
                                    Click="DoubanPreviewSourceButton_Click" />
                            <Button x:Name="DoubanPreviewBackButton"
                                    Grid.Column="2"
                                    Content="返回候选列表"
                                    Classes="quiet"
                                    Padding="13,7"
                                    Click="DoubanPreviewBackButton_Click" />
                            <Button x:Name="DoubanPreviewApplyButton"
                                    Grid.Column="3"
                                    Content="应用所选字段"
                                    Padding="13,7"
                                    Click="DoubanPreviewApplyButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ImportFormatSelectionOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="105"
                  Focusable="True"
                  KeyDown="ImportFormatSelectionOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="620"
                        MaxHeight="650"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10" Height="24" Fill="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="导入书籍 · 选择格式补齐" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ImportFormatSelectionSummaryText" FontSize="14" TextWrapping="Wrap" />
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ImportFormatSelectionList" Spacing="10" />
                            </ScrollViewer>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="28,18,28,22" ColumnDefinitions="*,12,*">
                            <Button Content="导入" HorizontalAlignment="Stretch" Click="ImportFormatSelectionPrimaryButton_Click" />
                            <Button Grid.Column="2" Content="取消" Classes="quiet" HorizontalAlignment="Stretch" Click="ImportFormatSelectionCancelButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Fully custom monochrome message dialog; replaces the WinUI
                 ShowMessageAsync flow. -->
            <Grid x:Name="MessageOverlay"
                  Grid.ColumnSpan="3"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="110"
                  Focusable="True"
                  KeyDown="MessageOverlay_KeyDown">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Grid.Transitions>
                <Border Width="560"
                        MaxWidth="560"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Margin="28,24,28,22" Spacing="13">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Width="10"
                                           Height="24"
                                           Margin="0,-2,0,0"
                                           Fill="{StaticResource InkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="MessageTitleText"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="MessageBodyText"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1"
                              Margin="28,18,28,22"
                              Background="{StaticResource PaperBrush}">
                            <Button x:Name="MessageOkButton"
                                    Content="知道了"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="MessageOkButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
        <!-- Stage 4: the EPUB reader surface. Two native webview hosts
             stay attached so the next chapter can be prepared offscreen.
             Layout mirrors the WinUI reference: three fixed columns
             (TOC 286 / content * / assistant 360), a 52-DIP header bar and
             50-DIP footer bar inside the content column, and a six-row TOC
             panel ending in the full-width 返回书架 button. -->
        <Grid x:Name="ReaderRoot"
              Grid.Row="0"
              Grid.ColumnSpan="3"
              IsVisible="False"
              Margin="0"
              ZIndex="40"
              Background="{StaticResource PaperBrush}"
              PointerMoved="ReaderRoot_PointerMoved">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Opaque transition cover used when leaving zen mode: the reader
                 pane sits above the library, so fading the pane itself would
                 reveal the bookshelf behind it. This cover hides the layout
                 restore/window resize instead and is faded away afterwards. -->
            <Border x:Name="ReaderTransitionCover"
                    Grid.ColumnSpan="3"
                    Background="{StaticResource PaperBrush}"
                    Opacity="0"
                    IsHitTestVisible="False"
                    ZIndex="200" />

            <!-- Table of contents and reading progress. -->
            <Border x:Name="ReaderTocPanel"
                    Grid.Column="0"
                    Margin="0,38,0,0"
                    Background="{StaticResource PaperBrush}">
                <Grid RowDefinitions="52,Auto,Auto,*,Auto,50">
                    <!-- Start the divider below the shared header rule. Keep it
                         above search content so it remains continuous. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="5"
                               Width="1"
                               HorizontalAlignment="Right"
                               Fill="#EEEEEA"
                               IsHitTestVisible="False"
                               ZIndex="100" />

                    <Border Padding="14,8"
                            BorderBrush="#EEEEEA"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                            <TextBlock x:Name="ReaderBookInfoText"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        <Button x:Name="ReaderTocMinimalToggleButton"
                                Grid.Column="1"
                                Classes="icon"
                                Width="28"
                                MinWidth="28"
                                Height="28"
                                AutomationProperties.Name="切换极简目录"
                                ToolTip.Tip="切换极简目录"
                                Click="ReaderTocMinimalToggleButton_Click">
                            <Path Width="14"
                                  Height="14"
                                  Data="M 1,3 L 2.5,3 M 5,3 L 13,3 M 1,7 L 2.5,7 M 5,7 L 13,7 M 1,11 L 2.5,11 M 5,11 L 13,11"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.25"
                                  StrokeLineCap="Square"
                                  IsHitTestVisible="False" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="icon"
                                Width="28"
                                MinWidth="28"
                                Height="28"
                                AutomationProperties.Name="收起目录"
                                ToolTip.Tip="收起目录"
                                Click="ReaderTocButton_Click">
                            <Path Width="12"
                                  Height="12"
                                  Data="M 3,1.5 L 9,6 L 3,10.5"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.35"
                                  StrokeLineCap="Square"
                                  StrokeJoin="Miter"
                                  IsHitTestVisible="False" />
                        </Button>
                        </Grid>
                    </Border>

                    <Grid x:Name="ReaderTocTabsPanel"
                          Grid.Row="1"
                          Margin="14,4,14,4"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="6">
                        <Button x:Name="ReaderTocTabButton"
                                Classes="readerToolbar"
                                Content="目录"
                                HorizontalAlignment="Stretch"
                                BorderThickness="1"
                                Click="ReaderTocTabButton_Click" />
                        <Button x:Name="ReaderBookmarkTabButton"
                                Grid.Column="1"
                                Classes="readerToolbar"
                                Content="书签"
                                HorizontalAlignment="Stretch"
                                BorderThickness="1"
                                Click="ReaderBookmarkTabButton_Click" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid x:Name="ReaderTocView">
                            <ListBox x:Name="ReaderTocList"
                                     Classes="readerTocList"
                                     SelectionChanged="ReaderTocList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="infra:EpubReaderNavigationItem">
                                        <Grid ColumnDefinitions="3,*">
                                            <Rectangle Fill="#606060"
                                                       IsVisible="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="13,9,11,9"
                                                       Text="{Binding Title}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ReaderTocEmptyText"
                                       Margin="20"
                                       Text="此文档没有可用目录。"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="False" />
                        </Grid>

                        <Grid x:Name="ReaderBookmarkPane" IsVisible="False">
                            <ListBox x:Name="ReaderBookmarkList"
                                     ItemsSource="{Binding ReaderBookmarks}"
                                     SelectionMode="Single"
                                     SelectionChanged="ReaderBookmarkList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:ReaderBookmark">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                            <StackPanel Grid.Column="0" Margin="12,7,4,7" Spacing="3">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34" />
                                                <TextBlock Text="{Binding DisplayQuote}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34" />
                                                <TextBlock Text="{Binding DisplayTime}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="icon"
                                                    Width="28"
                                                    MinWidth="28"
                                                    Height="28"
                                                    Margin="0,0,6,0"
                                                    Content="×"
                                                    Tag="{Binding}"
                                                    Click="ReaderBookmarkDeleteButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ReaderBookmarkEmptyText"
                                       Margin="20"
                                       Text="还没有书签。阅读时按 Ctrl+B 或点击顶部“书签”按钮添加。"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Whole-book search reuses the normal TOC surface. -->
                        <Grid x:Name="ReaderSearchPanel" IsVisible="False">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <TextBox x:Name="ReaderTocSearchBox"
                                         Margin="14,4,14,10"
                                         Height="34"
                                         Padding="10,5"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="搜索整本书…"
                                         TextChanged="ReaderTocSearchBox_TextChanged" />
                                <TextBlock x:Name="ReaderWholeSearchCountText"
                                           Grid.Row="1"
                                           Margin="14,0,14,8"
                                           FontSize="10"
                                           Foreground="#5E5E5E" />
                                <Grid Grid.Row="2">
                                    <ScrollViewer Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ReaderSearchResultList"
                                                      ItemsSource="{Binding ReaderSearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ReaderSearchResultViewModel">
                                                    <Button Classes="readerToolbar"
                                                            Margin="0,0,14,6"
                                                            Padding="14,9"
                                                            BorderThickness="0.5"
                                                            BorderBrush="#BFBFBF"
                                                            Background="Transparent"
                                                            HorizontalContentAlignment="Stretch"
                                                            Tag="{Binding}"
                                                            Click="ReaderSearchResultButton_Click">
                                                        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                                            <local:ReaderSearchHighlightTextBlock Source="{Binding Title}"
                                                                                                  Query="{Binding Query}"
                                                                                                  FontSize="12"
                                                                                                  FontWeight="SemiBold"
                                                                                                  TextWrapping="Wrap" />
                                                            <local:ReaderSearchHighlightTextBlock Source="{Binding Excerpt}"
                                                                                                  Query="{Binding Query}"
                                                                                                  HighlightRanges="{Binding ExcerptHighlightRanges}"
                                                                                                  FontSize="10"
                                                                                                  Foreground="{StaticResource MutedInkBrush}"
                                                                                                  TextWrapping="Wrap"
                                                                                                  MaxHeight="52" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="ReaderSearchStatusText"
                                               Margin="20"
                                               Text="输入关键词，实时搜索整本书。"
                                               TextAlignment="Center"
                                               FontSize="11"
                                               Foreground="#5E5E5E"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="ReaderReadingInfoPanel"
                                Grid.Row="4"
                                Margin="14,4,14,8"
                                Spacing="2">
                        <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                            <TextBlock x:Name="ReaderReadingProgressText"
                                       Text="准备阅读"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="ReaderProgressPercentText"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock x:Name="ReaderStatsText"
                                   FontSize="10"
                                   Foreground="#5E5E5E"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="5"
                            BorderBrush="#E2E2DE"
                            BorderThickness="1"
                            CornerRadius="0">
                        <Button Content="返回书架"
                                Margin="0"
                                Height="48"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                Classes="readerToolbar"
                                Click="CloseReaderButton_Click" />
                    </Border>
                </Grid>
            </Border>

            <!-- Minimal TOC rail (极简目录): a 52-DIP marker rail that keeps the
                 chapter map visible without taking the reading column away. -->
            <Border x:Name="ReaderTocCompactPanel"
                    Grid.Column="0"
                    Width="52"
                    Margin="0,38,0,0"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="#D8D8D4"
                    BorderThickness="0,0,1,0"
                    Loaded="ReaderTocCompactPanel_Loaded"
                    IsVisible="False">
                <Grid RowDefinitions="52,*,50">
                    <Grid Grid.Row="0"
                          Width="28"
                          HorizontalAlignment="Center"
                          RowDefinitions="34,18">
                        <Button x:Name="ReaderTocCompactExpandButton"
                                Grid.Row="0"
                                Classes="icon"
                                Width="28"
                                MinWidth="28"
                                Height="34"
                                Padding="0"
                                AutomationProperties.Name="展开完整目录"
                                ToolTip.Tip="展开完整目录"
                                Click="ReaderTocCompactExpandButton_Click">
                            <Path Width="14"
                                  Height="14"
                                  Data="M 1,3 L 2.5,3 M 5,3 L 13,3 M 1,7 L 2.5,7 M 5,7 L 13,7 M 1,11 L 2.5,11 M 5,11 L 13,11"
                                  Stroke="{StaticResource InkBrush}"
                                  StrokeThickness="1.25"
                                  StrokeLineCap="Square"
                                  IsHitTestVisible="False" />
                        </Button>
                        <TextBlock x:Name="ReaderTocCompactUpIndicator"
                                   Grid.Row="1"
                                   Text="△"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer x:Name="ReaderTocCompactScrollViewer"
                                  Grid.Row="1"
                                  HorizontalContentAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="0,8"
                                  ScrollChanged="ReaderTocCompactScrollViewer_ScrollChanged"
                                  PointerMoved="ReaderTocCompactScrollViewer_PointerMoved"
                                  PointerExited="ReaderTocCompactScrollViewer_PointerExited"
                                  PointerWheelChanged="ReaderTocCompactScrollViewer_PointerWheelChanged">
                        <ItemsControl x:Name="ReaderTocCompactList"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ReaderTocMarker">
                                    <Button Width="50"
                                            Height="10"
                                            MinWidth="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="{Binding Title}"
                                            IsTabStop="False">
                                        <Border Width="8"
                                                Height="2"
                                                Background="{Binding Fill}"
                                                BorderThickness="0"
                                                IsHitTestVisible="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="ReaderTocCompactDownIndicator"
                               Grid.Row="2"
                               Text="▽"
                               FontFamily="Segoe UI Symbol"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Hover label for the minimal TOC rail, floating above the
                 reading surface next to the rail. -->
            <Border x:Name="ReaderTocCompactHoverLabel"
                    Grid.ColumnSpan="3"
                    MaxWidth="340"
                    Padding="10,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="#C9C9C5"
                    BorderThickness="1"
                    ZIndex="90"
                    IsHitTestVisible="False"
                    IsVisible="False">
                <TextBlock x:Name="ReaderTocCompactHoverLabelText"
                           MaxWidth="320"
                           Foreground="#555555"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Reading canvas and compact controls. -->
            <Grid x:Name="ReaderContentPanel"
                  Grid.Column="1"
                  Margin="0,38,0,0"
                  Background="{StaticResource PaperBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Border x:Name="ReaderHeaderBar"
                        BorderBrush="#E2E2DE"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="ReaderTocToggleButton"
                                    Classes="readerHeader"
                                    Content="目录"
                                    Width="64"
                                    ToolTip.Tip="显示或隐藏目录"
                                    Click="ReaderTocButton_Click" />
                            <Button x:Name="ReaderSearchToolbarButton"
                                    Classes="readerHeader"
                                    Content="搜索"
                                    AutomationProperties.Name="书内搜索"
                                    ToolTip.Tip="搜索整本书（Ctrl+F）"
                                    Click="ReaderSearchToolbarButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ReaderStatusText"
                                   Grid.Column="1"
                                   Margin="4,0"
                                   FontSize="10"
                                   Foreground="#858585"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <ScrollViewer Grid.Column="2"
                                      MaxWidth="920"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Button x:Name="ReaderZoomOutButton"
                                        Classes="readerHeaderIcon"
                                        Content="A−"
                                        ToolTip.Tip="减小字号"
                                        AutomationProperties.Name="减小字号"
                                        Click="ReaderDecreaseFontButton_Click" />
                                <TextBlock x:Name="ReaderZoomText"
                                           Width="44"
                                           Text="100%"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ReaderZoomInButton"
                                        Classes="readerHeaderIcon"
                                        Content="A+"
                                        ToolTip.Tip="增大字号"
                                        AutomationProperties.Name="增大字号"
                                        Click="ReaderIncreaseFontButton_Click" />
                                <Rectangle Width="1" Height="20" Margin="12,0" Fill="#E2E2DE" VerticalAlignment="Center" />
                                <Button x:Name="ReaderFlowButton"
                                        Classes="readerHeader"
                                        Content="分页"
                                        ToolTip.Tip="选择滚动、单页或双栏阅读模式"
                                        AutomationProperties.Name="选择阅读分页模式">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem x:Name="ReaderScrollModeItem"
                                                      Header="滚动"
                                                      ToggleType="Radio"
                                                      IsChecked="True"
                                                      Tag="scroll"
                                                      Click="ReaderFlowModeItem_Click" />
                                            <MenuItem x:Name="ReaderSinglePageModeItem"
                                                      Header="单页"
                                                      ToggleType="Radio"
                                                      Tag="single"
                                                      Click="ReaderFlowModeItem_Click" />
                                            <MenuItem x:Name="ReaderTwoPageModeItem"
                                                      Header="双栏"
                                                      ToggleType="Radio"
                                                      Tag="double"
                                                      Click="ReaderFlowModeItem_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="ReaderMoreButton"
                                        Classes="readerHeader"
                                        Content="更多"
                                        ToolTip.Tip="阅读设置"
                                        AutomationProperties.Name="阅读设置">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem x:Name="ReaderZenMenuItem"
                                                      Header="禅模式"
                                                      ToggleType="CheckBox"
                                                      ToolTip.Tip="隐藏目录与阅读助手，最大化正文区域"
                                                      Click="ReaderZenMenuItem_Click" />
                                            <MenuItem Header="阅读排版设置"
                                                      ToolTip.Tip="字号、行距、正文宽度、字体与竖排"
                                                      Click="ReaderLayoutSettingsMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="翻页动画">
                                                <MenuItem x:Name="ReaderAnimationNoneItem"
                                                          Header="无动画"
                                                          ToggleType="Radio"
                                                          Tag="none"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationFadeItem"
                                                          Header="淡入淡出"
                                                          ToggleType="Radio"
                                                          IsChecked="True"
                                                          Tag="fade"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationSlideItem"
                                                          Header="左右滑动"
                                                          ToggleType="Radio"
                                                          Tag="slide"
                                                          Click="ReaderAnimationItem_Click" />
                                                <MenuItem x:Name="ReaderAnimationWaveItem"
                                                          Header="水波流动"
                                                          ToggleType="Radio"
                                                          Tag="wave"
                                                          Click="ReaderAnimationItem_Click" />
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Rectangle Width="1" Height="20" Margin="12,0" Fill="#E2E2DE" VerticalAlignment="Center" />
                                <Button x:Name="ReaderHighlightButton"
                                        Classes="readerHeader"
                                        Content="划线"
                                        IsVisible="False"
                                        ToolTip.Tip="为正文中选中的文字添加划线"
                                        Click="ReaderHighlightButton_Click" />
                                <Button x:Name="ReaderAnnotateButton"
                                        Classes="readerHeader"
                                        Content="批注"
                                        IsVisible="False"
                                        ToolTip.Tip="为正文中选中的文字添加笔记"
                                        Click="ReaderAnnotateButton_Click" />
                                <Button x:Name="ReaderBookmarkButton"
                                        Classes="readerHeader"
                                        Content="书签"
                                        AutomationProperties.Name="添加书签"
                                        ToolTip.Tip="添加或取消当前阅读位置的书签（Ctrl+B）"
                                        Click="ReaderBookmarkButton_Click" />
                                <Rectangle Width="1" Height="20" Margin="12,0" Fill="#E2E2DE" VerticalAlignment="Center" />
                                <Button x:Name="ReaderAssistantToggleButton"
                                        Classes="readerHeader"
                                        Content="助手"
                                        ToolTip.Tip="显示或隐藏阅读助手"
                                        Click="ReaderAssistantToggleButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="{StaticResource PaperBrush}">
                    <Grid x:Name="ReaderWebViewHost"
                          Margin="0,12,0,10"
                          Background="{StaticResource PaperBrush}">
                        <ContentControl x:Name="ReaderActiveHostSlot"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                        <ContentControl x:Name="ReaderPreloadHostSlot"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                        <!-- Keep the native webview's fractional-DPI bottom edge
                             hidden, matching the WinUI reader surface. -->
                        <Border x:Name="ReaderWebViewBottomCover"
                                Height="2"
                                Margin="0,0,0,10"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource PaperBrush}"
                                IsHitTestVisible="False"
                                ZIndex="30" />
                        <!-- Current-page bookmark marker. -->
                        <Path x:Name="ReaderBookmarkCornerMarker"
                              Width="26"
                              Height="26"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              ZIndex="25"
                              Data="M 0,0 L 26,0 L 26,26 Z"
                              Fill="#777774"
                              IsHitTestVisible="False"
                              IsVisible="False" />
                        <Border x:Name="ReaderInPageSearchBar"
                                Width="430"
                                Padding="10,8"
                                Margin="0,16,24,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource PaperBrush}"
                                BorderBrush="{StaticResource InkBrush}"
                                BorderThickness="1"
                                IsVisible="False"
                                ZIndex="45">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBox x:Name="ReaderInPageSearchBox"
                                         Height="32"
                                         Padding="8,4"
                                         PlaceholderText="查找当前正文…"
                                         TextChanged="ReaderInPageSearchBox_TextChanged"
                                         KeyDown="ReaderInPageSearchBox_KeyDown" />
                                <TextBlock x:Name="ReaderInPageSearchCountText"
                                           Grid.Column="1"
                                           MinWidth="48"
                                           Text="0/0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="icon" Width="32" MinWidth="32" Height="32" Content="↑" Click="ReaderInPageSearchPreviousButton_Click" />
                                <Button Grid.Column="3" Classes="icon" Width="32" MinWidth="32" Height="32" Content="↓" Click="ReaderInPageSearchNextButton_Click" />
                                <Button Grid.Column="4" Classes="icon" Width="32" MinWidth="32" Height="32" Content="×" Click="ReaderInPageSearchCloseButton_Click" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Slim floating bar shown only in zen mode. -->
                    <Border x:Name="ReaderZenBar"
                            Padding="2,2,2,2"
                            Margin="0,16,24,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="1"
                            IsVisible="False"
                            ZIndex="70">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="禅模式"
                                       Margin="10,0,2,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ReaderZenTocButton"
                                    Classes="readerToolbar"
                                    Content="极简目录"
                                    ToolTip.Tip="显示或隐藏极简目录"
                                    Click="ReaderZenMinimalTocButton_Click" />
                            <Button x:Name="ReaderExitZenButton"
                                    Classes="readerToolbar"
                                    Content="退出禅模式"
                                    ToolTip.Tip="退出禅模式，恢复目录与阅读助手"
                                    Click="ReaderExitZenButton_Click" />
                            <Button x:Name="ReaderZenCloseButton"
                                    Classes="icon"
                                    Content="×"
                                    FontSize="15"
                                    AutomationProperties.Name="关闭阅读器"
                                    ToolTip.Tip="返回书架"
                                    Click="CloseReaderButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="ReaderFooterBar"
                        Grid.Row="2"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="#E2E2DE"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="14,4" ColumnDefinitions="34,34,*,Auto,Auto" ColumnSpacing="10">
                        <Button x:Name="ReaderPreviousButton"
                                Classes="readerToolbar"
                                Content="‹"
                                FontSize="16"
                                Width="34"
                                Height="30"
                                AutomationProperties.Name="上一章"
                                ToolTip.Tip="上一章"
                                Click="ReaderPreviousButton_Click" />
                        <Button x:Name="ReaderNextButton"
                                Grid.Column="1"
                                Classes="readerToolbar"
                                Content="›"
                                FontSize="16"
                                Width="34"
                                Height="30"
                                AutomationProperties.Name="下一章"
                                ToolTip.Tip="下一章"
                                Click="ReaderNextButton_Click" />
                        <Slider x:Name="ReaderProgressSlider"
                                Grid.Column="2"
                                Margin="6,0,14,0"
                                MinWidth="120"
                                Minimum="1"
                                Maximum="1"
                                Value="1"
                                VerticalAlignment="Center"
                                ValueChanged="ReaderProgressSlider_ValueChanged"
                                PointerPressed="ReaderProgressSlider_PointerPressed"
                                PointerMoved="ReaderProgressSlider_PointerMoved"
                                PointerReleased="ReaderProgressSlider_PointerReleased" />
                        <TextBlock x:Name="ReaderChapterText"
                                   Grid.Column="3"
                                   Margin="0,0,10,0"
                                   MaxWidth="320"
                                   FontSize="11"
                                   Foreground="#5E5E5E"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border x:Name="ReaderPdfBadge"
                                Grid.Column="4"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="#F2F2F0"
                                BorderBrush="#D5D5D1"
                                BorderThickness="1">
                            <TextBlock x:Name="ReaderPdfBottomText"
                                       Text="PDF"
                                       FontSize="9"
                                       Foreground="#5E5E5E" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- AI conversation and persistent annotations. -->
            <Border x:Name="ReaderAssistantPanel"
                    Grid.Column="2"
                    Margin="0,38,0,0"
                    Background="{StaticResource PaperBrush}">
                <Grid RowDefinitions="52,42,*,Auto">
                    <!-- Long separator below the assistant header. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="3"
                               Width="1"
                               HorizontalAlignment="Left"
                               Fill="#EEEEEA"
                               IsHitTestVisible="False" />

                    <Border Background="{StaticResource PaperBrush}"
                            BorderBrush="#EEEEEA"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="14,8" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="AI 助手" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ReaderAiProviderText"
                                           Text="DeepSeek · 未配置"
                                           FontSize="9"
                                           MaxWidth="150"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon"
                                    Width="28"
                                    MinWidth="28"
                                    Height="28"
                                    AutomationProperties.Name="收起阅读助手"
                                    ToolTip.Tip="收起阅读助手"
                                    Click="ReaderAssistantToggleButton_Click">
                                <Path Width="12"
                                      Height="12"
                                      Data="M 9,1.5 L 3,6 L 9,10.5"
                                      Stroke="{StaticResource InkBrush}"
                                      StrokeThickness="1.35"
                                      StrokeLineCap="Square"
                                      StrokeJoin="Miter"
                                      IsHitTestVisible="False" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="12,4" ColumnSpacing="6">
                        <Button x:Name="ReaderAiTabButton"
                                Classes="readerToolbar"
                                Content="AI 对话"
                                HorizontalAlignment="Stretch"
                                BorderThickness="1"
                                Click="ReaderAiTabButton_Click" />
                        <Button x:Name="ReaderNotesTabButton"
                                Grid.Column="1"
                                Classes="readerToolbar"
                                Content="划线与笔记"
                                HorizontalAlignment="Stretch"
                                BorderThickness="1"
                                Click="ReaderNotesTabButton_Click" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid x:Name="ReaderAiView">
                            <ScrollViewer x:Name="ReaderAiScrollViewer" Padding="14,14,14,18" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="13">
                                    <StackPanel x:Name="ReaderAiEmptyState" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="Kreader AI" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="基于当前选文和本地书籍索引对话"
                                                   MaxWidth="250"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                                        <Button Classes="readerToolbar" Content="总结本章" HorizontalAlignment="Stretch" BorderThickness="1" Click="ReaderAiSummarizeChapterButton_Click" />
                                        <Button Grid.Column="1" Classes="readerToolbar" Content="解释选中" HorizontalAlignment="Stretch" BorderThickness="1" Click="ReaderAiExplainSelectionButton_Click" />
                                        <Button Grid.Row="1" Classes="readerToolbar" Content="全书概览" HorizontalAlignment="Stretch" BorderThickness="1" Click="ReaderAiSummarizeBookButton_Click" />
                                        <Button Grid.Row="1" Grid.Column="1" Classes="readerToolbar" Content="清空对话" HorizontalAlignment="Stretch" BorderThickness="1" Click="ReaderAiClearButton_Click" />
                                    </Grid>
                                    <ItemsControl x:Name="ReaderChatMessagesPanel" ItemsSource="{Binding ReaderAiMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:ReaderAiMessageViewModel">
                                                <Border Padding="10"
                                                        Background="{Binding BubbleBackground}"
                                                        BorderBrush="{Binding BorderBrush}"
                                                        BorderThickness="1"
                                                        Margin="0,2">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="{Binding RoleLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding RoleBrush}" />
                                                        <TextBlock Text="{Binding Reasoning}" IsVisible="{Binding IsReasoningVisible}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                                        <local:KreaderMarkdownTextBlock Text="{Binding Content}" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ReaderAiStatusText"
                                               Text="本地索引将在打开 EPUB 后自动准备"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <StackPanel x:Name="ReaderAiSourcesPanel" Spacing="5" IsVisible="False">
                                        <TextBlock Text="本次参考" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                        <ItemsControl ItemsSource="{Binding ReaderAiSources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ReaderAiSourceViewModel">
                                                    <Button Classes="readerToolbar" Tag="{Binding}" HorizontalContentAlignment="Left" Click="ReaderAiSourceButton_Click">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="10" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="ReaderNotesView" IsVisible="False">
                            <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="为正文中选中的文字添加划线和笔记。批注仅保存在本机。"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap" />
                                    <Border Padding="10"
                                            Background="{StaticResource PaperBrush}"
                                            BorderBrush="{StaticResource InkBrush}"
                                            BorderThickness="1">
                                        <TextBlock x:Name="ReaderAnnotationSelectionText"
                                                   Text="请先在正文中选择一段文字，再点击顶部“批注”。"
                                                   FontSize="12"
                                                   MaxHeight="80"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <TextBox x:Name="ReaderAnnotationNoteBox"
                                             MinHeight="76"
                                             Padding="10,8"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             PlaceholderText="写下对这段文字的想法（可留空）" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="划线颜色（淡色覆盖正文）" FontSize="9" Foreground="{StaticResource MutedInkBrush}" />
                                            <ComboBox x:Name="ReaderAnnotationColorBox" SelectedIndex="0" MinHeight="32" FontSize="10">
                                                <ComboBoxItem Content="黑色" Tag="#000000" />
                                                <ComboBoxItem Content="深灰" Tag="#555555" />
                                                <ComboBoxItem Content="中灰" Tag="#999999" />
                                                <ComboBoxItem Content="浅灰" Tag="#CCCCCC" />
                                                <ComboBoxItem Content="淡灰" Tag="#E6E6E6" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="线条样式" FontSize="9" Foreground="{StaticResource MutedInkBrush}" />
                                            <ComboBox x:Name="ReaderAnnotationStyleBox" SelectedIndex="0" MinHeight="32" FontSize="10">
                                                <ComboBoxItem Content="直线" Tag="solid" />
                                                <ComboBoxItem Content="双线" Tag="double" />
                                                <ComboBoxItem Content="虚线" Tag="dashed" />
                                                <ComboBoxItem Content="点线" Tag="dotted" />
                                                <ComboBoxItem Content="波浪线" Tag="wavy" />
                                                <ComboBoxItem Content="荧光标记" Tag="marker" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Button Classes="readerToolbar" Content="保存划线与笔记" HorizontalAlignment="Stretch" BorderThickness="1" Click="ReaderAnnotationSaveButton_Click" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="本书批注" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="点击条目回到正文" FontSize="9" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button x:Name="ReaderDeleteAnnotationButton"
                                                Grid.Column="1"
                                                Classes="readerToolbar"
                                                Content="删除选中"
                                                IsEnabled="False"
                                                Click="ReaderDeleteAnnotationButton_Click" />
                                    </Grid>
                                    <ItemsControl x:Name="ReaderAnnotationList" ItemsSource="{Binding ReaderAnnotations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:ReaderAnnotation">
                                                <Button Classes="readerToolbar"
                                                        Margin="0,0,0,7"
                                                        Padding="10"
                                                        BorderThickness="1"
                                                        BorderBrush="{StaticResource InkBrush}"
                                                        Background="{StaticResource PaperBrush}"
                                                        Tag="{Binding}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="ReaderAnnotationItemButton_Click">
                                                    <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                                                        <TextBlock Text="{Binding DisplayQuote}" FontSize="11" FontWeight="SemiBold" MaxHeight="54" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding DisplayNote}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" MaxHeight="54" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <Button Classes="readerToolbar" Content="导出 Markdown" HorizontalAlignment="Stretch" BorderThickness="1" Click="ReaderExportMarkdownButton_Click" />
                                        <Button Grid.Column="1" Classes="readerToolbar" Content="导出文本" HorizontalAlignment="Stretch" BorderThickness="1" Click="ReaderExportTextButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="ReaderExportStatusText" FontSize="10" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer x:Name="ReaderAiSettingsView" IsVisible="False" Padding="14" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="9">
                                <TextBlock Text="AI 助手设置" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="API Key 只保存在本机加密存储中。"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                                <ComboBox x:Name="ReaderAiProviderBox" SelectedIndex="0" SelectionChanged="ReaderAiProviderBox_SelectionChanged">
                                    <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                    <ComboBoxItem Content="OpenAI" Tag="openai" />
                                    <ComboBoxItem Content="自定义 API" Tag="custom" />
                                </ComboBox>
                                <TextBox x:Name="ReaderAiBaseUrlBox" PlaceholderText="Base URL" />
                                <TextBox x:Name="ReaderAiModelBox" PlaceholderText="模型名称" />
                                <TextBox x:Name="ReaderAiApiKeyBox" PlaceholderText="API Key" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="quiet" Content="保存" Click="ReaderAiSettingsSaveButton_Click" />
                                    <Button Classes="quiet" Content="取消" Click="ReaderAiSettingsCancelButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="ReaderAiSettingsStatusText" FontSize="10" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="3"
                            Padding="12"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid x:Name="ReaderAiComposer" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="思考深度" FontSize="9" Foreground="{StaticResource MutedInkBrush}" />
                                    <ComboBox x:Name="ReaderAiReasoningDepthBox" MinHeight="32" FontSize="10" SelectionChanged="ReaderAiReasoningDepthBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="模型" FontSize="9" Foreground="{StaticResource MutedInkBrush}" />
                                    <ComboBox x:Name="ReaderAiModelSelectorBox" MinHeight="32" FontSize="10" PlaceholderText="选择模型" SelectionChanged="ReaderAiModelSelectorBox_SelectionChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="ReaderAiQuestionBox"
                                     Grid.Row="1"
                                     MinHeight="74"
                                     Padding="10,8"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     PlaceholderText="询问这本书…（Ctrl+Enter 发送）"
                                     KeyDown="ReaderAiQuestionBox_KeyDown" />
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Text="仅发送相关片段，不上传整本书" FontSize="9" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                                <Button x:Name="ReaderAiSendButton"
                                        Grid.Column="1"
                                        Classes="quiet"
                                        Content="发送"
                                        MinWidth="66"
                                        BorderThickness="1"
                                        Click="ReaderAiSendButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Reading layout settings (per book). -->
            <Grid x:Name="ReaderLayoutSettingsOverlay"
                  Grid.ColumnSpan="3"
                  Margin="0,38,0,0"
                  Background="#66000000"
                  IsVisible="False"
                  ZIndex="85">
                <Border Width="580"
                        MaxHeight="760"
                        Background="{StaticResource PaperBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Margin="22,20" Spacing="12">
                                <TextBlock Text="阅读排版设置" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="这些设置只对当前这本书生效，并在下次打开时自动恢复。"
                                           FontSize="11"
                                           Foreground="#666666"
                                           TextWrapping="Wrap" />
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="字号" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderFontScaleValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderFontScaleSlider" Minimum="0.8" Maximum="1.8" Value="1" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="行高" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderLineHeightValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderLineHeightSlider" Minimum="1.3" Maximum="2.6" Value="1.88" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="正文最大宽度" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderMaxWidthValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderMaxWidthSlider" Minimum="480" Maximum="1200" Value="800" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="左右边距" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderBodyPaddingValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderBodyPaddingSlider" Minimum="24" Maximum="160" Value="68" ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="正文字体（CJK 覆盖）" FontSize="11" />
                                    <ComboBox x:Name="ReaderFontFamilyBox"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="ReaderFontFamilyBox_SelectionChanged">
                                        <ComboBoxItem Content="京华老宋体" Tag="京华老宋体" />
                                        <ComboBoxItem Content="微软雅黑 Microsoft YaHei UI" Tag="Microsoft YaHei UI" />
                                        <ComboBoxItem Content="宋体 SimSun" Tag="SimSun" />
                                        <ComboBoxItem Content="黑体 SimHei" Tag="SimHei" />
                                        <ComboBoxItem Content="楷体 KaiTi" Tag="KaiTi" />
                                        <ComboBoxItem Content="等线 DengXian" Tag="DengXian" />
                                        <ComboBoxItem Content="思源宋体 / Noto Serif CJK" Tag="Source Han Serif SC, Noto Serif CJK SC" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="ReaderVerticalWritingCheck"
                                          Content="竖排排版（滚动与分页模式）"
                                          FontSize="12"
                                          IsCheckedChanged="ReaderVerticalWritingCheck_IsCheckedChanged" />
                                <TextBlock x:Name="ReaderLayoutSettingsStatusText"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                                <Button Classes="quiet"
                                        Content="恢复默认值"
                                        HorizontalAlignment="Left"
                                        Click="ReaderLayoutResetButton_Click" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="22,14,22,20">
                                <Button Classes="quiet"
                                        Content="关闭"
                                        HorizontalAlignment="Right"
                                        Click="ReaderLayoutSettingsCloseButton_Click" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Footnote preview. -->
            <Border x:Name="ReaderFootnotePopup"
                    Width="360"
                    MaxHeight="260"
                    Padding="12,10"
                    Margin="0,20,20,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="2"
                    IsVisible="False"
                    ZIndex="95">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="脚注预览" FontSize="13" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Classes="icon" Width="26" MinWidth="26" Height="26" Content="×" Click="ReaderFootnoteCloseButton_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="205">
                        <TextBlock x:Name="ReaderFootnoteText"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="12"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Border>

        <!-- Device connection/eject floating bubble, mirroring the WinUI
             DeviceStatusPopup: a black toast with a 1-DIP black outline and a
             pointer aligned to the sidebar eject button's triangle apex. The
             host positions it in window coordinates (PositionDeviceStatusToast)
             and it floats above the whole UI, never clipped by the sidebar. -->
        <StackPanel x:Name="DeviceStatusToast"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    MaxWidth="360"
                    IsVisible="False"
                    IsHitTestVisible="False">
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                </Transitions>
            </StackPanel.Transitions>
            <Border Padding="8,7"
                    Background="{StaticResource InkBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="DeviceStatusToastText"
                           MaxWidth="342"
                           Text="设备已连接"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Foreground="{StaticResource PaperBrush}"
                           FontSize="11" />
            </Border>
            <Polygon x:Name="DeviceStatusToastPointer"
                     Points="0,0 10,0 5,6"
                     Width="10"
                     Height="6"
                     Fill="{StaticResource InkBrush}"
                     HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Invisible resize handles around the window edge. A transparent
             (layered) window loses the system resize border, so the edges are
             re-implemented manually: 8-DIP strips on the four sides plus
             14-DIP corners, each dragging the window size by pointer. -->
        <Grid x:Name="WindowResizeLayer">
            <Rectangle Fill="Transparent"
                       Width="8"
                       HorizontalAlignment="Left"
                       Cursor="SizeWestEast"
                       Tag="Left"
                       PointerPressed="WindowResize_PointerPressed"
                       PointerMoved="WindowResize_PointerMoved"
                       PointerReleased="WindowResize_PointerReleased" />
            <Rectangle Fill="Transparent"
                       Width="8"
                       HorizontalAlignment="Right"
                       Cursor="SizeWestEast"
                       Tag="Right"
                       PointerPressed="WindowResize_PointerPressed"
                       PointerMoved="WindowResize_PointerMoved"
                       PointerReleased="WindowResize_PointerReleased" />
            <Rectangle Fill="Transparent"
                       Height="8"
                       VerticalAlignment="Top"
                       Cursor="SizeNorthSouth"
                       Tag="Top"
                       PointerPressed="WindowResize_PointerPressed"
                       PointerMoved="WindowResize_PointerMoved"
                       PointerReleased="WindowResize_PointerReleased" />
            <Rectangle Fill="Transparent"
                       Height="8"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNorthSouth"
                       Tag="Bottom"
                       PointerPressed="WindowResize_PointerPressed"
                       PointerMoved="WindowResize_PointerMoved"
                       PointerReleased="WindowResize_PointerReleased" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Cursor="TopLeftCorner"
                       Tag="TopLeft"
                       PointerPressed="WindowResize_PointerPressed"
                       PointerMoved="WindowResize_PointerMoved"
                       PointerReleased="WindowResize_PointerReleased" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Cursor="TopRightCorner"
                       Tag="TopRight"
                       PointerPressed="WindowResize_PointerPressed"
                       PointerMoved="WindowResize_PointerMoved"
                       PointerReleased="WindowResize_PointerReleased" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Cursor="BottomLeftCorner"
                       Tag="BottomLeft"
                       PointerPressed="WindowResize_PointerPressed"
                       PointerMoved="WindowResize_PointerMoved"
                       PointerReleased="WindowResize_PointerReleased" />
            <Rectangle Fill="Transparent"
                       Width="14"
                       Height="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="BottomRightCorner"
                       Tag="BottomRight"
                       PointerPressed="WindowResize_PointerPressed"
                       PointerMoved="WindowResize_PointerMoved"
                       PointerReleased="WindowResize_PointerReleased" />
        </Grid>
    </Grid>
</Window>
