<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kkindle.App"
             RequestedThemeVariant="Light">
    <!-- Kkindle is a paper-white reading tool: the palette is fixed light, not
         system-following. Dark mode is not a supported variant (AI_HANDOFF #13). -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kkindle.App/ScrollBarTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- The whole product is black, white and grey with square corners.
             Every value here is quoted from the WinUI App.xaml so the port can
             be compared against docs/images/ pixel by pixel. -->
        <Color x:Key="PaperColor">#FFFFFF</Color>
        <Color x:Key="InkColor">#000000</Color>
        <Color x:Key="PressedColor">#D9D9D9</Color>
        <Color x:Key="HairlineColor">#E2E2E2</Color>
        <Color x:Key="MutedInkColor">#5A5A5A</Color>
        <Color x:Key="SidebarIndicatorColor">#BFBFBF</Color>
        <Color x:Key="SoftHoverColor">#F2F2F2</Color>

        <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
        <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="{StaticResource MutedInkColor}" />
        <SolidColorBrush x:Key="SidebarIndicatorBrush" Color="{StaticResource SidebarIndicatorColor}" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource SidebarIndicatorColor}" />
        <SolidColorBrush x:Key="SoftHoverBrush" Color="{StaticResource SoftHoverColor}" />

        <!-- The font is bundled with the portable app. The suffix is the
             internal family name, not the filename. -->
        <FontFamily x:Key="DefaultAppFontFamily">avares://Kkindle.App/Assets/Fonts/KingHwaOldSong-v3.0.ttf#KingHwaOldSong</FontFamily>

        <!-- ScrollBarTheme.axaml intentionally uses private resource names so
             it does not depend on FluentTheme's internal palette. -->
        <x:Double x:Key="KkindleScrollBarSize">10</x:Double>
        <SolidColorBrush x:Key="KkindleScrollBarBackgroundBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarExpandedBackgroundBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarThumbBrush" Color="#C9C9C9" />
        <SolidColorBrush x:Key="KkindleScrollBarThumbPointerOverBrush" Color="#B4B4B4" />
        <SolidColorBrush x:Key="KkindleScrollBarThumbPressedBrush" Color="#A4A4A4" />
        <SolidColorBrush x:Key="KkindleScrollBarThumbDisabledBrush" Color="#777777" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonPointerOverBrush" Color="#000000" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonPressedBrush" Color="#000000" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonDisabledBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonPointerOverBorderBrush" Color="#000000" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonPressedBorderBrush" Color="#000000" />
        <SolidColorBrush x:Key="KkindleScrollBarButtonDisabledBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="KkindleScrollBarArrowBrush" Color="#000000" />
        <SolidColorBrush x:Key="KkindleScrollBarArrowPointerOverBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="KkindleScrollBarArrowPressedBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="KkindleScrollBarArrowDisabledBrush" Color="#8A8A8A" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Avalonia's ScrollBar already owns the interaction state needed for
             automatic hiding. This keeps the behavior in the control theme,
             rather than duplicating WinUI's visual-tree registration logic. -->
        <Style Selector="ScrollBar">
            <Setter Property="Theme" Value="{StaticResource {x:Type ScrollBar}}" />
            <Setter Property="AllowAutoHide" Value="True" />
            <Setter Property="HideDelay" Value="0:0:0.9" />
            <Setter Property="ShowDelay" Value="0:0:0" />
        </Style>

        <!-- Base typography and the monochrome interaction language used by
             the future library/reader views. More specific view styles can
             override sizes and spacing without changing the palette. -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- Caption buttons invert to black-on-white on hover, which is the
             product's hover language everywhere. Note there is no red close
             button: the three-colour rule has no exception for it. -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.caption:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Button.caption:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- The WinUI reference uses a small set of named visual languages:
             quiet outlined actions, narrow sidebar navigation, and square
             icon buttons. Keeping these as classes makes the Avalonia XAML
             read like the reference instead of relying on Fluent defaults. -->
        <Style Selector="Button.quiet">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="Button.quiet:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Button.quiet:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Button.icon:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.icon.active">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="Button.sidebarSection">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SidebarIndicatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.sidebarSection:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarSection:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarSection.active">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarItem">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="12,2,0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SidebarIndicatorBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Grid ColumnDefinitions="3,10,*">
                            <Rectangle Width="3"
                                       Height="16"
                                       Fill="{TemplateBinding BorderBrush}"
                                       VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="2"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.sidebarItem:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarItem:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.sidebarItem.active">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- Settings uses the WinUI reference's two-column navigation: the
             category rail is quiet, square and marked by a three-pixel bar. -->
        <Style Selector="Button.settingsCategory">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SidebarIndicatorBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Grid ColumnDefinitions="3,*,Auto">
                            <Rectangle Width="3"
                                       Height="18"
                                       Fill="{TemplateBinding BorderBrush}"
                                       VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="14,0,8,0"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.settingsCategory:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.settingsCategory.active">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Native form controls are explicitly kept in the product's
             monochrome language; Fluent's accent colour must not leak into
             settings or feature pages. -->
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="CheckBox:pointerover">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- WinUI's ToggleSwitch is the settings control, not a text
             checkbox. The track and thumb are deliberately drawn here so
             Fluent's accent colour can never enter the monochrome UI. -->
        <Style Selector="ToggleSwitch">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="IsThreeState" Value="False" />
            <Setter Property="OnContent" Value="开" />
            <Setter Property="OffContent" Value="关" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="48,Auto" ColumnSpacing="8" MinHeight="24">
                        <Border x:Name="SwitchTrack"
                                Width="48"
                                Height="24"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid x:Name="PART_MovingKnobs">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="18"
                                         Height="18"
                                         Margin="2"
                                         Fill="{StaticResource InkBrush}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="OnContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding OnContent}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          IsVisible="False" />
                        <ContentPresenter x:Name="OffContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding OffContent}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleSwitch:checked">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchThumb">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Fill" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ ContentPresenter#OnContentPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ ContentPresenter#OffContentPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ToggleSwitch:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- The old device card uses a small solid eject triangle. A unicode
             glyph is font-dependent and was the source of the wrong colour /
             shape on the Avalonia port, so keep it as a vector. The triangle
             lives in the button content; the code-behind switches it between
             solid (connected) and hollow (disconnected) exactly like the WinUI
             EjectButtonStyle disabled state. -->
        <Style Selector="Button.eject">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Width" Value="25" />
            <Setter Property="MinWidth" Value="25" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.eject:pointerover">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Button.eject:pressed">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
        </Style>

        <Style Selector="ListBoxItem.bookCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="ListBoxItem.bookCard:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ListBoxItem.bookCard:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.readerToolbar">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="BorderBrush" Value="#D5D5D5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.readerToolbar:pointerover">
            <Setter Property="Background" Value="#ECECEC" />
        </Style>
        <Style Selector="Button.readerToolbar:pressed">
            <Setter Property="Background" Value="#D9D9D9" />
        </Style>

        <!-- Glyphs are drawn as vectors rather than Segoe MDL2 Assets glyphs:
             that font ships only with Windows, so a font-based title bar would
             compile here and render as tofu on Linux. Stroke follows the
             button's Foreground so the hover inversion carries through. -->
        <Style Selector="Button.caption Path">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <Style Selector="Button.icon Path">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource SoftHoverBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>

        <!-- The WinUI shelf selects the 154-DIP card content, never the
             172-DIP wrap slot around it. Keep the ListBox container visually
             transparent so the outline inside the card stays flush with the
             cover's left and right edges. -->
        <Style Selector="ListBox.bookGrid ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.bookGrid ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ListBox.bookGrid ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.bookGrid ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ListBox.bookList ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.bookList ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="ListBox.bookList ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.bookList ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
    </Application.Styles>
</Application>
