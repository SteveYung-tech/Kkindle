<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Deliberately plain net8.0, never net8.0-windows: this project holds all
         UI code, and keeping it platform-neutral makes the compiler reject any
         Windows-only API that creeps in. Platform services arrive through the
         Kkindle.Core interfaces, wired by a per-platform head project
         (Kkindle.Desktop.Windows today). -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Kkindle</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kkindle.Core\Kkindle.Core.csproj" />
    <ProjectReference Include="..\Kkindle.Infrastructure\Kkindle.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the reader's CSS/JS math byte-for-byte aligned with the WinUI
         reference during the migration. These files contain no WinUI types. -->
    <Compile Include="..\Kkindle.App.WinUI\ReaderNavigationScripts.cs" Link="ReaderNavigationScripts.cs" />
    <Compile Include="..\Kkindle.App.WinUI\ReaderPaginationScripts.cs" Link="ReaderPaginationScripts.cs" />
    <Compile Include="..\Kkindle.App.WinUI\ReaderAppearanceScripts.cs" Link="ReaderAppearanceScripts.cs" />
    <Compile Include="..\Kkindle.App.WinUI\ReaderWaveScripts.cs" Link="ReaderWaveScripts.cs" />
  </ItemGroup>
</Project>
