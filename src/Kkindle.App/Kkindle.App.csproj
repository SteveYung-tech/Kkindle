<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Kkindle</RootNamespace>
    <AssemblyName>Kkindle</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Kkindle.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <UseWinUI>true</UseWinUI>
    <Version>0.1.0</Version>
    <Product>Kkindle</Product>
    <Authors>kingstacker</Authors>
    <RepositoryUrl>https://github.com/kingstacker/Kkindle</RepositoryUrl>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
    <!-- Set this at publish time to bundle a Calibre Portable/runtime directory. -->
    <KkindleCalibreRuntime Condition="'$(KkindleCalibreRuntime)' == ''">$(KKINDLE_CALIBRE_RUNTIME)</KkindleCalibreRuntime>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\Kkindle.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Fonts\KingHwaOldSong-v3.0.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Fonts\KingHwaOldSong-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Calibre-THIRD-PARTY-NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <ProjectReference Include="..\Kkindle.Core\Kkindle.Core.csproj" />
    <ProjectReference Include="..\Kkindle.Infrastructure\Kkindle.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <Target Name="CopyApplicationPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    <Copy SourceFiles="$(ProjectDir)Assets\Calibre-THIRD-PARTY-NOTICE.txt" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)Assets\Calibre-THIRD-PARTY-NOTICE.txt')" />
  </Target>
  <Target Name="CopyBundledCalibreToPublish" AfterTargets="Publish" Condition="'$(KkindleCalibreRuntime)' != '' and Exists('$(KkindleCalibreRuntime)\ebook-convert.exe')">
    <ItemGroup>
      <BundledCalibreFiles Include="$(KkindleCalibreRuntime)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BundledCalibreFiles)"
      DestinationFiles="@(BundledCalibreFiles->'$(PublishDir)Calibre\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
