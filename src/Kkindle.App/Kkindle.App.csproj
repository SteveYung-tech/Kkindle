<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Deliberately plain net8.0, never net8.0-windows: this project holds all
         UI code, and keeping it platform-neutral makes the compiler reject any
         Windows-only API that creeps in. Platform services arrive through the
         Kkindle.Core interfaces, wired by a per-platform head project
         (Kkindle.Desktop.Windows today). -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Kkindle</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kkindle.Core\Kkindle.Core.csproj" />
    <ProjectReference Include="..\Kkindle.Infrastructure\Kkindle.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
