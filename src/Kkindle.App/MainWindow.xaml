                                 BorderThickness="1" />
                    </StackPanel>
                    <Grid Grid.Row="1"
                          Padding="28,18,28,22"
                          Background="#FFFFFF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DeviceModelInputOkButton"
                                Content="确定"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="DeviceModelInputOkButton_Click" />
                        <Button Grid.Column="2"
                                Content="取消"
                                Style="{StaticResource QuietButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="DeviceModelInputCancelButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Custom monochrome collection name input; consistent with the other
