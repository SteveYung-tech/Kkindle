<Window
    x:Class="Kkindle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Kkindle.Core"
    xmlns:infra="using:Kkindle.Infrastructure"
    xmlns:local="using:Kkindle">

    <Grid x:Name="RootGrid"
          Background="{StaticResource PageBackgroundBrush}"
          SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Invisible drag strip with caption buttons embedded in the page. -->
        <Grid x:Name="WindowChromeLayer"
              Grid.Row="0"
              Grid.ColumnSpan="3"
              Height="38"
              VerticalAlignment="Top"
              Canvas.ZIndex="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragRegion" Background="Transparent" />
            <TextBlock x:Name="ReaderBrandText"
                       Grid.Column="0"
                       Text="Kreader"
                       Foreground="#000000"
                       FontSize="18"
                       FontWeight="Bold"
                       CharacterSpacing="60"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                <Button x:Name="ReaderZenTitleTocButton"
                        Content="极简目录"
                        Width="92"
                        Height="38"
                        FontSize="11"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        AutomationProperties.Name="切换极简目录"
                        ToolTipService.ToolTip="显示或隐藏禅模式极简目录"
                        Visibility="Collapsed"
                        Click="ReaderZenMinimalTocButton_Click" />
                <Button x:Name="ReaderZenTitleExitButton"
                        Content="退出禅模式"
                        Width="104"
                        Height="38"
                        FontSize="11"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        AutomationProperties.Name="退出禅模式"
                        ToolTipService.ToolTip="退出禅模式，恢复目录与阅读助手"
                        Visibility="Collapsed"
                        Click="ReaderExitZenButton_Click" />
                <Button x:Name="MinimizeWindowButton"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        Click="MinimizeWindowButton_Click"
                        AutomationProperties.Name="最小化">
                    <FontIcon Glyph="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        Click="MaximizeWindowButton_Click"
                        AutomationProperties.Name="最大化">
                    <FontIcon x:Name="MaximizeWindowGlyph" Glyph="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="CloseWindowButton"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        Click="CloseWindowButton_Click"
                        AutomationProperties.Name="关闭">
                    <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Left navigation -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Padding="18,24,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" Background="#000000">
                        <TextBlock Text="K" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="Kkindle" Foreground="#000000" FontSize="18" FontWeight="Bold" CharacterSpacing="60" />
                        <TextBlock Text="个人电子书架" Foreground="#5A5A5A" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,24,0,16"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <Button x:Name="BookManagementSectionButton"
                                    Style="{StaticResource SidebarSectionButtonStyle}"
                                    Click="SidebarSectionButton_Click"
                                    PointerEntered="SidebarSectionButton_PointerEntered"
                                    PointerMoved="SidebarSectionButton_PointerEntered"
                                    PointerExited="SidebarSectionButton_PointerExited"
                                    AutomationProperties.Name="书籍管理，已展开">
                                <Grid>
                                    <TextBlock Text="书籍管理" VerticalAlignment="Center" />
                                    <FontIcon x:Name="BookManagementChevron"
                                               Glyph="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="10" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="BookManagementChildren" Spacing="3">
                            <Button x:Name="AllBooksButton"
                                    AutomationProperties.Name="电脑书库"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Click="NavigationButton_Click">
                                <Grid HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="AllBooksLabelText"
                                               Text="电脑书库"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="SidebarCountText"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="KindleBooksButton"
                                    AutomationProperties.Name="Kindle书库"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Click="KindleBooksButton_Click">
                                <Grid HorizontalAlignment="Stretch">
                                    <TextBlock Text="Kindle书库"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="DeviceBookCountText"
                                               Text="0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Button x:Name="DeviceManagementSectionButton"
                                    Style="{StaticResource SidebarSectionButtonStyle}"
                                    Click="SidebarSectionButton_Click"
                                    PointerEntered="SidebarSectionButton_PointerEntered"
                                    PointerMoved="SidebarSectionButton_PointerEntered"
                                    PointerExited="SidebarSectionButton_PointerExited"
                                    AutomationProperties.Name="设备管理，已收起">
                                <Grid>
                                    <TextBlock Text="设备管理" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DeviceManagementChevron" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="DeviceManagementChildren" Spacing="3" Visibility="Collapsed">
                                <Button x:Name="DeviceOverviewButton" Content="设备概览" Style="{StaticResource SidebarButtonStyle}" Click="DeviceOverviewButton_Click" />
                                <Button x:Name="FontManagementNavigationButton" Content="字体管理" Style="{StaticResource SidebarButtonStyle}" Click="FontManagementButton_Click" />
                                <Button x:Name="DictionaryManagementNavigationButton" Content="字典管理" Style="{StaticResource SidebarButtonStyle}" Click="DictionaryManagementButton_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Button x:Name="ReadingSectionButton"
                                    Style="{StaticResource SidebarSectionButtonStyle}"
                                    Click="SidebarSectionButton_Click"
                                    PointerEntered="SidebarSectionButton_PointerEntered"
                                    PointerMoved="SidebarSectionButton_PointerEntered"
                                    PointerExited="SidebarSectionButton_PointerExited"
                                    AutomationProperties.Name="阅读资料，已收起">
                                <Grid>
                                    <TextBlock Text="阅读资料" VerticalAlignment="Center" />
                                    <FontIcon x:Name="ReadingChevron" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ReadingChildren" Spacing="3" Visibility="Collapsed">
                                <Button x:Name="ReaderNotesNavigationButton"
                                        Content="笔记与标注"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Click="ReaderNotesNavigationButton_Click" />
                                <Button x:Name="ReaderExportNavigationButton"
                                        Content="导出记录"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Click="ReaderExportNavigationButton_Click" />
                                <Button x:Name="ReadingDashboardNavigationButton"
                                        Content="阅读数据"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Click="ReadingDashboardButton_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Button x:Name="SystemSectionButton"
                                    Style="{StaticResource SidebarSectionButtonStyle}"
                                    Click="SidebarSectionButton_Click"
                                    PointerEntered="SidebarSectionButton_PointerEntered"
                                    PointerMoved="SidebarSectionButton_PointerEntered"
                                    PointerExited="SidebarSectionButton_PointerExited"
                                    AutomationProperties.Name="系统，已收起">
                                <Grid>
                                    <TextBlock Text="系统" VerticalAlignment="Center" />
                                    <FontIcon x:Name="SystemChevron" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="SystemChildren" Spacing="3" Visibility="Collapsed">
                                <Button x:Name="SettingsNavigationButton" Content="设置" Style="{StaticResource SidebarButtonStyle}" Click="SettingsButton_Click" />
                                <Button x:Name="KindleEmailSettingsNavigationButton" Content="Kindle 邮箱设置" Style="{StaticResource SidebarButtonStyle}" Click="KindleEmailSettingsButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="10" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="连接设备" FontSize="10" Foreground="#5A5A5A" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="KindleStatusText"
                                       Foreground="#000000"
                                       FontWeight="Bold"
                                       Text="正在检查设备…"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="EjectDeviceButton"
                                    Grid.Column="1"
                                    AutomationProperties.Name="弹出设备"
                                    Style="{StaticResource EjectButtonStyle}"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="未连接设备"
                                    Click="EjectDeviceButton_Click" />
                        </Grid>
                        <TextBlock x:Name="KindleConnectionText" Foreground="#5A5A5A" FontSize="10" />
                        <Grid x:Name="DeviceStorageBar" Height="10" Background="#FFFFFF" SizeChanged="DeviceStorageBar_SizeChanged">
                            <Rectangle x:Name="DeviceStorageUsedBar" HorizontalAlignment="Left" VerticalAlignment="Stretch" Fill="#000000" Width="0" />
                            <Border BorderBrush="#000000" BorderThickness="1" />
                        </Grid>
                        <TextBlock x:Name="DeviceStorageText" Text="无存储信息" Foreground="#5A5A5A" FontSize="10" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Rectangle Width="7" Height="7" Fill="#000000" />
                                <TextBlock Text="已用" FontSize="9" Foreground="#5A5A5A" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Rectangle Width="7" Height="7" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1" />
                                <TextBlock Text="剩余" FontSize="9" Foreground="#5A5A5A" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Library -->
        <Grid x:Name="LibraryPane"
              Grid.Row="0"
              Grid.Column="1"
              Padding="30,24,30,18"
              AllowDrop="True"
              DragOver="LibraryPane_DragOver"
              DragLeave="LibraryPane_DragLeave"
              Drop="LibraryPane_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="本地" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="电脑书库"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="28"
                               FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="LibrarySummaryText"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource MutedInkBrush}"
                               Text="正在读取书库…" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Content="导入文件" Style="{StaticResource QuietButtonStyle}" Click="ImportFilesButton_Click" />
                    <Button Content="导入文件夹" Style="{StaticResource QuietButtonStyle}" Click="ImportFolderButton_Click" />
                    <Button Content="导入备份" Style="{StaticResource QuietButtonStyle}" Click="ImportBackupButton_Click" />
                    <Button Content="导出备份" Click="ExportBackupButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,22,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         Height="38"
                         Padding="13,7"
                         PlaceholderText="搜索标题或作者"
                         TextChanged="SearchBox_TextChanged" />
                <Button x:Name="FilterButton"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        Content="筛选"
                        Style="{StaticResource QuietButtonStyle}"
                        Click="FilterButton_Click" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Content="网格" Style="{StaticResource QuietButtonStyle}" Click="GridViewButton_Click" />
                    <Button Content="列表" Style="{StaticResource QuietButtonStyle}" Click="ListViewButton_Click" />
                    <Button Content="更多" Style="{StaticResource QuietButtonStyle}" Click="MoreButton_Click" />
                </StackPanel>
            </Grid>

            <Border x:Name="FilterPanel"
                    Grid.Row="2"
                    Margin="0,0,0,18"
                    Padding="12"
                    BorderBrush="#000000"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AuthorFilterBox"
                              Header="作者"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="TagFilterBox"
                              Grid.Column="1"
                              Header="标签"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="FormatFilterBox"
                              Grid.Column="2"
                              Header="格式"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="CategoryFilterBox"
                              Grid.Column="3"
                              Header="分类"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="ReadingStatusFilterBox"
                              Grid.Column="4"
                              Header="阅读状态"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="LibrarySortBox"
                              Grid.Column="5"
                              Header="排序"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <CheckBox x:Name="FavoritesOnlyCheck"
                              Grid.Column="6"
                              Margin="0,22,0,0"
                              Content="仅收藏"
                              Click="FavoritesOnlyCheck_Click" />
                    <Button Grid.Column="7"
                            Margin="0,22,0,0"
                            Content="清除筛选"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="ClearFiltersButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <GridView x:Name="BookGrid"
                          ItemsSource="{x:Bind ViewModel.Books}"
                          IsItemClickEnabled="True"
                          ItemClick="BookGrid_ItemClick"
                          DoubleTapped="BookGrid_DoubleTapped"
                          SelectionMode="None"
                          ItemContainerStyle="{StaticResource BookCardItemStyle}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:BookCardViewModel">
                            <Grid Width="154">
                                <Grid.ContextFlyout>
                                    <MenuFlyout Opening="BookContextFlyout_Opening"
                                                MenuFlyoutPresenterStyle="{StaticResource MonochromeMenuFlyoutPresenterStyle}">
                                        <MenuFlyoutSubItem Text="打开书籍"
                                                           Tag="{x:Bind Book}">
                                            <MenuFlyoutItem Text="EPUB"
                                                            Tag="{x:Bind Book}"
                                                            Click="OpenBookFormatMenuItem_Click" />
                                            <MenuFlyoutItem Text="PDF"
                                                            Tag="{x:Bind Book}"
                                                            Click="OpenBookFormatMenuItem_Click" />
                                            <MenuFlyoutItem Text="AZW3"
                                                            Tag="{x:Bind Book}"
                                                            Click="OpenBookFormatMenuItem_Click" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="转换为"
                                                           Tag="{x:Bind Book}">
                                            <MenuFlyoutItem Text="EPUB"
                                                            Tag="{x:Bind Book}"
                                                            Click="ConvertBookToEpubMenuItem_Click" />
                                            <MenuFlyoutItem Text="AZW3"
                                                            Tag="{x:Bind Book}"
                                                            Click="ConvertBookToAzw3MenuItem_Click" />
                                            <MenuFlyoutItem Text="PDF"
                                                            Tag="{x:Bind Book}"
                                                            Click="ConvertBookToPdfMenuItem_Click" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="发送到 Kindle 设备"
                                                        Tag="{x:Bind Book}"
                                                        Click="SendBookToKindleMenuItem_Click" />
                                        <MenuFlyoutItem Text="发送到 Kindle 邮箱"
                                                        Tag="{x:Bind Book}"
                                                        Click="SendBookToKindleEmailMenuItem_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="删除格式"
                                                           Tag="{x:Bind Book}">
                                            <MenuFlyoutItem Text="EPUB"
                                                            Tag="{x:Bind Book}"
                                                            Click="DeleteBookFormatMenuItem_Click" />
                                            <MenuFlyoutItem Text="PDF"
                                                            Tag="{x:Bind Book}"
                                                            Click="DeleteBookFormatMenuItem_Click" />
                                            <MenuFlyoutItem Text="MOBI"
                                                            Tag="{x:Bind Book}"
                                                            Click="DeleteBookFormatMenuItem_Click" />
                                            <MenuFlyoutItem Text="AZW3"
                                                            Tag="{x:Bind Book}"
                                                            Click="DeleteBookFormatMenuItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="删除全部格式"
                                                            Tag="{x:Bind Book}"
                                                            Click="DeleteAllBookFormatsMenuItem_Click" />
                                        </MenuFlyoutSubItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="214" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="#D9D9D9"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0">
                                    <Grid Background="Transparent">
                                        <TextBlock Text="BOOK"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#5A5A5A"
                                                   FontSize="17"
                                                   CharacterSpacing="160" />
                                        <Image Source="{x:Bind CoverImage}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,9,2,0" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Foreground="{StaticResource InkBrush}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2" />
                                    <TextBlock Text="{x:Bind Authors}"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind FormatLabel}"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="10" />
                                </StackPanel>
                                <Border Grid.Row="0"
                                        Width="68"
                                        Height="25"
                                        Margin="0,0,5,5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="#FFFFFF"
                                        BorderBrush="#000000"
                                        BorderThickness="1"
                                        Canvas.ZIndex="3"
                                        Visibility="{x:Bind ConversionProgressVisibility, Mode=OneWay}"
                                        Tapped="BookConversionProgressIndicator_Tapped"
                                        AutomationProperties.Name="打开格式转换进度">
                                    <Grid Width="66" Height="23">
                                        <local:RectangularProgressBar Height="5"
                                                                      Margin="5,0,5,3"
                                                                      VerticalAlignment="Bottom"
                                                                      Minimum="0"
                                                                      Maximum="100"
                                                                      Value="{x:Bind ConversionProgress, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ConversionProgressLabel, Mode=OneWay}"
                                                   Foreground="#000000"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <ListView x:Name="BookList"
                          Visibility="Collapsed"
                          ItemsSource="{x:Bind ViewModel.Books}"
                          DoubleTapped="BookList_DoubleTapped"
                          SelectionChanged="BookList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:BookCardViewModel">
                            <Grid Padding="8,9" MinHeight="66">
                                <Grid.ContextFlyout>
                                    <MenuFlyout Opening="BookContextFlyout_Opening"
                                                MenuFlyoutPresenterStyle="{StaticResource MonochromeMenuFlyoutPresenterStyle}">
                                        <MenuFlyoutSubItem Text="打开书籍"
                                                           Tag="{x:Bind Book}">
                                            <MenuFlyoutItem Text="EPUB"
                                                            Tag="{x:Bind Book}"
                                                            Click="OpenBookFormatMenuItem_Click" />
                                            <MenuFlyoutItem Text="PDF"
                                                            Tag="{x:Bind Book}"
                                                            Click="OpenBookFormatMenuItem_Click" />
                                            <MenuFlyoutItem Text="AZW3"
                                                            Tag="{x:Bind Book}"
                                                            Click="OpenBookFormatMenuItem_Click" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="转换为"
                                                           Tag="{x:Bind Book}">
                                            <MenuFlyoutItem Text="EPUB"
                                                            Tag="{x:Bind Book}"
                                                            Click="ConvertBookToEpubMenuItem_Click" />
                                            <MenuFlyoutItem Text="AZW3"
                                                            Tag="{x:Bind Book}"
                                                            Click="ConvertBookToAzw3MenuItem_Click" />
                                            <MenuFlyoutItem Text="PDF"
                                                            Tag="{x:Bind Book}"
                                                            Click="ConvertBookToPdfMenuItem_Click" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="发送到 Kindle 设备"
                                                        Tag="{x:Bind Book}"
                                                        Click="SendBookToKindleMenuItem_Click" />
                                        <MenuFlyoutItem Text="发送到 Kindle 邮箱"
                                                        Tag="{x:Bind Book}"
                                                        Click="SendBookToKindleEmailMenuItem_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="删除格式"
                                                           Tag="{x:Bind Book}">
                                            <MenuFlyoutItem Text="EPUB"
                                                            Tag="{x:Bind Book}"
                                                            Click="DeleteBookFormatMenuItem_Click" />
                                            <MenuFlyoutItem Text="PDF"
                                                            Tag="{x:Bind Book}"
                                                            Click="DeleteBookFormatMenuItem_Click" />
                                            <MenuFlyoutItem Text="MOBI"
                                                            Tag="{x:Bind Book}"
                                                            Click="DeleteBookFormatMenuItem_Click" />
                                            <MenuFlyoutItem Text="AZW3"
                                                            Tag="{x:Bind Book}"
                                                            Click="DeleteBookFormatMenuItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="删除全部格式"
                                                            Tag="{x:Bind Book}"
                                                            Click="DeleteAllBookFormatsMenuItem_Click" />
                                        </MenuFlyoutSubItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="48" Background="#D9D9D9" BorderBrush="#000000" BorderThickness="1" CornerRadius="0">
                                    <Image Source="{x:Bind CoverImage}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind FileCountLabel}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Authors}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind FormatLabel}" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" />
                                <Border Grid.Column="4"
                                        Width="68"
                                        Height="25"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="#FFFFFF"
                                        BorderBrush="#000000"
                                        BorderThickness="1"
                                        Visibility="{x:Bind ConversionProgressVisibility, Mode=OneWay}"
                                        Tapped="BookConversionProgressIndicator_Tapped"
                                        AutomationProperties.Name="打开格式转换进度">
                                    <Grid Width="66" Height="23">
                                        <local:RectangularProgressBar Height="5"
                                                                      Margin="5,0,5,3"
                                                                      VerticalAlignment="Bottom"
                                                                      Minimum="0"
                                                                      Maximum="100"
                                                                      Value="{x:Bind ConversionProgress, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ConversionProgressLabel, Mode=OneWay}"
                                                   Foreground="#000000"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyLibraryState"
                            Canvas.ZIndex="5"
                            Width="320"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                    <Border Width="58" Height="76" HorizontalAlignment="Center" BorderBrush="#000000" BorderThickness="2">
                        <TextBlock Text="BOOK" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" CharacterSpacing="100" />
                    </Border>
                    <TextBlock x:Name="EmptyLibraryTitleText"
                               Text="电脑书库还是空的"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock x:Name="EmptyLibraryMessageText"
                               Text="拖入书籍文件，或使用右上角的导入按钮"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedInkBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <ProgressBar x:Name="TaskProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="3" />
                <TextBlock x:Name="TaskStatusText"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="11"
                           HorizontalAlignment="Right" />
            </Grid>

            <Border x:Name="DropImportOverlay"
                    Grid.RowSpan="5"
                    Canvas.ZIndex="20"
                    Margin="0,46,0,0"
                    Background="#F2FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="34" />
                    <TextBlock Text="拖放书籍到电脑书库"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="支持 EPUB、PDF、MOBI、AZW3"
                               Foreground="{StaticResource MutedInkBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- App settings and portable data migration. -->
        <Grid x:Name="SettingsPane"
              Grid.Row="0"
              Grid.Column="1"
              Padding="30,24,30,18"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="3">
                <TextBlock Text="设置"
                           Foreground="{StaticResource InkBrush}"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="管理本地数据，并在设备之间快速迁移。"
                           Foreground="{StaticResource MutedInkBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" Spacing="16">
                    <Border Padding="18"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="数据备份与迁移" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="一键打包书籍文件、封面、书库信息和阅读记录，生成 .kkindle 备份文件。导入备份会覆盖当前书库；导入前会自动校验备份内容。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="AI API Key 和 Kindle 邮箱密码不会导出；导入后保留当前设备已有的密钥，没有密钥时需要重新填写。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <Button Content="导出备份"
                                        Click="ExportBackupButton_Click" />
                                <Button Content="导入备份"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="ImportBackupButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="SettingsBackupStatusText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ApplicationSettingsCard"
                            Padding="18"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="应用与阅读默认设置" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="默认打开格式" FontSize="11" />
                                    <ComboBox x:Name="PreferredOpenFormatBox" CornerRadius="0">
                                        <ComboBoxItem Content="EPUB" Tag="epub" />
                                        <ComboBoxItem Content="PDF" Tag="pdf" />
                                        <ComboBoxItem Content="AZW3" Tag="azw3" />
                                        <ComboBoxItem Content="MOBI（转换为 EPUB）" Tag="mobi" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="自动备份保留数量" FontSize="11" />
                                    <NumberBox x:Name="AutoBackupRetentionBox" Minimum="1" Maximum="30" Value="5" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Calibre ebook-convert 路径" FontSize="11" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="CalibrePathBox" PlaceholderText="留空时自动查找" />
                                    <Button Grid.Column="1" Content="浏览" Style="{StaticResource QuietButtonStyle}" Click="BrowseCalibreButton_Click" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <CheckBox x:Name="AutoBackupCheck" Content="启动时自动备份（每日）" />
                                <CheckBox x:Name="AiEnabledCheck" Content="启用 AI 阅读助手" />
                                <CheckBox x:Name="NetworkEnabledCheck" Content="允许网络功能" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="保存应用设置" Click="SaveApplicationSettingsButton_Click" />
                                <TextBlock x:Name="ApplicationSettingsStatusText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                            </StackPanel>
                            <TextBlock Text="默认阅读排版" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <NumberBox x:Name="DefaultFontScaleBox" Header="字号比例" Minimum="0.8" Maximum="1.8" SmallChange="0.1" SpinButtonPlacementMode="Inline" />
                                <NumberBox x:Name="DefaultLineHeightBox" Grid.Column="1" Header="行高" Minimum="1.3" Maximum="2.6" SmallChange="0.05" SpinButtonPlacementMode="Inline" />
                                <NumberBox x:Name="DefaultMaxWidthBox" Grid.Column="2" Header="正文宽度" Minimum="480" Maximum="1200" SmallChange="20" SpinButtonPlacementMode="Inline" />
                                <NumberBox x:Name="DefaultBodyPaddingBox" Grid.Column="3" Header="页边距" Minimum="24" Maximum="160" SmallChange="8" SpinButtonPlacementMode="Inline" />
                            </Grid>
                            <ComboBox x:Name="DefaultFontFamilyBox" Header="默认正文字体" CornerRadius="0">
                                <ComboBoxItem Content="京华老宋体" Tag="京华老宋体" />
                                <ComboBoxItem Content="微软雅黑 Microsoft YaHei UI" Tag="Microsoft YaHei UI" />
                                <ComboBoxItem Content="宋体 SimSun" Tag="SimSun" />
                                <ComboBoxItem Content="黑体 SimHei" Tag="SimHei" />
                                <ComboBoxItem Content="楷体 KaiTi" Tag="KaiTi" />
                                <ComboBoxItem Content="等线 DengXian" Tag="DengXian" />
                                <ComboBoxItem Content="思源宋体 / Noto Serif CJK" Tag="Source Han Serif SC, Noto Serif CJK SC" />
                            </ComboBox>
                            <CheckBox x:Name="DefaultVerticalWritingCheck" Content="新书默认使用竖排" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="FontManagementCard" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Kreader 本地字体" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="导入 TTF、OTF、WOFF 或 WOFF2 字体；导入后可在每本书的阅读排版设置中选择。请自行确认字体许可。" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                            <ListView x:Name="ManagedFontList" MaxHeight="150" DisplayMemberPath="DisplayName" SelectionMode="Single" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="导入字体" Click="ImportFontButton_Click" />
                                <Button Content="移除所选" Style="{StaticResource QuietButtonStyle}" Click="RemoveFontButton_Click" />
                                <TextBlock x:Name="FontManagementStatusText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DictionaryManagementCard" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Kreader 本地词典" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="支持 UTF-8 文本词典，每行使用“词条 + Tab + 释义”或“词条=释义”。阅读时选中文字可直接查词。" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                            <ListView x:Name="ManagedDictionaryList" MaxHeight="150" DisplayMemberPath="Name" SelectionMode="Single" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="导入词典" Click="ImportDictionaryButton_Click" />
                                <Button Content="移除所选" Style="{StaticResource QuietButtonStyle}" Click="RemoveDictionaryButton_Click" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="DictionaryTestBox" PlaceholderText="测试查询" KeyDown="DictionaryTestBox_KeyDown" />
                                <Button Grid.Column="1" Content="查询" Click="DictionaryTestButton_Click" />
                            </Grid>
                            <TextBlock x:Name="DictionaryResultText" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ReadingDashboardCard" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="阅读数据" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReadingDashboardSummaryText" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReadingDashboardDetailText" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                            <ListView x:Name="ReadingDashboardRecentList" MaxHeight="180" DisplayMemberPath="Display" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="刷新统计" Click="RefreshReadingDashboardButton_Click" />
                                <Button Content="导出 CSV" Style="{StaticResource QuietButtonStyle}" Click="ExportReadingDashboardButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="18"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="本地数据目录" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="SettingsDataPathText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="书籍和阅读记录保存在本机；备份包可以复制到其他 Windows 设备使用。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="打开数据目录" Style="{StaticResource QuietButtonStyle}" Click="OpenDataDirectoryButton_Click" />
                                <Button Content="迁移数据目录" Style="{StaticResource QuietButtonStyle}" Click="MigrateDataDirectoryButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Kindle email settings. The password is encrypted by the local settings store. -->
        <Grid x:Name="KindleEmailSettingsOverlay"
              Grid.ColumnSpan="3"
              Margin="0,38,0,0"
              Canvas.ZIndex="100"
              Background="#66000000"
              Visibility="Collapsed">
            <Border Width="560"
                    MaxHeight="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" MaxHeight="600" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="22,20,22,16" Spacing="12">
                            <TextBlock Text="Kindle 邮箱设置" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="通过 SMTP 将 EPUB 或 PDF 发送到你的 Kindle 个人文档邮箱。请把 Kindle 收件地址加入发件邮箱的信任列表；密码建议使用应用专用密码。"
                                       FontSize="11"
                                       Foreground="#666666"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="Kindle 收件邮箱" FontSize="11" />
                                <TextBox x:Name="KindleEmailRecipientBox"
                                         PlaceholderText="例如 name@kindle.com" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="发件邮箱" FontSize="11" />
                                <TextBox x:Name="KindleEmailSenderBox"
                                         PlaceholderText="例如 you@example.com" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="SMTP 服务器" FontSize="11" />
                                    <TextBox x:Name="KindleEmailSmtpHostBox"
                                             PlaceholderText="smtp.example.com" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="端口" FontSize="11" />
                                    <TextBox x:Name="KindleEmailSmtpPortBox"
                                             Text="587"
                                             PlaceholderText="587" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="SMTP 用户名" FontSize="11" />
                                <TextBox x:Name="KindleEmailUsernameBox" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="SMTP 密码 / 应用专用密码" FontSize="11" />
                                <PasswordBox x:Name="KindleEmailPasswordBox"
                                             PlaceholderText="输入密码或应用专用密码" />
                            </StackPanel>
                            <CheckBox x:Name="KindleEmailSslCheck"
                                      Content="使用 SSL/TLS"
                                      IsChecked="True" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Padding="22,12,22,20" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="KindleEmailSettingsStatusText"
                                   FontSize="10"
                                   Foreground="#777777"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Content="取消"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="KindleEmailSettingsCancelButton_Click" />
                        <Button Grid.Column="2"
                                Content="保存"
                                Click="KindleEmailSettingsSaveButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Kindle device -->
        <Grid x:Name="DevicePage" Grid.Row="0" Grid.Column="1" Visibility="Collapsed" Padding="30,24,30,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="设备" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="DevicePageTitleText" Text="Kindle书库" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="DeviceNameText" Text="未检测到设备" Foreground="{StaticResource MutedInkBrush}" />
                    <Button Margin="0,9,0,0"
                            HorizontalAlignment="Left"
                            Content="刷新设备"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="RefreshDeviceButton_Click" />
                </StackPanel>
            </Grid>

            <GridView x:Name="DeviceBookList"
                      Grid.Row="1"
                      Margin="0,24,0,0"
                      ItemsSource="{x:Bind DeviceBooks}"
                      SelectionMode="None"
                      ItemContainerStyle="{StaticResource BookCardItemStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:KindleBookCardViewModel">
                        <Grid Width="154">
                            <Grid.ContextFlyout>
                                <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource MonochromeMenuFlyoutPresenterStyle}">
                                    <MenuFlyoutItem Text="导出到电脑书库"
                                                    Tag="{x:Bind}"
                                                    Click="ExportDeviceBookToLibraryMenuItem_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="214" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="#D9D9D9"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="360" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Authors}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind RelativePath}"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <Grid>
                                    <TextBlock Text="KINDLE"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="13"
                                               CharacterSpacing="120" />
                                    <Image Source="{x:Bind CoverImage}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="2,9,2,0" Spacing="2">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2" />
                                <TextBlock Text="{x:Bind Authors}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind InfoLabel}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock x:Name="DeviceReadOnlyNote" Grid.Row="2"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource MutedInkBrush}"
                       Text="仅显示 Kindle 的 documents；右键书籍可导出到电脑书库。" />
        </Grid>

        <!-- Kindle fonts and dictionaries. Operations are restricted to fonts or documents\dictionaries. -->
        <Grid x:Name="DeviceResourcePage" Grid.Row="0" Grid.Column="1" Visibility="Collapsed" Padding="30,24,30,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="设备" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="DeviceResourcePageTitle" Text="Kindle 字体" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="DeviceResourceStatusText" Text="请连接 Kindle" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button x:Name="ImportDeviceResourceButton" Content="导入到 Kindle" Click="ImportDeviceResourceButton_Click" />
                    <Button x:Name="ExportDeviceResourceButton" Content="导出所选" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" Click="ExportDeviceResourceButton_Click" />
                    <Button x:Name="DeleteDeviceResourceButton" Content="删除所选" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" Click="DeleteDeviceResourceButton_Click" />
                    <Button Content="刷新" Style="{StaticResource QuietButtonStyle}" Click="RefreshDeviceResourcesButton_Click" />
                    <Button Content="返回书架" Click="AllBooksButton_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,24,0,18" Padding="16" Background="#000000" BorderBrush="#000000" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DeviceResourcePathText" Text="fonts" Foreground="#BFBFBF" FontSize="11" />
                        <TextBlock x:Name="DeviceResourceDeviceText" Text="未检测到设备" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="DeviceResourceCountText" Grid.Column="1" Text="0 个文件" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ListView x:Name="DeviceResourceList"
                          ItemsSource="{x:Bind DeviceResources}"
                          SelectionMode="Single"
                          SelectionChanged="DeviceResourceList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:KindleDeviceResource">
                            <Grid Padding="10,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Format}" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="DeviceResourceEmptyText"
                           Text="此目录中没有可管理的文件"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedInkBrush}" />
            </Grid>
            <TextBlock x:Name="DeviceResourceSafetyText" Grid.Row="3" Margin="0,12,0,0" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
        </Grid>

        <!-- Unified local-reader and Kindle clippings library. -->
        <Grid x:Name="ReadingMaterialsPage" Grid.Row="0" Grid.Column="1" Visibility="Collapsed" Padding="30,24,30,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="资料" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="ReadingMaterialsPageTitle" Text="笔记与标注" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="ReadingMaterialsStatusText" Text="汇总本地书籍与 Kindle 的划线笔记" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button x:Name="LocateReadingMaterialButton" Content="在阅读器中定位" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" Click="LocateReadingMaterialButton_Click" />
                    <Button x:Name="DeleteReadingMaterialButton" Content="删除所选" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" Click="DeleteReadingMaterialButton_Click" />
                    <Button Content="刷新" Style="{StaticResource QuietButtonStyle}" Click="RefreshReadingMaterialsButton_Click" />
                    <Button Content="返回书架" Click="AllBooksButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,14" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="ReadingMaterialsSourceBox" Header="来源" SelectedIndex="0" SelectionChanged="ReadingMaterialsFilter_Changed">
                    <ComboBoxItem Content="全部来源" Tag="all" />
                    <ComboBoxItem Content="本地书籍" Tag="local" />
                    <ComboBoxItem Content="Kindle" Tag="kindle" />
                </ComboBox>
                <TextBox x:Name="ReadingMaterialsSearchBox" Grid.Column="1" Header="搜索" PlaceholderText="书名、划线、笔记或位置" TextChanged="ReadingMaterialsSearchBox_TextChanged" />
                <Button Grid.Column="2" Margin="0,22,0,0" Content="导出 Markdown" Click="ExportReadingMaterialsMarkdownButton_Click" />
                <Button Grid.Column="3" Margin="0,22,0,0" Content="导出文本" Style="{StaticResource QuietButtonStyle}" Click="ExportReadingMaterialsTextButton_Click" />
            </Grid>

            <Border Grid.Row="2" Margin="0,0,0,14" Padding="14,11" Background="#000000">
                <TextBlock x:Name="ReadingMaterialsSummaryText" Text="本地 0 条 · Kindle 0 条" Foreground="#FFFFFF" FontWeight="SemiBold" />
            </Border>

            <Grid Grid.Row="3">
                <ListView x:Name="ReadingMaterialsList"
                          ItemsSource="{x:Bind ReadingMaterials}"
                          SelectionMode="Single"
                          SelectionChanged="ReadingMaterialsList_SelectionChanged"
                          IsItemClickEnabled="True"
                          ItemClick="ReadingMaterialsList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ReadingMaterialItemViewModel">
                            <Grid Padding="12,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind SourceLabel}" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind TypeLabel}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind BookTitle}" TextWrapping="Wrap" MaxLines="2" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="{x:Bind Quote}" TextWrapping="Wrap" MaxLines="3" />
                                    <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" MaxLines="2" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind Location}" TextWrapping="Wrap" MaxLines="2" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind DateLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="ReadingMaterialsEmptyText" Text="没有符合条件的划线与笔记" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" />
            </Grid>
        </Grid>

        <!-- Book details -->
        <Border x:Name="DetailPane"
                Grid.Row="0"
                Grid.Column="2"
                Visibility="Collapsed"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Padding="24,70,24,24" Spacing="13">
                    <Button Content="关闭" HorizontalAlignment="Right" Style="{StaticResource QuietButtonStyle}" Click="CloseDetailButton_Click" />
                    <Border Height="250" Background="#D9D9D9" BorderBrush="#000000" BorderThickness="1" CornerRadius="0">
                        <Image x:Name="DetailCoverImage" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="书籍信息" FontSize="20" FontWeight="Bold" />
                    <Button x:Name="OpenSelectedBookButton"
                            Content="开始阅读"
                            AutomationProperties.Name="开始阅读"
                            Click="OpenSelectedBookButton_Click" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="标题" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsTitleBox" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="作者" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsAuthorsBox" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="系列" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsSeriesBox" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="标签" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsTagsBox" PlaceholderText="多个标签用逗号分隔" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="分类" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsCategoryBox" PlaceholderText="例如：技术、文学" />
                    </StackPanel>
                    <CheckBox x:Name="DetailsFavoriteCheck" Content="加入收藏" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="阅读状态" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <ComboBox x:Name="DetailsReadingStatusBox" CornerRadius="0">
                            <ComboBoxItem Content="待读" Tag="0" />
                            <ComboBoxItem Content="阅读中" Tag="1" />
                            <ComboBoxItem Content="已读" Tag="2" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="简介" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                    </StackPanel>
                    <Button Content="保存修改" Click="SaveDetailsButton_Click" />
                    <Button Content="发送到 Kindle" Style="{StaticResource QuietButtonStyle}" Click="SendToKindleButton_Click" />
                    <Button Content="发送到 Kindle 邮箱"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="SendSelectedBookToKindleEmailButton_Click" />
                    <Button Content="从书库删除" Style="{StaticResource QuietButtonStyle}" Click="DeleteBookButton_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Focused three-pane EPUB/PDF reader inspired by desktop reading tools. -->
        <Grid x:Name="ReaderPane"
              Grid.ColumnSpan="3"
              Margin="0"
              Canvas.ZIndex="40"
              Background="#FFFFFF"
              Visibility="Collapsed">
            <Grid.Resources>
                <!-- Keep every native scrollbar inside the reader consistent
                     with the original directory scrollbar. -->
                <SolidColorBrush x:Key="ScrollBarBackground" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarBackgroundDisabled" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarBorderBrush" Color="#000000" />
                <SolidColorBrush x:Key="ScrollBarBorderBrushPointerOver" Color="#000000" />
                <SolidColorBrush x:Key="ScrollBarBorderBrushDisabled" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#000000" />
                <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#111111" />
                <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#000000" />
                <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#777777" />
                <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="#000000" />
                <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarTrackStrokeDisabled" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#000000" />
                <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#000000" />
                <SolidColorBrush x:Key="ScrollBarPanningThumbBackgroundDisabled" Color="#777777" />
                <x:Double x:Key="ScrollBarSize">10</x:Double>
                <x:Double x:Key="ScrollBarVerticalThumbMinWidth">8</x:Double>
                <x:Double x:Key="ScrollBarThumbOffset">1</x:Double>
                <CornerRadius x:Key="ScrollBarCornerRadius">0</CornerRadius>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ReaderTocColumn" Width="286" />
                <ColumnDefinition x:Name="ReaderContentColumn" Width="*" />
                <ColumnDefinition x:Name="ReaderAssistantColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Table of contents and reading progress. -->
            <Border x:Name="ReaderTocPanel"
                    Grid.Column="0"
                    Margin="0,38,0,0"
                    Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>

                    <!-- Keep the content divider continuous through the footer. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="5"
                               Width="1"
                               HorizontalAlignment="Right"
                               Fill="#000000"
                               IsHitTestVisible="False" />

                    <Grid Padding="14,8" BorderBrush="#000000" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ReaderBookInfoText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                    AutomationProperties.Name="切换极简目录"
                                    ToolTipService.ToolTip="切换极简目录"
                                    Click="ReaderTocMinimalToggleButton_Click">
                                <FontIcon Glyph="&#xE8A5;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                    AutomationProperties.Name="收起目录"
                                    ToolTipService.ToolTip="收起目录"
                                    Click="ReaderTocToggleButton_Click">
                                <FontIcon Glyph="&#xE76C;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Padding="14,0,14,8" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ReaderTocTabButton"
                                Content="目录"
                                HorizontalAlignment="Stretch"
                                BorderThickness="1"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                Click="ReaderTocTabButton_Click" />
                        <Button x:Name="ReaderBookmarkTabButton"
                                Grid.Column="1"
                                Content="书签"
                                HorizontalAlignment="Stretch"
                                BorderThickness="1"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                Click="ReaderBookmarkTabButton_Click" />
                    </Grid>

                    <TextBox x:Name="ReaderTocSearchBox"
                             Grid.Row="2"
                             Margin="14,0,14,10"
                             Height="34"
                             Padding="10,5"
                             CornerRadius="0"
                             BorderBrush="#000000"
                             PlaceholderText="搜索目录"
                             TextChanged="ReaderTocSearchBox_TextChanged" />

                    <Grid Grid.Row="3">
                        <ListView x:Name="ReaderTocList"
                                  SelectionMode="Single"
                                  ItemContainerStyle="{StaticResource ReaderTocItemStyle}"
                                  SelectionChanged="ReaderTocList_SelectionChanged"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="infra:EpubReaderNavigationItem">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ReaderTocEmptyText"
                                   Margin="20"
                                   Text="此文档没有可用目录。"
                                   FontSize="12"
                                   Foreground="#777777"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />

                        <Grid x:Name="ReaderBookmarkPane" Visibility="Collapsed">
                            <ListView x:Name="ReaderBookmarkList"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="ReaderBookmarkList_ItemClick"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:ReaderBookmark">
                                        <Grid Margin="0,1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Padding="12,7,4,7" Spacing="3">
                                                <TextBlock Text="{x:Bind DisplayTitle}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DisplayQuote}"
                                                           FontSize="10"
                                                           Foreground="#707070"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DisplayTime}"
                                                           FontSize="9"
                                                           Foreground="#909090" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,6,0"
                                                    Content="×"
                                                    FontSize="13"
                                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                                    AutomationProperties.Name="删除书签"
                                                    Click="ReaderBookmarkDeleteButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="ReaderBookmarkEmptyText"
                                       Margin="20"
                                       Text="还没有书签。阅读时按 Ctrl+B 或点击顶部“书签”按钮添加。"
                                       FontSize="12"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="4"
                                Margin="14,4,14,8"
                                Spacing="2">
                        <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReaderReadingProgressText"
                                       Text="准备阅读"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="ReaderProgressPercentText"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock x:Name="ReaderStatsText"
                                   FontSize="10"
                                   Foreground="#5E5E5E"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="5"
                            Margin="10,6"
                            BorderBrush="#000000"
                            BorderThickness="1"
                            CornerRadius="0">
                        <Button Content="返回书架"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                Click="CloseReaderButton_Click" />
                    </Border>
                </Grid>
            </Border>

            <!-- Minimal TOC rail: small markers keep the chapter map visible without
                 taking the reading column away from the正文. -->
            <Border x:Name="ReaderTocCompactPanel"
                    Grid.Column="0"
                    Margin="0,38,0,0"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Width="28"
                          HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ReaderTocCompactUpIndicator"
                                   Text="&#x25B3;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="12"
                                   Foreground="#000000"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Up chapter status" />
                    <Button Grid.Row="1"
                            Width="28"
                            MinWidth="0"
                            Height="34"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReaderHeaderIconButtonStyle}"
                            AutomationProperties.Name="展开完整目录"
                            ToolTipService.ToolTip="展开完整目录"
                            Click="ReaderTocCompactExpandButton_Click">
                        <FontIcon Glyph="&#xE8A5;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="13"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  x:Name="ReaderTocCompactScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Enabled"
                                  Padding="0,8"
                                  ViewChanged="ReaderTocCompactScrollViewer_ViewChanged"
                                  PointerWheelChanged="ReaderTocCompactScrollViewer_PointerWheelChanged">
                        <ItemsControl x:Name="ReaderTocCompactList"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ReaderTocMarker">
                                    <Button Width="28"
                                            Height="16"
                                            MinWidth="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            AutomationProperties.Name="{x:Bind Title}"
                                            ToolTipService.Placement="Right"
                                            ToolTipService.ToolTip="{x:Bind Title}"
                                            PointerEntered="ReaderCompactTocMarker_PointerEntered"
                                            PointerExited="ReaderCompactTocMarker_PointerExited"
                                            Click="ReaderCompactTocItem_Click">
                                        <Border Width="14"
                                                Height="5"
                                                Background="{x:Bind Fill}"
                                                BorderBrush="{x:Bind Stroke}"
                                                BorderThickness="1"
                                                IsHitTestVisible="False"
                                                RenderTransformOrigin="0.5,0.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2"
                               x:Name="ReaderTocCompactDownIndicator"
                               Text="&#x25BD;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="12"
                               Foreground="#000000"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="Down chapter status" />
                </Grid>
            </Border>

            <!-- Reading canvas and compact controls. -->
            <Grid x:Name="ReaderContentPanel"
                  Grid.Column="1"
                  Margin="0,38,0,0"
                  Background="#FFFFFF"
                  SizeChanged="ReaderContentPanel_SizeChanged">
                <Grid.Clip>
                    <RectangleGeometry x:Name="ReaderContentClip" />
                </Grid.Clip>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ReaderHeaderRow" Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="ReaderFooterRow" Height="50" />
                </Grid.RowDefinitions>

                <Border x:Name="ReaderHeaderBar"
                        Background="#FFFFFF"
                        BorderBrush="#000000"
                        BorderThickness="0,0,0,1">
                    <Grid Padding="12,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="5">
                            <Button x:Name="ReaderTocToggleButton"
                                    Content="目录"
                                    Width="64"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    ToolTipService.ToolTip="显示或隐藏目录"
                                    Click="ReaderTocToggleButton_Click" />
                            <Button x:Name="ReaderSearchToolbarButton"
                                    Content="搜索"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    AutomationProperties.Name="书内搜索"
                                    ToolTipService.ToolTip="搜索整本书（Ctrl+F）"
                                    Click="ReaderSearchToolbarButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ReaderStatusText"
                                   Grid.Column="1"
                                   Margin="4,0"
                                   FontSize="10"
                                   Foreground="#858585"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <ScrollViewer Grid.Column="2"
                                      MaxWidth="920"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="ReaderZoomOutButton"
                                    Content="A−"
                                    Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                    AutomationProperties.Name="减小字号"
                                    Click="ReaderZoomOutButton_Click" />
                            <TextBlock x:Name="ReaderZoomText"
                                       Width="44"
                                       Text="100%"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <Button x:Name="ReaderZoomInButton"
                                    Content="A+"
                                    Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                    AutomationProperties.Name="增大字号"
                                    Click="ReaderZoomInButton_Click" />
                            <Rectangle Width="1" Height="22" Margin="3,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                            <Button x:Name="ReaderFlowButton"
                                    Content="分页"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    ToolTipService.ToolTip="选择滚动、单页或双栏阅读模式"
                                    AutomationProperties.Name="选择阅读分页模式">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <RadioMenuFlyoutItem x:Name="ReaderScrollModeItem"
                                                             Text="滚动"
                                                             Tag="scroll"
                                                             GroupName="ReaderFlowMode"
                                                             Click="ReaderFlowModeItem_Click" />
                                        <RadioMenuFlyoutItem x:Name="ReaderSinglePageModeItem"
                                                             Text="单页"
                                                             Tag="single"
                                                             GroupName="ReaderFlowMode"
                                                             Click="ReaderFlowModeItem_Click" />
                                        <RadioMenuFlyoutItem x:Name="ReaderTwoPageModeItem"
                                                             Text="双栏"
                                                             Tag="double"
                                                             GroupName="ReaderFlowMode"
                                                             Click="ReaderFlowModeItem_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="ReaderMoreButton"
                                    Content="更多"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    ToolTipService.ToolTip="阅读设置"
                                    AutomationProperties.Name="阅读设置">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <ToggleMenuFlyoutItem x:Name="ReaderZenMenuItem"
                                                              Text="禅模式"
                                                              ToolTipService.ToolTip="隐藏目录与阅读助手，最大化正文区域"
                                                              Click="ReaderZenMenuItem_Click" />
                                        <MenuFlyoutItem Text="阅读排版设置"
                                                        ToolTipService.ToolTip="字号、行距、正文宽度、字体与竖排"
                                                        Click="ReaderLayoutSettingsMenuItem_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="翻页动画" IsEnabled="False" />
                                        <RadioMenuFlyoutItem x:Name="ReaderAnimationNoneItem"
                                                             Text="无动画"
                                                             GroupName="ReaderPageAnimation"
                                                             Click="ReaderAnimationItem_Click" />
                                        <RadioMenuFlyoutItem x:Name="ReaderAnimationFadeItem"
                                                             Text="淡入淡出"
                                                             GroupName="ReaderPageAnimation"
                                                             IsChecked="True"
                                                             Click="ReaderAnimationItem_Click" />
                                        <RadioMenuFlyoutItem x:Name="ReaderAnimationSlideItem"
                                                             Text="左右滑动"
                                                             GroupName="ReaderPageAnimation"
                                                             Click="ReaderAnimationItem_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Rectangle Width="1" Height="22" Margin="3,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                            <Button x:Name="ReaderHighlightButton"
                                    Content="划线"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    ToolTipService.ToolTip="为正文中选中的文字添加划线"
                                    Click="ReaderHighlightButton_Click" />
                            <Button x:Name="ReaderAnnotateButton"
                                    Content="批注"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    ToolTipService.ToolTip="为正文中选中的文字添加笔记"
                                    Click="ReaderAnnotateButton_Click" />
                            <Button x:Name="ReaderBookmarkButton"
                                    Content="书签"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    AutomationProperties.Name="添加书签"
                                    ToolTipService.ToolTip="添加或取消当前阅读位置的书签（Ctrl+B）"
                                    Click="ReaderBookmarkButton_Click" />
                            <Rectangle Width="1" Height="22" Margin="3,0" Fill="#D5D5D1" VerticalAlignment="Center" />
                            <Button x:Name="ReaderAssistantToggleButton"
                                    Content="助手"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    ToolTipService.ToolTip="显示或隐藏阅读助手"
                                    Click="ReaderAssistantToggleButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="#FFFFFF">
                    <Grid x:Name="ReaderWebViewHost"
                          Margin="0,12,0,10"
                          Background="#FFFFFF"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="ReaderWebViewTransform" />
                        </Grid.RenderTransform>
                        <WebView2 x:Name="ReaderWebView"
                                  NavigationStarting="ReaderWebView_NavigationStarting"
                                  NavigationCompleted="ReaderWebView_NavigationCompleted" />
                    </Grid>

                    <!-- Slim floating bar shown only in zen mode; keeps the exit/close entries
                         while the normal header and footer bars are collapsed. -->
                    <Border x:Name="ReaderZenBar"
                            Margin="0,16,24,0"
                            Padding="2,2,2,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Canvas.ZIndex="30"
                            Background="#FFFFFF"
                            BorderBrush="#000000"
                            BorderThickness="1"
                            CornerRadius="0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="禅模式"
                                       Margin="10,0,2,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ReaderZenTocButton"
                                    Content="极简目录"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    ToolTipService.ToolTip="显示或隐藏极简目录"
                                    Visibility="Collapsed"
                                    Click="ReaderZenMinimalTocButton_Click" />
                            <Button x:Name="ReaderExitZenButton"
                                    Content="退出禅模式"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    ToolTipService.ToolTip="退出禅模式，恢复目录与阅读助手"
                                    Click="ReaderExitZenButton_Click" />
                            <Button x:Name="ReaderZenCloseButton"
                                    Content="×"
                                    FontSize="15"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    AutomationProperties.Name="关闭阅读器"
                                    ToolTipService.ToolTip="返回书架"
                                    Click="CloseReaderButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="ReaderFooterBar" Grid.Row="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="0,1,0,0">
                    <Grid Padding="12,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ReaderPreviousButton"
                                Content="‹"
                                FontSize="18"
                                Width="40"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                AutomationProperties.Name="上一页"
                                Click="ReaderPreviousButton_Click" />
                        <Button x:Name="ReaderNextButton"
                                Grid.Column="1"
                                Content="›"
                                FontSize="18"
                                Width="40"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                AutomationProperties.Name="下一页"
                                Click="ReaderNextButton_Click" />
                        <Slider x:Name="ReaderProgressSlider"
                                Grid.Column="2"
                                Margin="4,0"
                                MinWidth="120"
                                Minimum="1"
                                Maximum="1"
                                Value="1"
                                StepFrequency="1"
                                SnapsTo="StepValues"
                                VerticalAlignment="Center"
                                ValueChanged="ReaderProgressSlider_ValueChanged">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                            </Slider.Resources>
                        </Slider>
                        <TextBlock x:Name="ReaderChapterText"
                                   Grid.Column="3"
                                   Width="96"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ReaderPdfBottomText"
                                   Grid.Column="4"
                                   Text="PDF"
                                   Width="32"
                                   FontSize="11"
                                   Foreground="#777777"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <!-- AI conversation and persistent annotations. -->
            <Border x:Name="ReaderAssistantPanel"
                    Grid.Column="2"
                    Margin="0,38,0,0"
                    Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Long separator below the assistant header. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="3"
                               Width="1"
                               HorizontalAlignment="Left"
                               Fill="#000000"
                               IsHitTestVisible="False" />

                    <!-- The short header rule is intentionally omitted. -->
                    <Grid Padding="14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="AI 助手" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ReaderAiProviderText"
                                        Text="DeepSeek · 未配置"
                                        FontSize="9"
                                        MaxWidth="170"
                                        Foreground="#888888"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <Button x:Name="ReaderAiSettingsButton"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                    AutomationProperties.Name="配置 AI API"
                                    ToolTipService.ToolTip="配置 AI API"
                                    Click="ReaderAiSettingsButton_Click">
                                <FontIcon Glyph="&#xE713;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          VerticalAlignment="Center" />
                            </Button>
                            <Button VerticalAlignment="Center"
                                    Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                    AutomationProperties.Name="收起阅读助手"
                                    ToolTipService.ToolTip="收起阅读助手"
                                    Click="ReaderAssistantToggleButton_Click">
                                <FontIcon Glyph="&#xE76C;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Padding="12,4" ColumnSpacing="6" BorderBrush="#000000" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ReaderAiTabButton"
                                Content="AI 对话"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                Click="ReaderAiTabButton_Click" />
                        <Button x:Name="ReaderNotesTabButton"
                                Grid.Column="1"
                                Content="划线与笔记"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                Click="ReaderNotesTabButton_Click" />
                    </Grid>

                    <Grid x:Name="ReaderAiView" Grid.Row="2">
                        <ScrollViewer x:Name="ReaderAiScrollViewer"
                                      Padding="14,14,14,18"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="13">
                                <StackPanel x:Name="ReaderAiEmptyState" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#777777" />
                                    <TextBlock Text="基于当前选文和本地书籍索引对话"
                                               MaxWidth="250"
                                               FontSize="12"
                                               Foreground="#777777"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="总结本章"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderAiSummarizeChapterButton_Click" />
                                    <Button Grid.Column="1"
                                            Content="解释选中"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderAiExplainSelectionButton_Click" />
                                    <Button Grid.Row="1"
                                            Content="全书概览"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderAiSummarizeBookButton_Click" />
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Content="清空对话"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderAiClearButton_Click" />
                                </Grid>

                                <StackPanel x:Name="ReaderChatMessagesPanel" Spacing="10" />

                                <TextBlock x:Name="ReaderAiStatusText"
                                           Text="本地索引将在打开 EPUB 后自动准备"
                                           FontSize="10"
                                           Foreground="#777777"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="ReaderAiSourcesPanel" Spacing="5" Visibility="Collapsed">
                                    <TextBlock Text="本次参考" FontSize="10" Foreground="#777777" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ReaderNotesView"
                          Grid.Row="2"
                          Grid.RowSpan="2"
                          Visibility="Collapsed">
                        <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <TextBlock Text="为正文中选中的文字添加划线和笔记。批注仅保存在本机。"
                                           FontSize="11"
                                           Foreground="#6F6F6F"
                                           TextWrapping="Wrap" />
                                <Border Padding="10"
                                        Background="#FFFFFF"
                                        BorderBrush="#000000"
                                        BorderThickness="1"
                                        CornerRadius="0">
                                    <TextBlock x:Name="ReaderAnnotationSelectionText"
                                               Text="请先在正文中选择一段文字，再点击顶部“批注”。"
                                               FontSize="12"
                                               MaxLines="5"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </Border>
                                <TextBox x:Name="ReaderAnnotationNoteBox"
                                         MinHeight="76"
                                         Padding="10,8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         CornerRadius="0"
                                         BorderBrush="#000000"
                                         PlaceholderText="写下对这段文字的想法（可留空）" />
                                <Grid Margin="0,0,0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="划线颜色（淡色覆盖正文）"
                                                   FontSize="9"
                                                   Foreground="#777777" />
                                        <ComboBox x:Name="ReaderAnnotationColorBox"
                                                  SelectedIndex="0"
                                                  MinHeight="32"
                                                  FontSize="10"
                                                  CornerRadius="0"
                                                  BorderBrush="#000000"
                                                  BorderThickness="1"
                                                  AutomationProperties.Name="选择划线颜色">
                                            <ComboBoxItem Content="黑色" Tag="#000000" />
                                            <ComboBoxItem Content="黄色" Tag="#F1C40F" />
                                            <ComboBoxItem Content="蓝色" Tag="#4A90E2" />
                                            <ComboBoxItem Content="绿色" Tag="#38A169" />
                                            <ComboBoxItem Content="红色" Tag="#D95F76" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="线条样式"
                                                   FontSize="9"
                                                   Foreground="#777777" />
                                        <ComboBox x:Name="ReaderAnnotationStyleBox"
                                                  SelectedIndex="0"
                                                  MinHeight="32"
                                                  FontSize="10"
                                                  CornerRadius="0"
                                                  BorderBrush="#000000"
                                                  BorderThickness="1"
                                                  AutomationProperties.Name="选择划线样式">
                                            <ComboBoxItem Content="直线" Tag="solid" />
                                            <ComboBoxItem Content="双线" Tag="double" />
                                            <ComboBoxItem Content="虚线" Tag="dashed" />
                                            <ComboBoxItem Content="点线" Tag="dotted" />
                                            <ComboBoxItem Content="波浪线" Tag="wavy" />
                                            <ComboBoxItem Content="荧光标记（黑白反色）" Tag="marker" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Button Content="保存划线与笔记"
                                        HorizontalAlignment="Stretch"
                                        BorderThickness="1"
                                        Style="{StaticResource ReaderToolbarButtonStyle}"
                                        Click="ReaderAnnotationSaveButton_Click" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="本书批注" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="点击条目回到正文" FontSize="9" Foreground="#777777" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button x:Name="ReaderDeleteAnnotationButton"
                                            Grid.Column="1"
                                            Content="删除选中"
                                            IsEnabled="False"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderDeleteAnnotationButton_Click" />
                                </Grid>
                                <ListView x:Name="ReaderAnnotationList"
                                          MinHeight="160"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="True"
                                          SelectionChanged="ReaderAnnotationList_SelectionChanged"
                                          ItemClick="ReaderAnnotationList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="core:ReaderAnnotation">
                                            <Border Margin="0,0,0,7"
                                                    Padding="10"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#000000"
                                                    BorderThickness="1"
                                                    CornerRadius="0">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{x:Bind DisplayQuote}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               MaxLines="3"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind DisplayNote}"
                                                               FontSize="10"
                                                               Foreground="#707070"
                                                               MaxLines="3"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid Margin="0,4,0,8" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="导出 Markdown"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderExportMarkdownButton_Click" />
                                    <Button Grid.Column="1"
                                            Content="导出文本"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderExportTextButton_Click" />
                                </Grid>
                                <TextBlock x:Name="ReaderExportStatusText"
                                           FontSize="10"
                                           Foreground="#6F6F6F"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ReaderAiComposer"
                          Grid.Row="3"
                          Padding="12"
                          BorderBrush="#000000"
                          BorderThickness="0,1,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="思考深度"
                                           FontSize="9"
                                           Foreground="#777777" />
                                <ComboBox x:Name="ReaderAiReasoningDepthBox"
                                          HorizontalAlignment="Stretch"
                                          MinHeight="32"
                                          FontSize="10"
                                          CornerRadius="0"
                                          BorderBrush="#000000"
                                          BorderThickness="1"
                                          SelectionChanged="ReaderAiReasoningDepthBox_SelectionChanged"
                                          AutomationProperties.Name="选择思考深度">
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="模型"
                                           FontSize="9"
                                           Foreground="#777777" />
                                <ComboBox x:Name="ReaderAiModelSelectorBox"
                                          HorizontalAlignment="Stretch"
                                          MinHeight="32"
                                          FontSize="10"
                                          CornerRadius="0"
                                          BorderBrush="#000000"
                                          BorderThickness="1"
                                          PlaceholderText="选择模型"
                                          SelectionChanged="ReaderAiModelSelectorBox_SelectionChanged"
                                          AutomationProperties.Name="选择 AI 模型" />
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="ReaderAiQuestionBox"
                                 Grid.Row="1"
                                 MinHeight="74"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 CornerRadius="0"
                                 BorderBrush="#000000"
                                 PlaceholderText="询问这本书…（Ctrl+Enter 发送）"
                                 KeyDown="ReaderAiQuestionBox_KeyDown" />
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="仅发送相关片段，不上传整本书"
                                       FontSize="9"
                                       Foreground="#888888"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ReaderAiSendButton"
                                    Grid.Column="1"
                                    Content="发送"
                                    MinWidth="66"
                                    BorderThickness="1"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    Click="ReaderAiSendButton_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="ReaderAiSettingsOverlay"
                  Grid.ColumnSpan="3"
                  Margin="0,38,0,0"
                  Canvas.ZIndex="80"
                  Background="#66000000"
                  Visibility="Collapsed">
                <Border Width="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FFFFFF"
                        BorderBrush="#000000"
                        BorderThickness="2"
                        CornerRadius="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Padding="22,20" Spacing="12">
                            <TextBlock Text="AI API 设置" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="API Key 使用 Windows 当前用户加密后保存在本机。DeepSeek 使用 Chat Completions；OpenAI 使用 Responses API。"
                                       FontSize="11"
                                       Foreground="#666666"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="服务" FontSize="11" />
                                <ComboBox x:Name="ReaderAiProviderBox"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="0"
                                          BorderBrush="#000000"
                                          BorderThickness="1"
                                          SelectionChanged="ReaderAiProviderBox_SelectionChanged">
                                    <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                    <ComboBoxItem Content="OpenAI" Tag="openai" />
                                    <ComboBoxItem Content="自定义 OpenAI-compatible" Tag="custom" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Base URL" FontSize="11" />
                                <TextBox x:Name="ReaderAiBaseUrlBox" PlaceholderText="https://api.deepseek.com" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="模型" FontSize="11" />
                                <TextBox x:Name="ReaderAiModelBox" PlaceholderText="deepseek-v4-flash" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="API Key" FontSize="11" />
                                <PasswordBox x:Name="ReaderAiApiKeyBox"
                                             CornerRadius="0"
                                             BorderBrush="#000000"
                                             BorderThickness="1"
                                             PlaceholderText="输入 API Key" />
                            </StackPanel>
                            <TextBlock Text="自定义服务可填写本地模型或其他兼容接口；Base URL 应填写到 /v1 或服务根地址。"
                                       FontSize="10"
                                       Foreground="#777777"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1" Padding="22,14,22,20" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReaderAiSettingsStatusText"
                                       FontSize="10"
                                       Foreground="#777777"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1"
                                    Content="取消"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Click="ReaderAiSettingsCancelButton_Click" />
                            <Button Grid.Column="2"
                                    Content="保存"
                                    Click="ReaderAiSettingsSaveButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Reading layout settings (per book). Hosted in a Popup because the
                 WebView2 HWND island would otherwise cover the panel. -->
            <Grid x:Name="ReaderLayoutSettingsOverlay"
                  Grid.ColumnSpan="3"
                  Margin="0,38,0,0"
                  Canvas.ZIndex="85"
                  Background="#66000000"
                  Visibility="Collapsed">
                <Border Width="580"
                        MaxHeight="760"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FFFFFF"
                        BorderBrush="#000000"
                        BorderThickness="2"
                        CornerRadius="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Padding="22,20" Spacing="12">
                                <TextBlock Text="阅读排版设置" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="这些设置只对当前这本书生效，并在下次打开时自动恢复。"
                                           FontSize="11"
                                           Foreground="#666666"
                                           TextWrapping="Wrap" />
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="字号" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderFontScaleValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderFontScaleSlider"
                                            Minimum="0.8"
                                            Maximum="1.8"
                                            StepFrequency="0.1"
                                            Value="1.0"
                                            ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="行高" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderLineHeightValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderLineHeightSlider"
                                            Minimum="1.3"
                                            Maximum="2.6"
                                            StepFrequency="0.05"
                                            Value="1.88"
                                            ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="正文最大宽度" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderMaxWidthValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderMaxWidthSlider"
                                            Minimum="480"
                                            Maximum="1200"
                                            StepFrequency="20"
                                            Value="800"
                                            ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="左右边距" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderBodyPaddingValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderBodyPaddingSlider"
                                            Minimum="24"
                                            Maximum="160"
                                            StepFrequency="8"
                                            Value="68"
                                            ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="正文字体（CJK 覆盖）" FontSize="11" />
                                    <ComboBox x:Name="ReaderFontFamilyBox"
                                              HorizontalAlignment="Stretch"
                                              CornerRadius="0"
                                              BorderBrush="#000000"
                                              BorderThickness="1"
                                              SelectionChanged="ReaderFontFamilyBox_SelectionChanged">
                                        <ComboBoxItem Content="京华老宋体" Tag="京华老宋体" />
                                        <ComboBoxItem Content="微软雅黑 Microsoft YaHei UI" Tag="Microsoft YaHei UI" />
                                        <ComboBoxItem Content="宋体 SimSun" Tag="SimSun" />
                                        <ComboBoxItem Content="黑体 SimHei" Tag="SimHei" />
                                        <ComboBoxItem Content="楷体 KaiTi" Tag="KaiTi" />
                                        <ComboBoxItem Content="等线 DengXian" Tag="DengXian" />
                                        <ComboBoxItem Content="思源宋体 / Noto Serif CJK" Tag="Source Han Serif SC, Noto Serif CJK SC" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="ReaderVerticalWritingCheck"
                                          Content="竖排排版（滚动与分页模式）"
                                          FontSize="12"
                                          Click="ReaderVerticalWritingCheck_Click" />
                                <TextBlock x:Name="ReaderLayoutSettingsStatusText"
                                           FontSize="10"
                                           Foreground="#777777"
                                           TextWrapping="Wrap" />
                                <Button Content="恢复默认值"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="ReaderLayoutResetButton_Click" />
                            </StackPanel>
                            <Grid Grid.Row="1" Padding="22,14,22,20">
                                <Button Content="关闭"
                                        Style="{StaticResource QuietButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Click="ReaderLayoutSettingsCloseButton_Click" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Whole-book search panel. It occupies the original TOC column so
                 the search results stay beside the正文 instead of floating over it. -->
            <Border x:Name="ReaderSearchPanel"
                    Width="360"
                    Grid.Column="0"
                    Margin="0,38,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="1"
                    CornerRadius="0"
                    Canvas.ZIndex="90"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="10,8" ColumnSpacing="6" BorderBrush="#000000" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReaderSearchBox"
                                 Height="32"
                                 Padding="9,5"
                                 PlaceholderText="搜索整本书…"
                                 KeyDown="ReaderSearchBox_KeyDown" />
                        <Button Grid.Column="1"
                                Content="搜索"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                BorderThickness="1"
                                Click="ReaderSearchButton_Click" />
                        <Button Grid.Column="2"
                                Content="×"
                                FontSize="14"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                AutomationProperties.Name="关闭搜索"
                                Click="CloseReaderSearchButton_Click" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView x:Name="ReaderSearchResultList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="ReaderSearchResultList_ItemClick"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:BookContentChunk">
                                    <Border Margin="0,0,0,6"
                                            Padding="10"
                                            Background="#FFFFFF"
                                            BorderBrush="#000000"
                                            BorderThickness="1"
                                            CornerRadius="0">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind ChapterTitle}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Content}"
                                                       FontSize="10"
                                                       Foreground="#5A5A5A"
                                                       MaxLines="4"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ReaderSearchStatusText"
                                   Margin="14"
                                   TextAlignment="Center"
                                   FontSize="11"
                                   Foreground="#5E5E5E"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="ReaderSearchCountText"
                               Grid.Row="2"
                               Margin="12,8"
                               FontSize="10"
                               Foreground="#5E5E5E" />
                </Grid>
            </Border>

            <!-- Text-selection quick action bar (monochrome). Hosted in a Popup
                 positioned above the current selection in the WebView. -->
            <Border x:Name="ReaderSelectionBar"
                    Padding="3"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="1"
                    CornerRadius="0"
                    Canvas.ZIndex="90"
                    Visibility="Collapsed">
                <Border.Resources>
                    <Style x:Key="ReaderSelectionSeparatorStyle" TargetType="Rectangle">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Height" Value="18" />
                        <Setter Property="Fill" Value="#D5D5D1" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="ReaderSelectionActionStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                        <Setter Property="MinWidth" Value="52" />
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Padding" Value="8,3" />
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Setter Property="Foreground" Value="#000000" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SelectionActionBackground"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionActionBackground" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#F2F2F2" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionActionContent" Storyboard.TargetProperty="Foreground">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionActionBackground" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#D9D9D9" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter x:Name="SelectionActionContent"
                                                          Content="{TemplateBinding Content}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="ReaderSelectionCopyButton"
                            Content="复制"
                            Style="{StaticResource ReaderSelectionActionStyle}"
                            Click="ReaderSelectionCopyButton_Click" />
                    <Rectangle Style="{StaticResource ReaderSelectionSeparatorStyle}" />
                    <Button x:Name="ReaderSelectionHighlightButton"
                            Content="划线 ▾"
                            Style="{StaticResource ReaderSelectionActionStyle}">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="直线  ───" Tag="solid" Click="ReaderSelectionHighlightStyle_Click" />
                                <MenuFlyoutItem Text="双线  ═══" Tag="double" Click="ReaderSelectionHighlightStyle_Click" />
                                <MenuFlyoutItem Text="虚线  ┄┄┄" Tag="dashed" Click="ReaderSelectionHighlightStyle_Click" />
                                <MenuFlyoutItem Text="点线  ···" Tag="dotted" Click="ReaderSelectionHighlightStyle_Click" />
                                <MenuFlyoutItem Text="波浪线  ﹏﹏" Tag="wavy" Click="ReaderSelectionHighlightStyle_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="荧光标记（黑白反色）  ▰" Tag="marker" Click="ReaderSelectionHighlightStyle_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Rectangle Style="{StaticResource ReaderSelectionSeparatorStyle}" />
                    <Button x:Name="ReaderSelectionAnnotateButton"
                            Content="批注"
                            Style="{StaticResource ReaderSelectionActionStyle}"
                            Click="ReaderSelectionAnnotateButton_Click" />
                    <Rectangle Style="{StaticResource ReaderSelectionSeparatorStyle}" />
                    <Button x:Name="ReaderSelectionAiExplainButton"
                            Content="AI 解释"
                            Style="{StaticResource ReaderSelectionActionStyle}"
                            Click="ReaderSelectionAiExplainButton_Click" />
                    <Rectangle Style="{StaticResource ReaderSelectionSeparatorStyle}" />
                    <Button x:Name="ReaderSelectionSearchButton"
                             Content="搜索"
                             Style="{StaticResource ReaderSelectionActionStyle}"
                             Click="ReaderSelectionSearchButton_Click" />
                    <Rectangle Style="{StaticResource ReaderSelectionSeparatorStyle}" />
                    <Button x:Name="ReaderSelectionDictionaryButton"
                            Content="词典"
                            Style="{StaticResource ReaderSelectionActionStyle}"
                            Click="ReaderSelectionDictionaryButton_Click" />
                </StackPanel>
            </Border>

            <!-- Footnote preview hosted in a Popup so it stays above the WebView2
                 composition island. It is deliberately monochrome and square. -->
            <Border x:Name="ReaderFootnotePopup"
                    Width="360"
                    MaxHeight="260"
                    Padding="12,10"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    CornerRadius="0"
                    Canvas.ZIndex="95"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <ScrollViewer MaxHeight="236"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReaderFootnoteText"
                               Foreground="#000000"
                               FontSize="12"
                               LineHeight="20"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Fully custom monochrome device confirmation; avoids WinUI popup theming. -->
        <Grid x:Name="DevicePromptOverlay"
              Grid.ColumnSpan="3"
              Canvas.ZIndex="100"
              Background="#66000000"
              Visibility="Collapsed"
              IsTabStop="True"
              KeyDown="DevicePromptOverlay_KeyDown">
            <Border Width="560"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="28,24,28,22" Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10" Height="24" Fill="#000000" />
                            <TextBlock x:Name="DevicePromptTitleText"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="DevicePromptMessageText"
                                   FontSize="15"
                                   LineHeight="23"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1"
                          Padding="28,18,28,22"
                          Background="#FFFFFF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DevicePromptPrimaryButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="DevicePromptPrimaryButton_Click" />
                        <Button x:Name="DevicePromptCancelButton"
                                Grid.Column="2"
                                Content="取消"
                                Style="{StaticResource QuietButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="DevicePromptCancelButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="BookConversionPopup"
                Grid.ColumnSpan="3"
                Width="390"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,30"
                Padding="14"
                Background="#FFFFFF"
                BorderBrush="#000000"
                BorderThickness="2"
                CornerRadius="0"
                Canvas.ZIndex="80"
                Visibility="Collapsed"
                Tapped="BookConversionPopup_Tapped">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="BookConversionPopupTitleText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BookConversionPopupFormatText"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <Button x:Name="BookConversionBackgroundButton"
                                Content="后台"
                                Padding="8,4"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BookConversionBackgroundButton_Click" />
                        <Button x:Name="BookConversionCancelButton"
                                Content="取消"
                                Padding="8,4"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BookConversionCancelButton_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:RectangularProgressBar x:Name="BookConversionPopupProgress"
                                                  Height="10"
                                                  Margin="0,0,8,0"
                                                  Minimum="0"
                                                  Maximum="100" />
                    <TextBlock x:Name="BookConversionPopupPercentageText"
                               Grid.Column="1"
                               Foreground="#000000"
                               FontSize="10"
                               FontWeight="SemiBold"
                               MinWidth="28"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="BookConversionPopupMessageText"
                           Grid.Row="2"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border x:Name="TransferToast"
                Grid.ColumnSpan="3"
                Width="350"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,30"
                Padding="14"
                Background="#FFFFFF"
                BorderBrush="#000000"
                BorderThickness="2"
                CornerRadius="0"
                Canvas.ZIndex="90"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel Spacing="7">
                <TextBlock x:Name="TransferToastTitleText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TransferToastMessageText"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="11"
                           TextWrapping="Wrap" />
                <ProgressBar x:Name="TransferToastProgress"
                             Height="5"
                             Minimum="0"
                             Maximum="100"
                             Foreground="#000000"
                             Background="#D9D9D9"
                             Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
