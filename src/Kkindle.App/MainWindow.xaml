                          Grid.Column="1"
                          Width="110"
                          Height="38"
                          CornerRadius="0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="全部格式" Tag="" />
                    <ComboBoxItem Content="EPUB" Tag="epub" />
                    <ComboBoxItem Content="PDF" Tag="pdf" />
                    <ComboBoxItem Content="MOBI" Tag="mobi" />
                    <ComboBoxItem Content="AZW3" Tag="azw3" />
                    <ComboBoxItem Content="FB2" Tag="fb2" />
                    <ComboBoxItem Content="DJVU" Tag="djvu" />
                    <ComboBoxItem Content="TXT" Tag="txt" />
                </ComboBox>
                <ComboBox x:Name="ZLibraryLanguageBox"
                          Grid.Column="2"
                          Width="110"
                          Height="38"
                          CornerRadius="0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="全部语言" Tag="" />
                    <ComboBoxItem Content="中文" Tag="chinese" />
                    <ComboBoxItem Content="英文" Tag="english" />
                    <ComboBoxItem Content="日文" Tag="japanese" />
                    <ComboBoxItem Content="韩文" Tag="korean" />
                    <ComboBoxItem Content="俄文" Tag="russian" />
                    <ComboBoxItem Content="德文" Tag="german" />
                    <ComboBoxItem Content="法文" Tag="french" />
                    <ComboBoxItem Content="西班牙文" Tag="spanish" />
                </ComboBox>
                <Button x:Name="ZLibrarySearchButton"
                        Grid.Column="3"
                        Width="38"
                        Height="38"
                        Padding="0"
                        AutomationProperties.Name="搜索"
                        ToolTipService.ToolTip="搜索"
                        Click="ZLibrarySearchButton_Click">
                    <FontIcon Glyph="&#xE721;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="14" />
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListView x:Name="ZLibraryBookList"
                      ItemsSource="{x:Bind ZLibraryBooks}"
                      SelectionMode="Single"
                      SelectionChanged="ZLibraryBookList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"
                           BasedOn="{StaticResource OutlinedListItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,3" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ZLibraryBookCardViewModel">
                        <Grid Padding="10,10,22,10" MinHeight="112" ColumnSpacing="14" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="66"
                                    Height="92"
                                    VerticalAlignment="Center"
                                    Background="#D9D9D9"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0">
                                <Grid Background="Transparent">
                                    <TextBlock Text="BOOK"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#5A5A5A"
                                               FontSize="10"
                                               CharacterSpacing="120" />
                                    <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{x:Bind Title}"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2" />
                                <TextBlock Text="{x:Bind Authors}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind PublicationLabel}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind InfoLabel}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ExtraInfoLabel}"
                                           Foreground="#777777"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Button Width="110"
                                        Height="38"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.Name="下载"
                                        ToolTipService.ToolTip="下载"
                                        Tag="{x:Bind}"
                                        IsEnabled="{x:Bind IsNotDownloading, Mode=OneWay}"
                                        Click="ZLibraryDownloadButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter Content="{TemplateBinding Content}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <local:TetrisDownloadVisual IsDownloading="{x:Bind IsDownloading, Mode=OneWay}"
                                                                IsCompleted="{x:Bind HasDownloadCompleted, Mode=OneWay}"
                                                                Value="{x:Bind DownloadProgress, Mode=OneWay}" />
                                </Button>
                                <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           MaxWidth="180"
                                           MaxLines="2"
                                           Margin="0,0,0,2"
                                           FontSize="10"
                                           Foreground="#777777"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>

                <Border x:Name="ZLibraryDetailPanel"
                        Grid.Column="1"
                        Width="350"
                        Margin="16,0,0,0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,12,10,10">
                            <TextBlock Text="书籍详情"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Style="{StaticResource QuietButtonStyle}"
                                    AutomationProperties.Name="关闭书籍详情"
                                    Click="ZLibraryDetailCloseButton_Click">
                                <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="16,4,16,16" Spacing="10">
                                <Border Width="112"
                                        Height="156"
                                        HorizontalAlignment="Left"
                                        Background="#D9D9D9"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="BOOK"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#5A5A5A"
                                                   FontSize="11"
                                                   CharacterSpacing="120" />
                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Authors}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DetailMetadataLabel}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <Grid Margin="0,4,0,0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="卷号" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding VolumeLabel}" FontSize="11" />
                                </Grid>
                                <TextBlock Text="简介" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding DetailDescription}"
                                           Foreground="#555555"
                                           FontSize="11"
                                           LineHeight="18"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Padding="16,12,16,16" Spacing="7">
                            <Button Content="官网详情"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding CanOpenOfficialDetail}"
                                    Click="ZLibraryOfficialDetailButton_Click" />
                            <Button Content="在线阅读"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource QuietButtonStyle}"
                                    IsEnabled="{Binding CanReadOnline}"
                                    Click="ZLibraryReadOnlineButton_Click" />
                            <Button Content="发送到 Kindle 邮箱"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource QuietButtonStyle}"
                                    IsEnabled="{Binding CanSendToEmailNow}"
                                    Click="ZLibrarySendEmailButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="ZLibraryResultText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedInkBrush}"
                           Text="输入书名或作者开始搜索。" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="ZLibraryPrevPageButton"
                            Content="上一页"
                            Style="{StaticResource QuietButtonStyle}"
                            IsEnabled="False"
                            Click="ZLibraryPrevPageButton_Click" />
                    <TextBlock x:Name="ZLibraryPageText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}" />
                    <Button x:Name="ZLibraryNextPageButton"
                            Content="下一页"
                            Style="{StaticResource QuietButtonStyle}"
                            IsEnabled="False"
                            Click="ZLibraryNextPageButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- App settings and portable data migration. -->
        <Grid x:Name="SettingsPane"
              Grid.Row="0"
              Grid.Column="1"
              Padding="30,24,30,18"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style x:Key="SettingsCategoryButtonStyle" TargetType="Button">
                    <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Height" Value="38" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="Foreground" Value="#5A5A5A" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CategoryBackground"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CategoryBackground" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="#F2F2F2" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CategoryBackground" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="#D9D9D9" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CategoryContent" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle x:Name="CategoryIndicator"
                                                   Width="3"
                                                   Height="18"
                                                   Fill="{TemplateBinding BorderBrush}"
                                                   VerticalAlignment="Center" />
                                        <ContentPresenter x:Name="CategoryContent"
                                                          Grid.Column="1"
                                                          Margin="14,0,8,0"
                                                          Content="{TemplateBinding Content}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <StackPanel Spacing="3">
                <TextBlock Text="基础设置"
                           Foreground="{StaticResource InkBrush}"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="管理本地数据、阅读偏好与设备设置。"
                           Foreground="{StaticResource MutedInkBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,28,0,0" ColumnSpacing="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.RowSpan="2" Spacing="2">
                    <TextBlock Text="分类"
                               FontSize="10"
                               Foreground="{StaticResource MutedInkBrush}"
                               Margin="2,0,0,6" />
                    <Button x:Name="SettingsGeneralButton"
                            Content="常规"
                            Tag="General"
                            Style="{StaticResource SettingsCategoryButtonStyle}"
                            Click="SettingsCategoryButton_Click" />
                    <Button x:Name="SettingsLibraryButton"
                            Content="书库"
                            Tag="Library"
                            Style="{StaticResource SettingsCategoryButtonStyle}"
                            Click="SettingsCategoryButton_Click" />
                    <Button x:Name="SettingsKindleButton"
                            Content="Kindle"
                            Tag="Kindle"
                            Style="{StaticResource SettingsCategoryButtonStyle}"
                            Click="SettingsCategoryButton_Click" />
                    <Button x:Name="SettingsReadingButton"
                            Content="阅读"
                            Tag="Reading"
                            Style="{StaticResource SettingsCategoryButtonStyle}"
                            Click="SettingsCategoryButton_Click" />
                    <Button x:Name="SettingsBackupButton"
                            Content="备份"
                            Tag="Backup"
                            Style="{StaticResource SettingsCategoryButtonStyle}"
                            Click="SettingsCategoryButton_Click" />
                    <Button x:Name="SettingsAboutButton"
                            Content="关于"
                            Tag="About"
                            Style="{StaticResource SettingsCategoryButtonStyle}"
                            Click="SettingsCategoryButton_Click" />
                </StackPanel>

                <ScrollViewer x:Name="SettingsScrollViewer"
                              Grid.Column="1"
                              HorizontalContentAlignment="Left"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                    <Border x:Name="SettingsBackupSection"
                            Visibility="Collapsed"
                            Padding="18"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="数据备份与迁移" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="一键打包书籍文件、封面、书库信息和阅读记录，生成 .kkindle 备份文件。导入备份会覆盖当前书库；导入前会自动校验备份内容。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="AI API Key 和 Kindle 邮箱密码不会导出；导入后保留当前设备已有的密钥，没有密钥时需要重新填写。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                            <Grid ColumnSpacing="24" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启动时自动备份（每日）"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               ToolTipService.ToolTip="开启后，应用启动时每天自动创建一次备份，并按保留数量清理旧备份。" />
                                    <ToggleSwitch x:Name="AutoBackupCheck"
                                                  Grid.Column="1"
                                                  OnContent="开"
                                                  OffContent="关"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="自动备份保留数量" FontSize="11" />
                                    <NumberBox x:Name="AutoBackupRetentionBox"
                                               Minimum="1"
                                               Maximum="30"
                                               Value="5"
                                               SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="设置自动备份最多保留的文件数量，超出后删除最旧备份。"
                                               AutomationProperties.HelpText="设置自动备份最多保留的文件数量，超出后删除最旧备份。" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="导出备份"
                                        ToolTipService.ToolTip="将书库、封面、设置和阅读记录导出为 Kkindle 备份文件；密码与 API Key 不会导出。"
                                        AutomationProperties.HelpText="将书库、封面、设置和阅读记录导出为 Kkindle 备份文件；密码与 API Key 不会导出。"
                                        Click="ExportBackupButton_Click" />
                                <Button Content="导入备份"
                                        Style="{StaticResource QuietButtonStyle}"
                                        ToolTipService.ToolTip="从 Kkindle 备份文件恢复书库、封面、设置和阅读记录。"
                                        AutomationProperties.HelpText="从 Kkindle 备份文件恢复书库、封面、设置和阅读记录。"
                                        Click="ImportBackupButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="SettingsBackupStatusText"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsGeneralSection"
                            Padding="18"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="常规" FontSize="18" FontWeight="SemiBold" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="默认打开格式" FontSize="11" />
                                <ComboBox x:Name="PreferredOpenFormatBox"
                                          CornerRadius="0"
                                          ToolTipService.ToolTip="选择打开书籍时优先使用的文件格式。"
                                          AutomationProperties.HelpText="选择打开书籍时优先使用的文件格式。">
                                    <ComboBoxItem Content="EPUB" Tag="epub" />
                                    <ComboBoxItem Content="PDF" Tag="pdf" />
                                    <ComboBoxItem Content="AZW3" Tag="azw3" />
                                    <ComboBoxItem Content="MOBI（转换为 EPUB）" Tag="mobi" />
                                </ComboBox>
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="启用 AI 阅读助手"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           ToolTipService.ToolTip="允许在阅读器中使用已配置的 AI 服务进行问答和辅助阅读。" />
                                <ToggleSwitch x:Name="AiEnabledCheck"
                                              Grid.Column="1"
                                              OnContent="开"
                                              OffContent="关"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="允许网络功能"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           ToolTipService.ToolTip="允许 AI、在线书库、联网元数据和邮件发送等功能访问网络。" />
                                <ToggleSwitch x:Name="NetworkEnabledCheck"
                                              Grid.Column="1"
                                              OnContent="开"
                                              OffContent="关"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="收藏夹互斥"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           ToolTipService.ToolTip="开启后一本书只能属于一个收藏夹：加入新收藏夹时会自动从其他收藏夹移出；关闭后一本书可同时属于多个收藏夹。" />
                                <ToggleSwitch x:Name="CollectionsMutuallyExclusiveCheck"
                                              Grid.Column="1"
                                              OnContent="开"
                                              OffContent="关"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsLibrarySection"
                            Visibility="Collapsed"
                            Padding="18"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="书库" FontSize="18" FontWeight="SemiBold" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="Calibre ebook-convert 路径" FontSize="11" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="CalibrePathBox"
                                             PlaceholderText="留空时自动查找"
                                             ToolTipService.ToolTip="指定 Calibre 的 ebook-convert.exe；留空时由 Kkindle 自动查找。"
                                             AutomationProperties.HelpText="指定 Calibre 的 ebook-convert.exe；留空时由 Kkindle 自动查找。" />
                                    <Button Grid.Column="1"
                                            Content="浏览"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="BrowseCalibreButton_Click"
                                            ToolTipService.ToolTip="选择 Calibre 的 ebook-convert.exe。"
                                            AutomationProperties.HelpText="选择 Calibre 的 ebook-convert.exe。" />
                                </Grid>
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="导入后补齐 EPUB 与 AZW3"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           ToolTipService.ToolTip="开启后导入完成时按书籍现有格式补齐 EPUB 与 AZW3（默认关闭）；导入文件夹时会先弹出列表，可逐本选择是否补齐，默认全部补齐。" />
                                <ToggleSwitch x:Name="AutoGenerateReaderFormatsCheck"
                                              Grid.Column="1"
                                              OnContent="开"
                                              OffContent="关"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="比较 Kindle 与电脑书库"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           ToolTipService.ToolTip="开启后比较两个书库，并在书籍封面上显示存在位置图标；关闭后隐藏图标。" />
                                <ToggleSwitch x:Name="CompareKindleLibraryCheck"
                                              Grid.Column="1"
                                              OnContent="开"
                                              OffContent="关"
                                              IsOn="True"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="网格画廊显示"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           ToolTipService.ToolTip="开启后网格视图中的书籍只显示封面图片，不显示书名与作者等文字；其余功能保持一致。" />
                                <ToggleSwitch x:Name="GridGalleryDisplayCheck"
                                              Grid.Column="1"
                                              OnContent="开"
                                              OffContent="关"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsKindleSection"
                            Visibility="Collapsed"
                            Padding="18"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Kindle" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="发现 Kindle 后自动连接"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           ToolTipService.ToolTip="检测到 Kindle 后直接连接并读取设备内容，不再显示连接确认。" />
                                <ToggleSwitch x:Name="AutoConnectDeviceCheck"
                                              Grid.Column="1"
                                              OnContent="开"
                                              OffContent="关"
                                              IsOn="True"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Height="1" Fill="#E2E2DE" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="邮件与账号" FontSize="13" FontWeight="SemiBold" />
                                <Button Content="Kindle 邮箱设置"
                                        Style="{StaticResource QuietButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="KindleEmailSettingsButton_Click" />
                                <Button Content="Z-Library 账号设置"
                                        Style="{StaticResource QuietButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="ZLibraryAccountButton_Click" />
                                <Button Content="AI 助手设置"
                                        Style="{StaticResource QuietButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="ReaderAiSettingsButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SettingsReadingSection"
                                Spacing="16"
                                Visibility="Collapsed">
                        <Border Padding="18"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="默认阅读排版" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="这些设置会作为新打开书籍的默认排版，单本书可在阅读器中单独调整。"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="DefaultFontScaleBox" Header="字号比例" Minimum="0.8" Maximum="1.8" SmallChange="0.1" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="设置新打开书籍的默认正文字号比例。" AutomationProperties.HelpText="设置新打开书籍的默认正文字号比例。" />
                                    <NumberBox x:Name="DefaultLineHeightBox" Grid.Column="1" Header="行高" Minimum="1.3" Maximum="2.6" SmallChange="0.05" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="设置新打开书籍的默认正文行高。" AutomationProperties.HelpText="设置新打开书籍的默认正文行高。" />
                                    <NumberBox x:Name="DefaultMaxWidthBox" Grid.Column="2" Header="正文宽度" Minimum="480" Maximum="1200" SmallChange="20" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="设置新打开书籍的默认正文最大宽度。" AutomationProperties.HelpText="设置新打开书籍的默认正文最大宽度。" />
                                    <NumberBox x:Name="DefaultBodyPaddingBox" Grid.Column="3" Header="页边距" Minimum="24" Maximum="160" SmallChange="8" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="设置新打开书籍正文两侧的默认留白。" AutomationProperties.HelpText="设置新打开书籍正文两侧的默认留白。" />
                                </Grid>
                                <ComboBox x:Name="DefaultFontFamilyBox"
                                          Header="默认正文字体"
                                          CornerRadius="0"
                                          ToolTipService.ToolTip="选择新打开书籍使用的默认正文字体。"
                                          AutomationProperties.HelpText="选择新打开书籍使用的默认正文字体。">
                                    <ComboBoxItem Content="京华老宋体" Tag="京华老宋体" />
                                    <ComboBoxItem Content="微软雅黑 Microsoft YaHei UI" Tag="Microsoft YaHei UI" />
                                    <ComboBoxItem Content="宋体 SimSun" Tag="SimSun" />
                                    <ComboBoxItem Content="黑体 SimHei" Tag="SimHei" />
                                    <ComboBoxItem Content="楷体 KaiTi" Tag="KaiTi" />
                                    <ComboBoxItem Content="等线 DengXian" Tag="DengXian" />
                                    <ComboBoxItem Content="思源宋体 / Noto Serif CJK" Tag="Source Han Serif SC, Noto Serif CJK SC" />
                                </ComboBox>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="新书默认使用竖排"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               ToolTipService.ToolTip="开启后，新打开的书籍默认使用从右向左的竖排版式。" />
                                    <ToggleSwitch x:Name="DefaultVerticalWritingCheck"
                                                  Grid.Column="1"
                                                  OnContent="开"
                                                  OffContent="关"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FontManagementCard"
                                Padding="18"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Kreader 本地字体" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="导入 TTF、OTF、WOFF 或 WOFF2 字体；导入后可在每本书的阅读排版设置中选择。请自行确认字体许可。" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                <ListView x:Name="ManagedFontList" MaxHeight="150" DisplayMemberPath="DisplayName" SelectionMode="Single" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="导入字体" Click="ImportFontButton_Click" />
                                    <Button Content="移除所选" Style="{StaticResource QuietButtonStyle}" Click="RemoveFontButton_Click" />
                                    <TextBlock x:Name="FontManagementStatusText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DictionaryManagementCard"
                                Padding="18"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Kreader 本地词典" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="支持 UTF-8 文本词典，每行使用“词条 + Tab + 释义”或“词条=释义”。阅读时选中文字可直接查词。" FontSize="11" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                <ListView x:Name="ManagedDictionaryList" MaxHeight="150" DisplayMemberPath="Name" SelectionMode="Single" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="导入词典" Click="ImportDictionaryButton_Click" />
                                    <Button Content="移除所选" Style="{StaticResource QuietButtonStyle}" Click="RemoveDictionaryButton_Click" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="DictionaryTestBox" PlaceholderText="测试查询" KeyDown="DictionaryTestBox_KeyDown" />
                                    <Button Grid.Column="1" Content="查询" Click="DictionaryTestButton_Click" />
                                </Grid>
                                <TextBlock x:Name="DictionaryResultText" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SettingsAboutSection"
                                Spacing="16"
                                Visibility="Collapsed">
                        <Border Padding="18"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="本地数据目录" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="SettingsDataPathText"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="书籍和阅读记录保存在本机；备份包可以复制到其他 Windows 设备使用。"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="打开数据目录" Style="{StaticResource QuietButtonStyle}" Click="OpenDataDirectoryButton_Click" />
                                    <Button Content="迁移数据目录" Style="{StaticResource QuietButtonStyle}" Click="MigrateDataDirectoryButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Padding="18"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="开发者" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                        <TextBlock Text="kingstacker" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="AboutVersionText"
                                           Text="版本"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedInkBrush}" />

                                <Rectangle Height="1" Fill="#E2E2DE" />

                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center">
                                        <!-- Minimal black-and-white cat: outline, eyes and nose only. -->
                                        <Grid Width="32" Height="30">
                                            <Polygon Points="4,11 6,2 13,8"
                                                     Fill="#FFFFFF"
                                                     Stroke="#000000"
                                                     StrokeThickness="1.5" />
                                            <Polygon Points="19,8 26,2 28,11"
                                                     Fill="#FFFFFF"
                                                     Stroke="#000000"
                                                     StrokeThickness="1.5" />
                                            <Ellipse Margin="3,6,3,1"
                                                     Fill="#FFFFFF"
                                                     Stroke="#000000"
                                                     StrokeThickness="1.5" />
                                            <Ellipse Width="2.5" Height="3"
                                                     Margin="9,14,0,0"
                                                     Fill="#000000"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top" />
                                            <Ellipse Width="2.5" Height="3"
                                                     Margin="0,14,9,0"
                                                     Fill="#000000"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Top" />
                                            <Polygon Points="14,20 18,20 16,22.5" Fill="#000000" />
                                        </Grid>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="请我喝杯咖啡" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="感谢你的支持" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="88"
                                            Height="88"
                                            Background="#FFFFFF"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="二维码预留"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,14,0,0"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ApplicationSettingsStatusText"
                               FontSize="11"
                               Foreground="{StaticResource MutedInkBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="保存应用设置"
                            Click="SaveApplicationSettingsButton_Click"
                            ToolTipService.ToolTip="保存所有设置页中的选项和默认阅读排版设置。"
                            AutomationProperties.HelpText="保存所有设置页中的选项和默认阅读排版设置。" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Kindle email settings as a right-side panel (inline, not a pop-up). The password is encrypted by the local settings store. -->
        <Border x:Name="KindleEmailSettingsPane"
                Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,38,0,0"
                      Padding="20,12,10,12"
                      BorderBrush="#EEEEEA"
                      BorderThickness="0,0,0,1">
                    <TextBlock Text="Kindle 邮箱设置"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Style="{StaticResource QuietButtonStyle}"
                            AutomationProperties.Name="关闭 Kindle 邮箱设置"
                            Click="KindleEmailSettingsCancelButton_Click">
                        <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="20,16,20,14"
                                Spacing="12"
                                MaxWidth="640"
                                HorizontalAlignment="Left">
                        <TextBlock Text="通过 SMTP 将 EPUB 或 PDF 发送到你的 Kindle 个人文档邮箱。请把 Kindle 收件地址加入发件邮箱的信任列表；密码建议使用应用专用密码。"
                                   FontSize="11"
                                   Foreground="#666666"
                                   TextWrapping="Wrap" />
                        <StackPanel Spacing="5">
                            <TextBlock Text="Kindle 收件邮箱" FontSize="11" />
                            <TextBox x:Name="KindleEmailRecipientBox"
                                     PlaceholderText="例如 name@kindle.com" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="发件邮箱" FontSize="11" />
                            <TextBox x:Name="KindleEmailSenderBox"
                                     PlaceholderText="例如 you@example.com" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="SMTP 服务器" FontSize="11" />
                                <TextBox x:Name="KindleEmailSmtpHostBox"
                                         PlaceholderText="smtp.example.com" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="端口" FontSize="11" />
                                <TextBox x:Name="KindleEmailSmtpPortBox"
                                         Text="587"
                                         PlaceholderText="587" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="5">
                            <TextBlock Text="SMTP 用户名" FontSize="11" />
                            <TextBox x:Name="KindleEmailUsernameBox" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="SMTP 密码 / 应用专用密码" FontSize="11" />
                            <PasswordBox x:Name="KindleEmailPasswordBox"
                                         PlaceholderText="输入密码或应用专用密码" />
                        </StackPanel>
                        <CheckBox x:Name="KindleEmailSslCheck"
                                  Content="使用 SSL/TLS"
                                  IsChecked="True" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2"
                      Padding="20,12,20,20"
                      BorderBrush="#EEEEEA"
                      BorderThickness="0,1,0,0"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KindleEmailSettingsStatusText"
                               FontSize="10"
                               Foreground="#777777"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="取消"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="KindleEmailSettingsCancelButton_Click" />
                    <Button Grid.Column="2"
                            Content="保存"
                            Click="KindleEmailSettingsSaveButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- Z-Library account settings as a right-side panel (inline, not a pop-up). The password is encrypted by the local settings store. -->
        <Border x:Name="ZLibraryAccountPane"
                Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,38,0,0"
                      Padding="20,12,10,12"
                      BorderBrush="#EEEEEA"
                      BorderThickness="0,0,0,1">
                    <TextBlock Text="Z-Library 账号设置"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Style="{StaticResource QuietButtonStyle}"
                            AutomationProperties.Name="关闭 Z-Library 账号设置"
                            Click="ZLibraryAccountCancelButton_Click">
                        <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="20,16,20,14"
                                Spacing="12"
                                MaxWidth="640"
                                HorizontalAlignment="Left">
                        <TextBlock Text="使用 Z-Library 账号登录后即可搜索和下载书籍。下载受账号每日额度限制；密码仅加密保存在本机，不会写入备份包。"
                                   FontSize="11"
                                   Foreground="#666666"
                                   TextWrapping="Wrap" />
                        <StackPanel Spacing="5">
                            <TextBlock Text="Z-Library 账号邮箱" FontSize="11" />
                            <TextBox x:Name="ZLibraryEmailBox"
                                     PlaceholderText="例如 name@example.com" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="密码" FontSize="11" />
                            <PasswordBox x:Name="ZLibraryPasswordBox"
                                         PlaceholderText="输入 Z-Library 账号密码" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="API 服务地址" FontSize="11" />
                            <TextBox x:Name="ZLibraryBaseUrlBox"
                                     PlaceholderText="https://api.z-lib.org" />
                            <TextBlock Text="默认使用官方 API；域名变更或访问受限时可在此修改为可用的镜像地址。"
                                       FontSize="10"
                                       Foreground="#777777"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2"
                      Padding="20,12,20,20"
                      BorderBrush="#EEEEEA"
                      BorderThickness="0,1,0,0"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ZLibraryAccountStatusText"
                               FontSize="10"
                               Foreground="#777777"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="取消"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="ZLibraryAccountCancelButton_Click" />
                    <Button Grid.Column="2"
                            Content="保存并验证"
                            Click="ZLibraryAccountSaveButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- AI assistant settings as a right-side panel (inline, not a pop-up). The API key is encrypted by the local settings store. -->
        <Border x:Name="ReaderAiSettingsPane"
                Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,38,0,0"
                      Padding="20,12,10,12"
                      BorderBrush="#EEEEEA"
                      BorderThickness="0,0,0,1">
                    <TextBlock Text="AI 助手设置"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Style="{StaticResource QuietButtonStyle}"
                            AutomationProperties.Name="关闭 AI 助手设置"
                            Click="ReaderAiSettingsCancelButton_Click">
                        <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="20,16,20,14"
                                Spacing="12"
                                MaxWidth="640"
                                HorizontalAlignment="Left">
                        <TextBlock Text="API Key 使用 Windows 当前用户加密后保存在本机。DeepSeek 使用 Chat Completions；OpenAI 使用 Responses API。"
                                   FontSize="11"
                                   Foreground="#666666"
                                   TextWrapping="Wrap" />
                        <StackPanel Spacing="5">
                            <TextBlock Text="服务" FontSize="11" />
                            <ComboBox x:Name="ReaderAiProviderBox"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="0"
                                      BorderBrush="#000000"
                                      BorderThickness="1"
                                      SelectionChanged="ReaderAiProviderBox_SelectionChanged">
                                <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                <ComboBoxItem Content="OpenAI" Tag="openai" />
                                <ComboBoxItem Content="自定义 OpenAI-compatible" Tag="custom" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Base URL" FontSize="11" />
                            <TextBox x:Name="ReaderAiBaseUrlBox" PlaceholderText="https://api.deepseek.com" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="模型" FontSize="11" />
                            <TextBox x:Name="ReaderAiModelBox" PlaceholderText="deepseek-v4-flash" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="API Key" FontSize="11" />
                            <PasswordBox x:Name="ReaderAiApiKeyBox"
                                         CornerRadius="0"
                                         BorderBrush="#000000"
                                         BorderThickness="1"
                                         PlaceholderText="输入 API Key" />
                        </StackPanel>
                        <TextBlock Text="自定义服务可填写本地模型或其他兼容接口；Base URL 应填写到 /v1 或服务根地址。"
                                   FontSize="10"
                                   Foreground="#777777"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2"
                      Padding="20,12,20,20"
                      BorderBrush="#EEEEEA"
                      BorderThickness="0,1,0,0"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ReaderAiSettingsStatusText"
                               FontSize="10"
                               Foreground="#777777"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="取消"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="ReaderAiSettingsCancelButton_Click" />
                    <Button Grid.Column="2"
                            Content="保存"
                            Click="ReaderAiSettingsSaveButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- Kindle device -->
        <Grid x:Name="DevicePage" Grid.Row="0" Grid.Column="1" Visibility="Collapsed" Padding="30,24,30,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="设备" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="DevicePageTitleText" Text="Kindle书库" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <Button x:Name="DeviceNameButton"
                            Style="{StaticResource DeviceNameFieldButtonStyle}"
                            IsEnabled="False"
                            Click="DeviceNameButton_Click"
                            AutomationProperties.Name="设备型号"
                            ToolTipService.ToolTip="点击选择设备型号">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="DeviceNameText"
                                       Text="未检测到设备"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       VerticalAlignment="Center" />
                            <FontIcon x:Name="DeviceNameChevronIcon"
                                      Glyph="&#xE70D;"
                                      FontSize="10"
                                      Foreground="{StaticResource MutedInkBrush}"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Bottom">
                    <Button Style="{StaticResource LibraryIconButtonStyle}"
                            Click="RefreshDeviceButton_Click"
                            AutomationProperties.Name="刷新设备"
                            ToolTipService.ToolTip="刷新设备">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                    <Button x:Name="DeviceViewToggleButton"
                            Style="{StaticResource LibraryIconButtonStyle}"
                            AutomationProperties.Name="切换视图"
                            ToolTipService.ToolTip="切换视图">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem x:Name="DeviceViewGridItem"
                                                     Text="网格视图"
                                                     GroupName="DeviceViewMode"
                                                     Tag="Grid"
                                                     IsChecked="True"
                                                     Click="KindleViewMenuItem_Click" />
                                <RadioMenuFlyoutItem x:Name="DeviceViewListItem"
                                                     Text="列表视图"
                                                     GroupName="DeviceViewMode"
                                                     Tag="List"
                                                     Click="KindleViewMenuItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <SymbolIcon x:Name="DeviceViewToggleIcon" Symbol="ViewAll" />
                    </Button>
                    <Button x:Name="DevicePageEjectButton"
                            Style="{StaticResource LibraryIconButtonStyle}"
                            IsEnabled="False"
                            Click="EjectDeviceButton_Click"
                            AutomationProperties.Name="弹出设备"
                            ToolTipService.ToolTip="未连接设备">
                        <Polygon Points="0,8 7,0 14,8"
                                 Width="14"
                                 Height="8"
                                 Fill="#000000"
                                 Stroke="#000000"
                                 StrokeThickness="1"
                                 Stretch="Fill" />
                    </Button>
                </StackPanel>
            </Grid>

            <GridView x:Name="DeviceBookGrid"
                      Grid.Row="1"
                      Margin="0,24,0,0"
                      ItemsSource="{x:Bind DeviceBooks}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="DeviceBookGrid_ItemClick"
                      PointerPressed="DeviceBookGrid_PointerPressed"
                      ItemContainerStyle="{StaticResource BookCardItemStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:KindleBookCardViewModel">
                        <Grid Width="154" RightTapped="DeviceBookCard_RightTapped">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="214" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="#D9D9D9"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="360" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Authors}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind RelativePath}"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <Grid>
                                    <TextBlock Text="KINDLE"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="13"
                                               CharacterSpacing="120" />
                                    <Image Source="{x:Bind CoverImage}" Stretch="Uniform" />
                                    <Border Height="4"
                                            VerticalAlignment="Top"
                                            Background="#000000"
                                            IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1"
                                        Margin="2,9,2,0"
                                        Spacing="2"
                                        Visibility="{x:Bind GalleryTextVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Title}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2" />
                                <TextBlock Text="{x:Bind Authors}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <TextBlock Text="{x:Bind InfoLabel}"
                                           Foreground="#777777"
                                           FontSize="10" />
                            </StackPanel>
                            <Border Grid.Row="0"
                                    Width="28"
                                    Height="28"
                                    Margin="0,5,5,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="#FFFFFF"
                                    BorderBrush="#000000"
                                    BorderThickness="1"
                                    Canvas.ZIndex="4"
                                    Visibility="{x:Bind GalleryPresenceVisibility, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind PresenceLabel, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind PresenceLabel, Mode=OneWay}">
                                <ContentControl Content="{Binding}"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ContentTemplate="{StaticResource LibraryPresenceGlyphTemplate}" />
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Background="Transparent"
                                    BorderBrush="#000000"
                                    BorderThickness="3"
                                    Canvas.ZIndex="9"
                                    Visibility="{x:Bind MultiSelectedVisibility, Mode=OneWay}"
                                    IsHitTestVisible="False">
                                <Border Width="22"
                                        Height="22"
                                        Margin="6,6,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#000000">
                                    <FontIcon Glyph="&#xE73E;"
                                              FontSize="13"
                                              Foreground="#FFFFFF"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ListView x:Name="DeviceBookList"
                      Grid.Row="1"
                      Margin="0,24,0,0"
                      Visibility="Collapsed"
                      ItemsSource="{x:Bind DeviceBooks}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="DeviceBookList_ItemClick"
                      PointerPressed="DeviceBookList_PointerPressed"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,1" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:KindleBookCardViewModel">
                        <Grid Padding="8,9"
                              MinHeight="72"
                              RightTapped="DeviceBookCard_RightTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="42"
                                  Height="56"
                                  VerticalAlignment="Center">
                                <Border Background="#D9D9D9"
                                        BorderBrush="#000000"
                                        BorderThickness="1">
                                    <Image Source="{x:Bind CoverImage}" Stretch="Uniform" />
                                </Border>
                                <Border Width="18"
                                        Height="18"
                                        Margin="0,0,0,2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="#FFFFFF"
                                        BorderBrush="#000000"
                                        BorderThickness="1"
                                        Visibility="{x:Bind PresenceVisibility, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind PresenceLabel, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind PresenceLabel, Mode=OneWay}">
                                    <ContentControl Content="{Binding}"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ContentTemplate="{StaticResource LibraryPresenceGlyphTemplate}"
                                                    RenderTransformOrigin="0.5,0.5">
                                        <ContentControl.RenderTransform>
                                            <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                                        </ContentControl.RenderTransform>
                                    </ContentControl>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Authors}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind FileName}"
                                           Foreground="#777777"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind FileName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="{x:Bind InfoLabel}"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ModifiedLabel}"
                                           Foreground="#777777"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="{x:Bind RelativePath}"
                                           Foreground="#777777"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right"
                                           ToolTipService.ToolTip="{x:Bind RelativePath}" />
                                <TextBlock Text="{x:Bind HashLabel}"
                                           Foreground="#999999"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right"
                                           ToolTipService.ToolTip="{x:Bind Book.Sha256}" />
                            </StackPanel>
                            <Border Grid.ColumnSpan="4"
                                    Background="Transparent"
                                    BorderBrush="#000000"
                                    BorderThickness="3"
                                    Visibility="{x:Bind MultiSelectedVisibility, Mode=OneWay}"
                                    IsHitTestVisible="False">
                                <Border Width="22"
                                        Height="22"
                                        Margin="6,6,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#000000">
                                    <FontIcon Glyph="&#xE73E;"
                                              FontSize="13"
                                              Foreground="#FFFFFF"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="DeviceBookMultiSelectBar"
                    Grid.Row="1"
                    Canvas.ZIndex="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    Padding="16,8"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    CornerRadius="0"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock x:Name="DeviceBookMultiSelectCountText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="ExportSelectedDeviceBooksButton"
                            Content="导出到电脑书库"
                            Click="ExportSelectedDeviceBooksButton_Click" />
                    <Button x:Name="DeleteSelectedDeviceBooksButton"
                            Content="从 Kindle 删除"
                            Click="DeleteSelectedDeviceBooksButton_Click" />
                    <Button Content="取消选择"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="ClearDeviceMultiSelectionButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Kindle fonts and dictionaries. Operations are restricted to fonts or documents\dictionaries. -->
        <Grid x:Name="DeviceResourcePage"
              Grid.Row="0"
              Grid.Column="1"
              Visibility="Collapsed"
              Padding="30,24,30,18"
              AllowDrop="True"
              DragOver="DeviceResourcePage_DragOver"
              Drop="DeviceResourcePage_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="设备" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="DeviceResourcePageTitle" Text="Kindle 字体" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock x:Name="DeviceResourceDeviceText" Text="未检测到设备" Foreground="#000000" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                        <TextBlock x:Name="DeviceResourcePathText" Text="Kindle\fonts" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                        <TextBlock Text="·" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                        <TextBlock x:Name="DeviceResourceCountText" Text="0 个文件" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="DeviceResourceStatusText" Text="请连接 Kindle" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button x:Name="ImportDeviceResourceButton" Content="导入到 Kindle" Click="ImportDeviceResourceButton_Click" />
                    <Button x:Name="ExportDeviceResourceButton" Content="导出所选" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" Click="ExportDeviceResourceButton_Click" />
                    <Button x:Name="DeleteDeviceResourceButton" Content="删除所选" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" Click="DeleteDeviceResourceButton_Click" />
                    <Button Content="刷新" Style="{StaticResource QuietButtonStyle}" Click="RefreshDeviceResourcesButton_Click" />
                    <Button Content="返回书架" Click="AllBooksButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <ListView x:Name="DeviceResourceList"
                          ItemsSource="{x:Bind DeviceResources}"
                          SelectionMode="Single"
                          SelectionChanged="DeviceResourceList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:KindleDeviceResource">
                            <Grid Padding="10,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Format}" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="DeviceResourceEmptyText"
                           Text="此目录中没有可管理的文件"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedInkBrush}" />
            </Grid>
            <TextBlock x:Name="DeviceResourceSafetyText" Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
        </Grid>

        <!-- Unified local-reader and Kindle clippings library. -->
        <Grid x:Name="ReadingMaterialsPage" Grid.Row="0" Grid.Column="1" Visibility="Collapsed" Padding="30,24,30,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="资料" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="ReadingMaterialsPageTitle" Text="笔记与标注" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="ReadingMaterialsStatusText" Text="汇总本地书籍与 Kindle 的划线笔记" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="ReadingMaterialsNotesActions" Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button x:Name="LocateReadingMaterialButton" Content="在阅读器中定位" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" Click="LocateReadingMaterialButton_Click" />
                    <Button x:Name="DeleteReadingMaterialButton" Content="删除所选" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" Click="DeleteReadingMaterialButton_Click" />
                    <Button Content="刷新" Style="{StaticResource QuietButtonStyle}" Click="RefreshReadingMaterialsButton_Click" />
                    <Button Content="返回书架" Click="AllBooksButton_Click" />
                </StackPanel>
                <StackPanel x:Name="ReadingMaterialsExportActions" Grid.Column="1" Margin="0,46,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Visibility="Collapsed">
                    <Button Content="刷新资料" Style="{StaticResource QuietButtonStyle}" Click="RefreshReadingMaterialsButton_Click" />
                    <Button Content="返回书架" Click="AllBooksButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,14" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="ReadingMaterialsSourceBox" Header="来源" SelectedIndex="0" SelectionChanged="ReadingMaterialsFilter_Changed">
                    <ComboBoxItem Content="全部来源" Tag="all" />
                    <ComboBoxItem Content="本地书籍" Tag="local" />
                    <ComboBoxItem Content="Kindle" Tag="kindle" />
                </ComboBox>
                <TextBox x:Name="ReadingMaterialsSearchBox" Grid.Column="1" Header="搜索" PlaceholderText="书名、划线、笔记或位置" TextChanged="ReadingMaterialsSearchBox_TextChanged" />
            </Grid>

            <Border x:Name="ReadingMaterialsExportPanel"
                    Grid.Row="2"
                    Margin="0,0,0,14"
                    Padding="16,14"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="导出当前筛选结果" FontSize="16" FontWeight="Bold" />
                        <TextBlock x:Name="ReadingMaterialsExportScopeText"
                                   Text="当前筛选范围：全部来源 · 共 0 条记录"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Markdown 适合保留标题层级；纯文本适合在任意设备上阅读。"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="导出 Markdown" Click="ExportReadingMaterialsMarkdownButton_Click" />
                        <Button Content="导出文本" Style="{StaticResource QuietButtonStyle}" Click="ExportReadingMaterialsTextButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,0,0,14"
                    Padding="14,11"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2">
                <TextBlock x:Name="ReadingMaterialsSummaryText"
                           Text="本地 0 条 · Kindle 0 条"
                           Foreground="#000000"
                           FontWeight="SemiBold" />
            </Border>

            <Grid Grid.Row="4">
                <ListView x:Name="ReadingMaterialsList"
                          SelectionMode="Single"
                          SelectionChanged="ReadingMaterialsList_SelectionChanged"
                          IsItemClickEnabled="True"
                          ItemClick="ReadingMaterialsList_ItemClick">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="local:ReadingMaterialGroupViewModel">
                                    <Border Margin="0,14,0,4"
                                            Padding="12,9"
                                            Background="#FFFFFF"
                                            BorderBrush="#000000"
                                            BorderThickness="1,1,1,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind BookTitle}"
                                                           FontSize="16"
                                                           FontWeight="Bold" />
                                                <TextBlock Text="{x:Bind SourceLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind CountLabel}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ReadingMaterialItemViewModel">
                            <Grid Padding="12,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind SourceLabel}" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind TypeLabel}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind BookTitle}" TextWrapping="Wrap" MaxLines="2" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="{x:Bind Quote}" TextWrapping="Wrap" MaxLines="3" />
                                    <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" MaxLines="2" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind Location}" TextWrapping="Wrap" MaxLines="2" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind DateLabel}" FontSize="10" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="ReadingMaterialsEmptyText" Text="没有符合条件的划线与笔记" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" />
            </Grid>
        </Grid>

        <!-- Reading dashboard: a standalone right-side page with monochrome charts. -->
        <Grid x:Name="ReadingDashboardPage"
              Grid.Row="0"
              Grid.Column="1"
              Padding="30,24,30,18"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="统计" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="阅读数据" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="ReadingDashboardSummaryText"
                               Foreground="{StaticResource MutedInkBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ReadingDashboardDetailText"
                               Foreground="{StaticResource MutedInkBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="刷新统计" Click="RefreshReadingDashboardButton_Click" />
                    <Button Content="导出 CSV"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="ExportReadingDashboardButton_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Padding="0,0,8,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="14" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="累计阅读" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBlock x:Name="ReadingDashboardTotalTimeText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="14" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="已开始" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBlock x:Name="ReadingDashboardStartedText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="14" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="已读完" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBlock x:Name="ReadingDashboardFinishedText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="14" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="书签 / 批注" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                <TextBlock x:Name="ReadingDashboardNotesText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="14" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="近 14 天阅读时长" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="每天有效阅读分钟数" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                <local:MonochromeBarChart x:Name="ReadingDailyChart" Height="190" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Padding="14" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="单本阅读时长" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="累计阅读时长最高的书籍" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                <local:MonochromeBarChart x:Name="ReadingBookTimeChart" Height="190" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Padding="14" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="阅读进度分布" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="按当前阅读百分比分组" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                <local:MonochromeBarChart x:Name="ReadingProgressChart" Height="190" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="14" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="阅读状态分布" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="阅读中与已完成书籍数量" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                <local:MonochromeBarChart x:Name="ReadingStatusChart" Height="190" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Padding="14" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="最近阅读" FontSize="15" FontWeight="SemiBold" />
                            <ListView x:Name="ReadingDashboardRecentList"
                                      MaxHeight="220"
                                      DisplayMemberPath="Display" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

        <!-- Book details -->
        <Border x:Name="DetailPane"
                Grid.Row="0"
                Grid.Column="2"
                Visibility="Collapsed"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <ScrollViewer>
                    <StackPanel Padding="24,70,24,24" Spacing="13">
                    <Grid HorizontalAlignment="Left" ColumnSpacing="12">
                        <Grid.Resources>
                            <Style x:Key="DetailActionIconButtonStyle" TargetType="Button">
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Height" Value="34" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="#000000" />
                                <Setter Property="BorderBrush" Value="#000000" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="DetailActionBackground"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailActionBackground" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailActionContent" Storyboard.TargetProperty="Foreground">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailActionBackground" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailActionContent" Storyboard.TargetProperty="Foreground">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="DetailActionContent" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <ContentPresenter x:Name="DetailActionContent"
                                                                  Content="{TemplateBinding Content}"
                                                                  Foreground="{TemplateBinding Foreground}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DetailCoverBorder"
                                Width="180"
                                Height="250"
                                HorizontalAlignment="Left"
                                Background="#FFFFFF"
                                BorderBrush="#000000"
                                BorderThickness="1"
                                CornerRadius="0">
                            <Image x:Name="DetailCoverImage"
                                   Stretch="Uniform" />
                        </Border>
                        <Grid Grid.Column="1" Height="250" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button
                                x:Name="DoubanMatchButton"
                                AutomationProperties.Name="从豆瓣匹配书籍信息"
                                ToolTipService.ToolTip="豆瓣匹配"
                                Style="{StaticResource DetailActionIconButtonStyle}"
                                Click="DoubanMatchButton_Click">
                            <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
                        </Button>
                        <Button
                                Grid.Row="1"
                                x:Name="DetailsFavoriteButton"
                                AutomationProperties.Name="收藏状态"
                                ToolTipService.ToolTip="收藏状态"
                                Style="{StaticResource DetailActionIconButtonStyle}"
                                Click="DetailsFavoriteButton_Click">
                            <FontIcon x:Name="DetailsFavoriteIcon"
                                      Glyph="&#xE734;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="18" />
                        </Button>
                        <Button
                                Grid.Row="2"
                                x:Name="DetailsReadingStatusButton"
                                AutomationProperties.Name="阅读状态"
                                ToolTipService.ToolTip="阅读状态"
                                Style="{StaticResource DetailActionIconButtonStyle}"
                                Click="DetailsReadingStatusButton_Click">
                            <FontIcon x:Name="DetailsReadingStatusIcon"
                                      Glyph="&#xE8A4;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="18" />
                        </Button>
                        </Grid>
                    </Grid>
                    <StackPanel Spacing="5">
                        <TextBlock Text="标题" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsTitleBox" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="作者" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsAuthorsBox" FontSize="13" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="豆瓣评分（只读）" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsDoubanRatingBox" IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="标签" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsTagsBox" PlaceholderText="多个标签用逗号分隔" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="分类" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsCategoryBox" PlaceholderText="例如：技术、文学" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="简介" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                    </StackPanel>
                    <Rectangle Height="1" Fill="#E2E2DE" Margin="0,4,0,2" />
                    <TextBlock Text="出版信息"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedInkBrush}" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="系列" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsSeriesBox" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="出版社" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsPublisherBox" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="出版年" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBox x:Name="DetailsPublishDateBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="ISBN" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBox x:Name="DetailsIsbnBox" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="页数" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBox x:Name="DetailsPageCountBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="装帧" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBox x:Name="DetailsBindingBox" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="#E2E2DE" Margin="0,8,0,2" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="保存修改"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="SaveDetailsButton_Click" />
                            <Button Grid.Column="1"
                                    Content="从书库删除"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14,8"
                                    Background="#FFFFFF"
                                    Foreground="#B3261E"
                                    BorderBrush="#B3261E"
                                    Click="DeleteBookButton_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Keep scrolled detail content out of the transparent title-bar drag area. -->
                <Border Height="38"
                        VerticalAlignment="Top"
                        Background="#FFFFFF"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- Focused three-pane EPUB/PDF reader inspired by desktop reading tools. -->
        <Grid x:Name="ReaderPane"
              Grid.ColumnSpan="3"
              Margin="0"
              Canvas.ZIndex="40"
              Background="#FFFFFF"
              Visibility="Collapsed">
            <Grid.Resources>
                <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#C9C9C5" />
                <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#B4B4B0" />
                <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A4A4A0" />
                <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="#C9C9C5" />
                <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#C9C9C5" />
                <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#C9C9C5" />
                <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#FFFFFF" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ReaderTocColumn" Width="286" />
                <ColumnDefinition x:Name="ReaderContentColumn" Width="*" />
                <ColumnDefinition x:Name="ReaderAssistantColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Opaque transition cover used when leaving zen mode: the reader
                 pane sits above the library, so fading the pane itself would
                 reveal the bookshelf behind it. This cover hides the layout
                 restore/window resize instead and is faded away afterwards. -->
            <Grid x:Name="ReaderTransitionCover"
                  Grid.ColumnSpan="3"
                  Background="#FFFFFF"
                  Opacity="0"
                  IsHitTestVisible="False"
                  Canvas.ZIndex="200" />

            <!-- Table of contents and reading progress. -->
            <Border x:Name="ReaderTocPanel"
                    Grid.Column="0"
                    Margin="0,38,0,0"
                    Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>

                    <!-- Start the divider below the shared header rule. Keep it
                         above search content so it remains continuous. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="5"
                               Width="1"
                               HorizontalAlignment="Right"
                               Fill="#EEEEEA"
                               IsHitTestVisible="False"
                               Canvas.ZIndex="100" />

                    <Grid Padding="14,8" BorderBrush="#EEEEEA" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ReaderBookInfoText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                    AutomationProperties.Name="切换极简目录"
                                    ToolTipService.ToolTip="切换极简目录"
                                    Click="ReaderTocMinimalToggleButton_Click">
                                <FontIcon Glyph="&#xE8A5;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                    AutomationProperties.Name="收起目录"
                                    ToolTipService.ToolTip="收起目录"
                                    Click="ReaderTocToggleButton_Click">
                                <FontIcon Glyph="&#xE76C;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ReaderTocTabsPanel"
                          Grid.Row="1"
                          Padding="14,4,14,4"
                          ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ReaderTocTabButton"
                                Content="目录"
                                HorizontalAlignment="Stretch"
                                BorderThickness="1"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                Click="ReaderTocTabButton_Click" />
                        <Button x:Name="ReaderBookmarkTabButton"
                                Grid.Column="1"
                                Content="书签"
                                HorizontalAlignment="Stretch"
                                BorderThickness="1"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                Click="ReaderBookmarkTabButton_Click" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <ListView x:Name="ReaderTocList"
                                  SelectionMode="Single"
                                  ItemContainerStyle="{StaticResource ReaderTocItemStyle}"
                                  SelectionChanged="ReaderTocList_SelectionChanged"
                                  Loaded="ReaderTocList_Loaded"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.Resources>
                                <!-- Softer, quieter scrollbar for the TOC so the
                                     side panel stays out of the reading flow. -->
                                <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#C9C9C5" />
                                <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#B4B4B0" />
                                <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A4A4A0" />
                                <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="#C9C9C5" />
                                <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#C9C9C5" />
                                <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#C9C9C5" />
                                <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#FFFFFF" />
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="infra:EpubReaderNavigationItem">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ReaderTocEmptyText"
                                   Margin="20"
                                   Text="此文档没有可用目录。"
                                   FontSize="12"
                                   Foreground="#777777"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />

                        <Grid x:Name="ReaderBookmarkPane" Visibility="Collapsed">
                            <ListView x:Name="ReaderBookmarkList"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="ReaderBookmarkList_ItemClick"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:ReaderBookmark">
                                        <Grid Margin="0,1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Padding="12,7,4,7" Spacing="3">
                                                <TextBlock Text="{x:Bind DisplayTitle}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DisplayQuote}"
                                                           FontSize="10"
                                                           Foreground="#707070"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DisplayTime}"
                                                           FontSize="9"
                                                           Foreground="#909090" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,6,0"
                                                    Content="×"
                                                    FontSize="13"
                                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                                    AutomationProperties.Name="删除书签"
                                                    Click="ReaderBookmarkDeleteButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="ReaderBookmarkEmptyText"
                                       Margin="20"
                                       Text="还没有书签。阅读时按 Ctrl+B 或点击顶部“书签”按钮添加。"
                                       FontSize="12"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Whole-book search reuses the normal TOC surface. -->
                        <Grid x:Name="ReaderSearchPanel"
                              Background="#FFFFFF"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ReaderTocSearchBox"
                                     Margin="14,4,14,10"
                                     Height="34"
                                     Padding="10,5"
                                     CornerRadius="0"
                                     BorderBrush="#000000"
                                     PlaceholderText="搜索整本书…"
                                     TextChanged="ReaderTocSearchBox_TextChanged" />
                            <TextBlock x:Name="ReaderSearchCountText"
                                       Grid.Row="1"
                                       Margin="14,0,14,8"
                                       FontSize="10"
                                       Foreground="#5E5E5E" />
                            <ListView x:Name="ReaderSearchResultList"
                                      Grid.Row="2"
                                      SelectionMode="None"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      Loaded="ReaderSearchResultList_Loaded">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ReaderSearchResultItem">
                                        <Button Padding="0"
                                                Margin="0"
                                                BorderThickness="1"
                                                BorderBrush="{x:Bind ResultBorderBrush, Mode=OneWay}"
                                                Background="Transparent"
                                                UseSystemFocusVisuals="False"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="ReaderSearchResultButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          Padding="{TemplateBinding Padding}"
                                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Padding="14,9,14,9" Spacing="3">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                           Tag="Title"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           DataContextChanged="ReaderSearchHighlightedText_DataContextChanged"
                                                           Loaded="ReaderSearchHighlightedText_Loaded" />
                                                <TextBlock Text="{x:Bind Snippet, Mode=OneWay}"
                                                           Tag="Snippet"
                                                           FontSize="10"
                                                           Foreground="#707070"
                                                           TextWrapping="Wrap"
                                                           MaxLines="4"
                                                           TextTrimming="CharacterEllipsis"
                                                           DataContextChanged="ReaderSearchHighlightedText_DataContextChanged"
                                                           Loaded="ReaderSearchHighlightedText_Loaded" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                 </ListView.ItemTemplate>
                             </ListView>
                            <Grid x:Name="ReaderSearchScrollBarOverlay"
                                  Grid.Row="2"
                                  Width="14"
                                  Margin="0,4,2,4"
                                  HorizontalAlignment="Right"
                                  Background="Transparent"
                                  Canvas.ZIndex="10"
                                  IsHitTestVisible="False"
                                  Visibility="Visible"
                                  PointerEntered="ReaderSearchScrollBarOverlay_PointerEntered"
                                  PointerExited="ReaderSearchScrollBarOverlay_PointerExited"
                                  PointerPressed="ReaderSearchScrollBarOverlay_PointerPressed"
                                  PointerMoved="ReaderSearchScrollBarOverlay_PointerMoved"
                                  PointerReleased="ReaderSearchScrollBarOverlay_PointerReleased"
                                  SizeChanged="ReaderSearchScrollBarOverlay_SizeChanged">
                                <Canvas>
                                    <Border x:Name="ReaderSearchScrollBarTrack"
                                            Width="1"
                                            Canvas.Left="6"
                                            Background="#E2E2DE"
                                            BorderThickness="0" />
                                    <Border x:Name="ReaderSearchScrollBarThumb"
                                            Width="8"
                                            Height="36"
                                            Canvas.Left="3"
                                            Background="#C9C9C5"
                                            BorderBrush="#C9C9C5"
                                            BorderThickness="0"
                                            CornerRadius="0"
                                            Opacity="0" />
                                </Canvas>
                            </Grid>
                            <TextBlock x:Name="ReaderSearchStatusText"
                                       Grid.Row="2"
                                       Margin="20"
                                       Text="输入关键词，实时搜索整本书。"
                                       TextAlignment="Center"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="ReaderReadingInfoPanel"
                                Grid.Row="4"
                                Margin="14,4,14,8"
                                Spacing="2">
                        <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReaderReadingProgressText"
                                       Text="准备阅读"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="ReaderProgressPercentText"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock x:Name="ReaderStatsText"
                                   FontSize="10"
                                   Foreground="#5E5E5E"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="5"
                            Margin="0"
                            BorderBrush="#E2E2DE"
                            BorderThickness="1"
                            CornerRadius="0">
                        <Button Content="返回书架"
                                Margin="0"
                                Height="48"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                Click="CloseReaderButton_Click" />
                    </Border>
                </Grid>
            </Border>

            <!-- Minimal TOC rail: small markers keep the chapter map visible without
                 taking the reading column away from the正文. -->
            <Border x:Name="ReaderTocCompactPanel"
                    Grid.Column="0"
                    Margin="0,38,0,0"
                    Background="#FFFFFF"
                    BorderBrush="#D8D8D4"
                    BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Width="28"
                          HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ReaderTocCompactUpIndicator"
                                   Grid.Row="1"
                                   Text="&#x25B3;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="12"
                                   Foreground="#000000"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Up chapter status" />
                    <Button Grid.Row="0"
                            Width="28"
                            MinWidth="0"
                            Height="34"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReaderHeaderIconButtonStyle}"
                            AutomationProperties.Name="展开完整目录"
                            ToolTipService.ToolTip="展开完整目录"
                            Click="ReaderTocCompactExpandButton_Click">
                        <FontIcon Glyph="&#xE8A5;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="13"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  x:Name="ReaderTocCompactScrollViewer"
                                  HorizontalContentAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Enabled"
                                  Padding="0,8"
                                  Loaded="ReaderTocCompactScrollViewer_Loaded"
                                  SizeChanged="ReaderTocCompactScrollViewer_SizeChanged"
                                  ViewChanged="ReaderTocCompactScrollViewer_ViewChanged"
                                  PointerEntered="ReaderTocCompactScrollViewer_PointerEntered"
                                  PointerMoved="ReaderTocCompactScrollViewer_PointerMoved"
                                  PointerExited="ReaderTocCompactScrollViewer_PointerExited"
                                  PointerWheelChanged="ReaderTocCompactScrollViewer_PointerWheelChanged">
                        <ItemsControl x:Name="ReaderTocCompactList"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ReaderTocMarker">
                                    <Button Width="50"
                                            Height="10"
                                            MinWidth="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            AutomationProperties.Name="{x:Bind Title}"
                                            IsTabStop="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalContentAlignment="Center"
                                                                  VerticalContentAlignment="Center" />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Border Width="8"
                                                Height="2"
                                                Background="{x:Bind Fill}"
                                                BorderThickness="0"
                                                IsHitTestVisible="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2"
                               x:Name="ReaderTocCompactDownIndicator"
                               Text="&#x25BD;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="12"
                               Foreground="#000000"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="Down chapter status" />
                </Grid>
            </Border>

            <Border x:Name="ReaderTocCompactHoverLabel"
                    Grid.ColumnSpan="3"
                    MaxWidth="340"
                    Padding="10,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#FFFFFF"
                    BorderBrush="#C9C9C5"
                    BorderThickness="1"
                    CornerRadius="0"
                    Canvas.ZIndex="90"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="ReaderTocCompactHoverLabelText"
                           MaxWidth="320"
                           Foreground="#555555"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Reading canvas and compact controls. -->
            <Grid x:Name="ReaderContentPanel"
                  Grid.Column="1"
                  Margin="0,38,0,0"
                  Background="#FFFFFF"
                  SizeChanged="ReaderContentPanel_SizeChanged">
                <Grid.Clip>
                    <RectangleGeometry x:Name="ReaderContentClip" />
                </Grid.Clip>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ReaderHeaderRow" Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="ReaderFooterRow" Height="50" />
                </Grid.RowDefinitions>

                <Border x:Name="ReaderHeaderBar"
                        Background="#FFFFFF"
                        BorderBrush="#E2E2DE"
                        BorderThickness="0,0,0,1">
                    <Grid Padding="12,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="5">
                            <Button x:Name="ReaderTocToggleButton"
                                    Content="目录"
                                    Width="64"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    ToolTipService.ToolTip="显示或隐藏目录"
                                    Click="ReaderTocToggleButton_Click" />
                            <Button x:Name="ReaderSearchToolbarButton"
                                    Content="搜索"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    AutomationProperties.Name="书内搜索"
                                    ToolTipService.ToolTip="搜索整本书（Ctrl+F）"
                                    Click="ReaderSearchToolbarButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ReaderStatusText"
                                   Grid.Column="1"
                                   Margin="4,0"
                                   FontSize="10"
                                   Foreground="#858585"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <ScrollViewer Grid.Column="2"
                                      MaxWidth="920"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="ReaderZoomOutButton"
                                    Content="A−"
                                    Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                    AutomationProperties.Name="减小字号"
                                    Click="ReaderZoomOutButton_Click" />
                            <TextBlock x:Name="ReaderZoomText"
                                       Width="44"
                                       Text="100%"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <Button x:Name="ReaderZoomInButton"
                                    Content="A+"
                                    Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                    AutomationProperties.Name="增大字号"
                                    Click="ReaderZoomInButton_Click" />
                            <Rectangle Width="1" Height="20" Margin="12,0" Fill="#E2E2DE" VerticalAlignment="Center" />
                            <Button x:Name="ReaderFlowButton"
                                    Content="分页"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    ToolTipService.ToolTip="选择滚动、单页或双栏阅读模式"
                                    AutomationProperties.Name="选择阅读分页模式">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <RadioMenuFlyoutItem x:Name="ReaderScrollModeItem"
                                                             Text="滚动"
                                                             Tag="scroll"
                                                             GroupName="ReaderFlowMode"
                                                             Click="ReaderFlowModeItem_Click" />
                                        <RadioMenuFlyoutItem x:Name="ReaderSinglePageModeItem"
                                                             Text="单页"
                                                             Tag="single"
                                                             GroupName="ReaderFlowMode"
                                                             Click="ReaderFlowModeItem_Click" />
                                        <RadioMenuFlyoutItem x:Name="ReaderTwoPageModeItem"
                                                             Text="双栏"
                                                             Tag="double"
                                                             GroupName="ReaderFlowMode"
                                                             Click="ReaderFlowModeItem_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="ReaderMoreButton"
                                    Content="更多"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    ToolTipService.ToolTip="阅读设置"
                                    AutomationProperties.Name="阅读设置">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <ToggleMenuFlyoutItem x:Name="ReaderZenMenuItem"
                                                              Text="禅模式"
                                                              ToolTipService.ToolTip="隐藏目录与阅读助手，最大化正文区域"
                                                              Click="ReaderZenMenuItem_Click" />
                                        <MenuFlyoutItem Text="阅读排版设置"
                                                        ToolTipService.ToolTip="字号、行距、正文宽度、字体与竖排"
                                                        Click="ReaderLayoutSettingsMenuItem_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="翻页动画">
                                            <RadioMenuFlyoutItem x:Name="ReaderAnimationNoneItem"
                                                                 Text="无动画"
                                                                 GroupName="ReaderPageAnimation"
                                                                 Click="ReaderAnimationItem_Click" />
                                            <RadioMenuFlyoutItem x:Name="ReaderAnimationFadeItem"
                                                                 Text="淡入淡出"
                                                                 GroupName="ReaderPageAnimation"
                                                                 IsChecked="True"
                                                                 Click="ReaderAnimationItem_Click" />
                                            <RadioMenuFlyoutItem x:Name="ReaderAnimationSlideItem"
                                                                 Text="左右滑动"
                                                                 GroupName="ReaderPageAnimation"
                                                                 Click="ReaderAnimationItem_Click" />
                                            <RadioMenuFlyoutItem x:Name="ReaderAnimationWaveItem"
                                                                 Text="水波流动"
                                                                 GroupName="ReaderPageAnimation"
                                                                 Click="ReaderAnimationItem_Click" />
                                        </MenuFlyoutSubItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Rectangle Width="1" Height="20" Margin="12,0" Fill="#E2E2DE" VerticalAlignment="Center" />
                            <Button x:Name="ReaderHighlightButton"
                                    Content="划线"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="为正文中选中的文字添加划线"
                                    Click="ReaderHighlightButton_Click" />
                            <Button x:Name="ReaderAnnotateButton"
                                    Content="批注"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="为正文中选中的文字添加笔记"
                                    Click="ReaderAnnotateButton_Click" />
                            <Button x:Name="ReaderBookmarkButton"
                                    Content="书签"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    AutomationProperties.Name="添加书签"
                                    Click="ReaderBookmarkButton_Click">
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Name="ReaderBookmarkFeedbackToolTip"
                                             Content="添加或取消当前阅读位置的书签（Ctrl+B）"
                                             Placement="Bottom" />
                                </ToolTipService.ToolTip>
                            </Button>
                            <Rectangle Width="1" Height="20" Margin="12,0" Fill="#E2E2DE" VerticalAlignment="Center" />
                            <Button x:Name="ReaderAssistantToggleButton"
                                    Content="助手"
                                    Style="{StaticResource ReaderHeaderButtonStyle}"
                                    ToolTipService.ToolTip="显示或隐藏阅读助手"
                                    Click="ReaderAssistantToggleButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="#FFFFFF">
                    <Grid x:Name="ReaderWebViewHost"
                          Margin="0,12,0,10"
                          Background="#FFFFFF"
                          SizeChanged="ReaderWebViewHost_SizeChanged"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="ReaderWebViewTransform" />
                        </Grid.RenderTransform>
                        <!-- Hidden preload surface: the next EPUB chapter is
                             loaded and styled here while the current chapter is
                             being read, so a forward chapter switch can swap to
                             an already-prepared document instead of waiting for
                             a fresh WebView navigation. Kept sized and laid out
                             (opacity 0, not collapsed) so its pagination math
                             sees the real viewport. -->
                        <WebView2 x:Name="ReaderPreloadWebView"
                                  Opacity="0"
                                  IsHitTestVisible="False"
                                  Canvas.ZIndex="1"
                                  NavigationStarting="ReaderPreloadWebView_NavigationStarting"
                                  NavigationCompleted="ReaderPreloadWebView_NavigationCompleted" />
                        <WebView2 x:Name="ReaderWebView"
                                  Canvas.ZIndex="2"
                                  NavigationStarting="ReaderWebView_NavigationStarting"
                                  NavigationCompleted="ReaderWebView_NavigationCompleted" />

                    </Grid>

                    <!-- WebView2's composition island can render a hairline
                         along its bottom edge (fractional DPI scaling). It
                         paints over child XAML, so this cover must be a LATER
                         SIBLING of the WebView host to render above it. -->
                    <Rectangle x:Name="ReaderWebViewBottomCover"
                               Height="2"
                               Margin="0,0,0,10"
                               VerticalAlignment="Bottom"
                               Fill="#FFFFFF"
                               IsHitTestVisible="False"
                               Canvas.ZIndex="30" />

                    <!-- Current-page bookmark marker. Its straight edges sit
                         flush against the reading rectangle's top/right edge. -->
                    <Path x:Name="ReaderBookmarkCornerMarker"
                          Width="26"
                          Height="26"
                          Margin="0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Canvas.ZIndex="25"
                          Data="M 0,0 L 26,0 L 26,26 Z"
                          Fill="#777774"
                          Stretch="None"
                          IsHitTestVisible="False"
                          Visibility="Collapsed" />

                    <Border x:Name="ReaderInPageSearchBar"
                            Width="430"
                            Margin="0,16,24,0"
                            Padding="10,8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Canvas.ZIndex="45"
                            Background="#FFFFFF"
                            BorderBrush="#000000"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ReaderInPageSearchBox"
                                     Height="32"
                                     Padding="8,4"
                                     CornerRadius="0"
                                     BorderBrush="#000000"
                                     PlaceholderText="查找当前正文…"
                                     TextChanged="ReaderInPageSearchBox_TextChanged"
                                     KeyDown="ReaderInPageSearchBox_KeyDown" />
                            <TextBlock x:Name="ReaderInPageSearchCountText"
                                       Grid.Column="1"
                                       MinWidth="48"
                                       Text="0/0"
                                       FontSize="11"
                                       Foreground="#5E5E5E"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="↑"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    AutomationProperties.Name="上一个正文命中"
                                    Click="ReaderInPageSearchPreviousButton_Click" />
                            <Button Grid.Column="3"
                                    Content="↓"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    AutomationProperties.Name="下一个正文命中"
                                    Click="ReaderInPageSearchNextButton_Click" />
                            <Button Grid.Column="4"
                                    Content="×"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    FontSize="15"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    AutomationProperties.Name="关闭正文查找"
                                    Click="ReaderInPageSearchCloseButton_Click" />
                        </Grid>
                    </Border>

                    <!-- Slim floating bar shown only in zen mode; keeps the exit/close entries
                         while the normal header and footer bars are collapsed. -->
                    <Border x:Name="ReaderZenBar"
                            Margin="0,16,24,0"
                            Padding="2,2,2,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Canvas.ZIndex="30"
                            Background="#FFFFFF"
                            BorderBrush="#000000"
                            BorderThickness="1"
                            CornerRadius="0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="禅模式"
                                       Margin="10,0,2,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ReaderZenTocButton"
                                    Content="极简目录"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    ToolTipService.ToolTip="显示或隐藏极简目录"
                                    Visibility="Collapsed"
                                    Click="ReaderZenMinimalTocButton_Click" />
                            <Button x:Name="ReaderExitZenButton"
                                    Content="退出禅模式"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    ToolTipService.ToolTip="退出禅模式，恢复目录与阅读助手"
                                    Click="ReaderExitZenButton_Click" />
                            <Button x:Name="ReaderZenCloseButton"
                                    Content="×"
                                    FontSize="15"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    AutomationProperties.Name="关闭阅读器"
                                    ToolTipService.ToolTip="返回书架"
                                    Click="CloseReaderButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="ReaderFooterBar" Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E2DE" BorderThickness="0,1,0,0">
                    <Grid Padding="14,4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ReaderPreviousButton"
                                Content="‹"
                                FontSize="16"
                                Width="34"
                                Height="30"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                AutomationProperties.Name="上一章"
                                ToolTipService.ToolTip="上一章"
                                Click="ReaderPreviousButton_Click" />
                        <Button x:Name="ReaderNextButton"
                                Grid.Column="1"
                                Content="›"
                                FontSize="16"
                                Width="34"
                                Height="30"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                AutomationProperties.Name="下一章"
                                ToolTipService.ToolTip="下一章"
                                Click="ReaderNextButton_Click" />
                        <Slider x:Name="ReaderProgressSlider"
                                Grid.Column="2"
                                Margin="6,0,14,0"
                                MinWidth="120"
                                Minimum="1"
                                Maximum="1"
                                Value="1"
                                StepFrequency="1"
                                SnapsTo="StepValues"
                                VerticalAlignment="Center"
                                ValueChanged="ReaderProgressSlider_ValueChanged">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#C7C7C3" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#B7B7B3" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#A7A7A3" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#B4B4B0" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#A4A4A0" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#949490" />
                            </Slider.Resources>
                        </Slider>
                        <TextBlock x:Name="ReaderChapterText"
                                   Grid.Column="3"
                                   Margin="0,0,10,0"
                                   MaxWidth="320"
                                   FontSize="11"
                                   Foreground="#5E5E5E"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="4"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="#F2F2F0"
                                BorderBrush="#D5D5D1"
                                BorderThickness="1"
                                Visibility="{Binding Visibility, ElementName=ReaderPdfBottomText}">
                            <TextBlock x:Name="ReaderPdfBottomText"
                                       Text="PDF"
                                       FontSize="9"
                                       Foreground="#5E5E5E" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- AI conversation and persistent annotations. -->
            <Border x:Name="ReaderAssistantPanel"
                    Grid.Column="2"
                    Margin="0,38,0,0"
                    Background="#FFFFFF">
                <Border.Resources>
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#B4B4B0" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A4A4A0" />
                    <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#FFFFFF" />
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Long separator below the assistant header. -->
                    <Rectangle Grid.Row="1"
                               Grid.RowSpan="3"
                               Width="1"
                               HorizontalAlignment="Left"
                               Fill="#EEEEEA"
                               IsHitTestVisible="False" />

                    <Border Background="#FFFFFF"
                            BorderBrush="#EEEEEA"
                            BorderThickness="0,0,0,1">
                        <Grid Padding="14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="AI 助手" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ReaderAiProviderText"
                                           Text="DeepSeek · 未配置"
                                           FontSize="9"
                                           MaxWidth="170"
                                           Foreground="#888888"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <Button VerticalAlignment="Center"
                                        Style="{StaticResource ReaderHeaderIconButtonStyle}"
                                        AutomationProperties.Name="收起阅读助手"
                                        ToolTipService.ToolTip="收起阅读助手"
                                        Click="ReaderAssistantToggleButton_Click">
                                    <FontIcon Glyph="&#xE76C;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Padding="12,4" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ReaderAiTabButton"
                                Content="AI 对话"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                Click="ReaderAiTabButton_Click" />
                        <Button x:Name="ReaderNotesTabButton"
                                Grid.Column="1"
                                Content="划线与笔记"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                Style="{StaticResource ReaderToolbarButtonStyle}"
                                Click="ReaderNotesTabButton_Click" />
                    </Grid>

                    <Grid x:Name="ReaderAiView" Grid.Row="2">
                        <ScrollViewer x:Name="ReaderAiScrollViewer"
                                      Padding="14,14,14,18"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="13">
                                <StackPanel x:Name="ReaderAiEmptyState" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#777777" />
                                    <TextBlock Text="基于当前选文和本地书籍索引对话"
                                               MaxWidth="250"
                                               FontSize="12"
                                               Foreground="#777777"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="总结本章"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderAiSummarizeChapterButton_Click" />
                                    <Button Grid.Column="1"
                                            Content="解释选中"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderAiExplainSelectionButton_Click" />
                                    <Button Grid.Row="1"
                                            Content="全书概览"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderAiSummarizeBookButton_Click" />
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Content="清空对话"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderAiClearButton_Click" />
                                </Grid>

                                <StackPanel x:Name="ReaderChatMessagesPanel" Spacing="10" />

                                <TextBlock x:Name="ReaderAiStatusText"
                                           Text="本地索引将在打开 EPUB 后自动准备"
                                           FontSize="10"
                                           Foreground="#777777"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="ReaderAiSourcesPanel" Spacing="5" Visibility="Collapsed">
                                    <TextBlock Text="本次参考" FontSize="10" Foreground="#777777" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ReaderNotesView"
                          Grid.Row="2"
                          Grid.RowSpan="2"
                          Visibility="Collapsed">
                        <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <TextBlock Text="为正文中选中的文字添加划线和笔记。批注仅保存在本机。"
                                           FontSize="11"
                                           Foreground="#6F6F6F"
                                           TextWrapping="Wrap" />
                                <Border Padding="10"
                                        Background="#FFFFFF"
                                        BorderBrush="#000000"
                                        BorderThickness="1"
                                        CornerRadius="0">
                                    <TextBlock x:Name="ReaderAnnotationSelectionText"
                                               Text="请先在正文中选择一段文字，再点击顶部“批注”。"
                                               FontSize="12"
                                               MaxLines="5"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </Border>
                                <TextBox x:Name="ReaderAnnotationNoteBox"
                                         MinHeight="76"
                                         Padding="10,8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         CornerRadius="0"
                                         BorderBrush="#000000"
                                         PlaceholderText="写下对这段文字的想法（可留空）" />
                                <Grid Margin="0,0,0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="划线颜色（淡色覆盖正文）"
                                                   FontSize="9"
                                                   Foreground="#777777" />
                                        <ComboBox x:Name="ReaderAnnotationColorBox"
                                                  SelectedIndex="0"
                                                  MinHeight="32"
                                                  FontSize="10"
                                                  CornerRadius="0"
                                                  BorderBrush="#000000"
                                                  BorderThickness="1"
                                                  AutomationProperties.Name="选择划线颜色">
                                            <ComboBoxItem Content="黑色" Tag="#000000" />
                                            <ComboBoxItem Content="黄色" Tag="#F1C40F" />
                                            <ComboBoxItem Content="蓝色" Tag="#4A90E2" />
                                            <ComboBoxItem Content="绿色" Tag="#38A169" />
                                            <ComboBoxItem Content="红色" Tag="#D95F76" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="线条样式"
                                                   FontSize="9"
                                                   Foreground="#777777" />
                                        <ComboBox x:Name="ReaderAnnotationStyleBox"
                                                  SelectedIndex="0"
                                                  MinHeight="32"
                                                  FontSize="10"
                                                  CornerRadius="0"
                                                  BorderBrush="#000000"
                                                  BorderThickness="1"
                                                  AutomationProperties.Name="选择划线样式">
                                            <ComboBoxItem Content="直线" Tag="solid" />
                                            <ComboBoxItem Content="双线" Tag="double" />
                                            <ComboBoxItem Content="虚线" Tag="dashed" />
                                            <ComboBoxItem Content="点线" Tag="dotted" />
                                            <ComboBoxItem Content="波浪线" Tag="wavy" />
                                            <ComboBoxItem Content="荧光标记（黑白反色）" Tag="marker" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Button Content="保存划线与笔记"
                                        HorizontalAlignment="Stretch"
                                        BorderThickness="1"
                                        Style="{StaticResource ReaderToolbarButtonStyle}"
                                        Click="ReaderAnnotationSaveButton_Click" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="本书批注" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="点击条目回到正文" FontSize="9" Foreground="#777777" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button x:Name="ReaderDeleteAnnotationButton"
                                            Grid.Column="1"
                                            Content="删除选中"
                                            IsEnabled="False"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderDeleteAnnotationButton_Click" />
                                </Grid>
                                <ListView x:Name="ReaderAnnotationList"
                                          MinHeight="160"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="True"
                                          SelectionChanged="ReaderAnnotationList_SelectionChanged"
                                          ItemClick="ReaderAnnotationList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="core:ReaderAnnotation">
                                            <Border Margin="0,0,0,7"
                                                    Padding="10"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#000000"
                                                    BorderThickness="1"
                                                    CornerRadius="0">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{x:Bind DisplayQuote}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               MaxLines="3"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind DisplayNote}"
                                                               FontSize="10"
                                                               Foreground="#707070"
                                                               MaxLines="3"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid Margin="0,4,0,8" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="导出 Markdown"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderExportMarkdownButton_Click" />
                                    <Button Grid.Column="1"
                                            Content="导出文本"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="1"
                                            Style="{StaticResource ReaderToolbarButtonStyle}"
                                            Click="ReaderExportTextButton_Click" />
                                </Grid>
                                <TextBlock x:Name="ReaderExportStatusText"
                                           FontSize="10"
                                           Foreground="#6F6F6F"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ReaderAiComposer"
                          Grid.Row="3"
                          Padding="12"
                          BorderBrush="#000000"
                          BorderThickness="0,1,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="思考深度"
                                           FontSize="9"
                                           Foreground="#777777" />
                                <ComboBox x:Name="ReaderAiReasoningDepthBox"
                                          HorizontalAlignment="Stretch"
                                          MinHeight="32"
                                          FontSize="10"
                                          CornerRadius="0"
                                          BorderBrush="#000000"
                                          BorderThickness="1"
                                          SelectionChanged="ReaderAiReasoningDepthBox_SelectionChanged"
                                          AutomationProperties.Name="选择思考深度">
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="模型"
                                           FontSize="9"
                                           Foreground="#777777" />
                                <ComboBox x:Name="ReaderAiModelSelectorBox"
                                          HorizontalAlignment="Stretch"
                                          MinHeight="32"
                                          FontSize="10"
                                          CornerRadius="0"
                                          BorderBrush="#000000"
                                          BorderThickness="1"
                                          PlaceholderText="选择模型"
                                          SelectionChanged="ReaderAiModelSelectorBox_SelectionChanged"
                                          AutomationProperties.Name="选择 AI 模型" />
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="ReaderAiQuestionBox"
                                 Grid.Row="1"
                                 MinHeight="74"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 CornerRadius="0"
                                 BorderBrush="#000000"
                                 PlaceholderText="询问这本书…（Ctrl+Enter 发送）"
                                 KeyDown="ReaderAiQuestionBox_KeyDown" />
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="仅发送相关片段，不上传整本书"
                                       FontSize="9"
                                       Foreground="#888888"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ReaderAiSendButton"
                                    Grid.Column="1"
                                    Content="发送"
                                    MinWidth="66"
                                    BorderThickness="1"
                                    Style="{StaticResource ReaderToolbarButtonStyle}"
                                    Click="ReaderAiSendButton_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Reading layout settings (per book). Hosted in a Popup because the
                 WebView2 HWND island would otherwise cover the panel. -->
            <Grid x:Name="ReaderLayoutSettingsOverlay"
                  Grid.ColumnSpan="3"
                  Margin="0,38,0,0"
                  Canvas.ZIndex="85"
                  Background="#66000000"
                  Visibility="Collapsed">
                <Grid.Resources>
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#B4B4B0" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A4A4A0" />
                    <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#FFFFFF" />
                </Grid.Resources>
                <Border Width="580"
                        MaxHeight="760"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FFFFFF"
                        BorderBrush="#000000"
                        BorderThickness="2"
                        CornerRadius="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Padding="22,20" Spacing="12">
                                <TextBlock Text="阅读排版设置" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="这些设置只对当前这本书生效，并在下次打开时自动恢复。"
                                           FontSize="11"
                                           Foreground="#666666"
                                           TextWrapping="Wrap" />
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="字号" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderFontScaleValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderFontScaleSlider"
                                            Minimum="0.8"
                                            Maximum="1.8"
                                            StepFrequency="0.1"
                                            Value="1.0"
                                            ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="行高" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderLineHeightValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderLineHeightSlider"
                                            Minimum="1.3"
                                            Maximum="2.6"
                                            StepFrequency="0.05"
                                            Value="1.88"
                                            ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="正文最大宽度" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderMaxWidthValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderMaxWidthSlider"
                                            Minimum="480"
                                            Maximum="1200"
                                            StepFrequency="20"
                                            Value="800"
                                            ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="左右边距" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ReaderBodyPaddingValueText" Grid.Column="1" FontSize="11" Foreground="#5A5A5A" />
                                    </Grid>
                                    <Slider x:Name="ReaderBodyPaddingSlider"
                                            Minimum="24"
                                            Maximum="160"
                                            StepFrequency="8"
                                            Value="68"
                                            ValueChanged="ReaderLayoutSettingChanged">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#30302E" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#111111" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="正文字体（CJK 覆盖）" FontSize="11" />
                                    <ComboBox x:Name="ReaderFontFamilyBox"
                                              HorizontalAlignment="Stretch"
                                              CornerRadius="0"
                                              BorderBrush="#000000"
                                              BorderThickness="1"
                                              SelectionChanged="ReaderFontFamilyBox_SelectionChanged">
                                        <ComboBoxItem Content="京华老宋体" Tag="京华老宋体" />
                                        <ComboBoxItem Content="微软雅黑 Microsoft YaHei UI" Tag="Microsoft YaHei UI" />
                                        <ComboBoxItem Content="宋体 SimSun" Tag="SimSun" />
                                        <ComboBoxItem Content="黑体 SimHei" Tag="SimHei" />
                                        <ComboBoxItem Content="楷体 KaiTi" Tag="KaiTi" />
                                        <ComboBoxItem Content="等线 DengXian" Tag="DengXian" />
                                        <ComboBoxItem Content="思源宋体 / Noto Serif CJK" Tag="Source Han Serif SC, Noto Serif CJK SC" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="ReaderVerticalWritingCheck"
                                          Content="竖排排版（滚动与分页模式）"
                                          FontSize="12"
                                          Click="ReaderVerticalWritingCheck_Click" />
                                <TextBlock x:Name="ReaderLayoutSettingsStatusText"
                                           FontSize="10"
                                           Foreground="#777777"
                                           TextWrapping="Wrap" />
                                <Button Content="恢复默认值"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="ReaderLayoutResetButton_Click" />
                            </StackPanel>
                            <Grid Grid.Row="1" Padding="22,14,22,20">
                                <Button Content="关闭"
                                        Style="{StaticResource QuietButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Click="ReaderLayoutSettingsCloseButton_Click" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Text-selection quick action bar (monochrome). Hosted in a Popup
                 positioned above the current selection in the WebView. -->
            <Border x:Name="ReaderSelectionBar"
                    Padding="3"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="1"
                    CornerRadius="0"
                    Canvas.ZIndex="90"
                    Visibility="Collapsed">
                <Border.Resources>
                    <Style x:Key="ReaderSelectionSeparatorStyle" TargetType="Rectangle">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Height" Value="18" />
                        <Setter Property="Fill" Value="#D5D5D1" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="ReaderSelectionActionStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" />
                        <Setter Property="MinWidth" Value="52" />
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Padding" Value="8,3" />
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Setter Property="Foreground" Value="#000000" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SelectionActionBackground"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionActionBackground" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#F2F2F2" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionActionContent" Storyboard.TargetProperty="Foreground">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#000000" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionActionBackground" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#D9D9D9" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter x:Name="SelectionActionContent"
                                                          Content="{TemplateBinding Content}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="ReaderSelectionCopyButton"
                            Content="复制"
                            Style="{StaticResource ReaderSelectionActionStyle}"
                            Click="ReaderSelectionCopyButton_Click" />
                    <Rectangle Style="{StaticResource ReaderSelectionSeparatorStyle}" />
                    <Button x:Name="ReaderSelectionHighlightButton"
                            Content="划线 ▾"
                            Style="{StaticResource ReaderSelectionActionStyle}"
                            PointerEntered="ReaderSelectionHighlightButton_PointerEntered"
                            PointerExited="ReaderSelectionHighlightButton_PointerExited">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="直线  ───" Tag="solid" Click="ReaderSelectionHighlightStyle_Click" />
                                <MenuFlyoutItem Text="双线  ═══" Tag="double" Click="ReaderSelectionHighlightStyle_Click" />
                                <MenuFlyoutItem Text="虚线  ┄┄┄" Tag="dashed" Click="ReaderSelectionHighlightStyle_Click" />
                                <MenuFlyoutItem Text="点线  ···" Tag="dotted" Click="ReaderSelectionHighlightStyle_Click" />
                                <MenuFlyoutItem Text="波浪线  ﹏﹏" Tag="wavy" Click="ReaderSelectionHighlightStyle_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="荧光标记（黑白反色）  ▰" Tag="marker" Click="ReaderSelectionHighlightStyle_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Rectangle Style="{StaticResource ReaderSelectionSeparatorStyle}" />
                    <Button x:Name="ReaderSelectionAnnotateButton"
                            Content="批注"
                            Style="{StaticResource ReaderSelectionActionStyle}"
                            Click="ReaderSelectionAnnotateButton_Click" />
                    <Rectangle Style="{StaticResource ReaderSelectionSeparatorStyle}" />
                    <Button x:Name="ReaderSelectionAiExplainButton"
                            Content="AI 解释"
                            Style="{StaticResource ReaderSelectionActionStyle}"
                            Click="ReaderSelectionAiExplainButton_Click" />
                    <Rectangle Style="{StaticResource ReaderSelectionSeparatorStyle}" />
                    <Button x:Name="ReaderSelectionSearchButton"
                             Content="搜索"
                             Style="{StaticResource ReaderSelectionActionStyle}"
                             Click="ReaderSelectionSearchButton_Click" />
                    <Rectangle Style="{StaticResource ReaderSelectionSeparatorStyle}" />
                    <Button x:Name="ReaderSelectionDictionaryButton"
                            Content="词典"
                            Style="{StaticResource ReaderSelectionActionStyle}"
                            Click="ReaderSelectionDictionaryButton_Click" />
                </StackPanel>
            </Border>

            <!-- Footnote preview hosted in a Popup so it stays above the WebView2
                 composition island. It is deliberately monochrome and square. -->
            <Border x:Name="ReaderFootnotePopup"
                    Width="360"
                    MaxHeight="260"
                    Padding="12,10"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    CornerRadius="0"
                    Canvas.ZIndex="95"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border.Resources>
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#B4B4B0" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A4A4A0" />
                    <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#C9C9C5" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#FFFFFF" />
                </Border.Resources>
                <ScrollViewer MaxHeight="236"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReaderFootnoteText"
                               Foreground="#000000"
                               FontSize="12"
                               LineHeight="20"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Custom Douban matching workspace. Kept inside the window so it uses
             the same typography, square borders and monochrome controls. -->
        <Grid x:Name="DoubanMatchOverlay"
              Grid.ColumnSpan="3"
              Margin="0,38,0,0"
              Canvas.ZIndex="105"
              Background="#66000000"
              Visibility="Collapsed"
              IsTabStop="True"
              KeyDown="DoubanMatchOverlay_KeyDown">
            <Border Width="860"
                    MaxWidth="860"
                    Height="690"
                    MaxHeight="690"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="24,18,20,16" BorderBrush="#000000" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="10" Height="34" Fill="#000000" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DoubanMatchTitleText" Text="豆瓣匹配" FontSize="24" FontWeight="Bold" />
                            <TextBlock x:Name="DoubanMatchSubtitleText"
                                       Text="选择与本地书籍对应的豆瓣条目"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="关闭"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="DoubanMatchCancelButton_Click" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid x:Name="DoubanCandidateView" Padding="20,16,20,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="点击候选项查看封面和书籍信息；确认后仍可选择具体更新字段。"
                                       Margin="4,0,0,10"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}" />
                            <ListView x:Name="DoubanCandidateList"
                                      Grid.Row="1"
                                      ItemsSource="{x:Bind DoubanCandidates}"
                                      SelectionMode="Single"
                                      SelectionChanged="DoubanCandidateList_SelectionChanged"
                                      DoubleTapped="DoubanCandidateList_DoubleTapped">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="3" />
                                        <Setter Property="Margin" Value="0,0,0,7" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:DoubanCandidateViewModel">
                                        <Border Padding="12"
                                                Background="#FFFFFF"
                                                BorderBrush="{x:Bind CandidateBorderBrush, Mode=OneWay}"
                                                BorderThickness="{x:Bind CandidateBorderThickness, Mode=OneWay}"
                                                CornerRadius="0">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="76" Height="106" Background="#E4E4E4" BorderBrush="#000000" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="BOOK" FontSize="10" CharacterSpacing="120"
                                                                   Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" MaxLines="2" />
                                                    <TextBlock Text="{x:Bind Abstract}" FontSize="12" LineHeight="18"
                                                               Foreground="#505050" TextWrapping="Wrap" MaxLines="3" />
                                                    <TextBlock Text="{x:Bind SubjectText}" FontSize="10" Foreground="#777777" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Padding="10,6" MinWidth="86" Height="34"
                                                        Background="#000000" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind RatingText}" Foreground="#FFFFFF"
                                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Grid x:Name="DoubanPreviewView" Padding="24,20" Visibility="Collapsed" ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="12">
                                <Border Width="190" Height="270" Background="#E4E4E4" BorderBrush="#000000" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="BOOK" FontSize="14" CharacterSpacing="160"
                                                   Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="DoubanPreviewCoverImage" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <Button Content="打开豆瓣详情页"
                                        Style="{StaticResource QuietButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="DoubanOpenSourceButton_Click" />
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12" Padding="0,0,8,10">
                                    <TextBlock x:Name="DoubanPreviewSummaryText"
                                               FontSize="13"
                                               LineHeight="21"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                    <Border Height="1" Background="#000000" Margin="0,2" />
                                    <TextBlock Text="选择写入本地书库的内容" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="18" RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="DoubanUpdateTitleCheck" Content="更新书名" />
                                        <CheckBox x:Name="DoubanUpdateAuthorsCheck" Grid.Column="1" Content="更新作者" />
                                        <CheckBox x:Name="DoubanUpdateSeriesCheck" Grid.Row="1" Content="更新系列" />
                                        <CheckBox x:Name="DoubanUpdateDescriptionCheck" Grid.Row="1" Grid.Column="1" Content="更新简介" />
                                        <CheckBox x:Name="DoubanUpdateCoverCheck" Grid.Row="2" Content="更新封面" />
                                        <CheckBox x:Name="DoubanUpdatePublicationCheck" Grid.Row="2" Grid.Column="1" Content="更新出版信息与评分" />
                                    </Grid>
                                    <TextBlock Text="出版社、出版年、ISBN、页数、装帧和豆瓣评分会随书籍保存在本地书库。"
                                               FontSize="10" Foreground="#777777" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="DoubanMatchBusyLayer" Background="#CCFFFFFF" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <ProgressRing Width="36" Height="36" IsActive="True" Foreground="#000000" />
                                <TextBlock x:Name="DoubanMatchBusyText" Text="正在读取豆瓣详情…" FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Padding="24,14,24,20" BorderBrush="#000000" BorderThickness="0,1,0,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DoubanMatchBackButton"
                                Content="返回候选"
                                Style="{StaticResource QuietButtonStyle}"
                                Visibility="Collapsed"
                                Click="DoubanMatchBackButton_Click" />
                        <TextBlock x:Name="DoubanMatchStatusText" Grid.Column="1" FontSize="10" Foreground="#777777"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Content="取消" Style="{StaticResource QuietButtonStyle}"
                                Click="DoubanMatchCancelButton_Click" />
                        <Button x:Name="DoubanMatchPrimaryButton"
                                Grid.Column="3"
                                Content="查看详情"
                                IsEnabled="False"
                                Click="DoubanMatchPrimaryButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Fully custom monochrome device confirmation; avoids WinUI popup theming. -->
        <Grid x:Name="DevicePromptOverlay"
              Grid.ColumnSpan="3"
              Canvas.ZIndex="100"
              Background="#66000000"
              Visibility="Collapsed"
              IsTabStop="True"
              KeyDown="DevicePromptOverlay_KeyDown">
            <Border Width="560"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="28,24,28,22" Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10"
                                       Height="24"
                                       Margin="0,-2,0,0"
                                       Fill="#000000"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DevicePromptTitleText"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="DevicePromptMessageText"
                                   FontSize="15"
                                   LineHeight="23"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1"
                          Padding="28,18,28,22"
                          Background="#FFFFFF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DevicePromptPrimaryButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="DevicePromptPrimaryButton_Click" />
                        <Button x:Name="DevicePromptCancelButton"
                                Grid.Column="2"
                                Content="取消"
                                Style="{StaticResource QuietButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="DevicePromptCancelButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Custom device model input; keeps the monochrome overlay style. -->
        <Grid x:Name="DeviceModelInputOverlay"
              Grid.ColumnSpan="3"
              Canvas.ZIndex="100"
              Background="#66000000"
              Visibility="Collapsed"
              IsTabStop="True"
              KeyDown="DeviceModelInputOverlay_KeyDown">
            <Border Width="560"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="28,24,28,22" Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10"
                                       Height="24"
                                       Margin="0,-2,0,0"
                                       Fill="#000000"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DeviceModelInputTitleText"
                                       Text="自定义设备型号"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="DeviceModelInputMessageText"
                                   Text="输入该设备的型号名称，下次连接时会按 USB 串码自动匹配。"
