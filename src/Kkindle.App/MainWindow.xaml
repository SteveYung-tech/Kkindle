<Window
    x:Class="Kkindle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition x:Name="DetailColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="Kkindle" />
            <Button x:Name="AllBooksButton" Content="All" Click="NavigationButton_Click" />
            <TextBlock x:Name="SidebarCountText" />
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
            <TextBlock x:Name="LibrarySummaryText" />
            <TextBlock x:Name="KindleStatusText" />
            <ListView x:Name="BookList" SelectionChanged="BookList_SelectionChanged" />
            <ProgressBar x:Name="TaskProgress" />
            <TextBlock x:Name="TaskStatusText" />
        </StackPanel>
        <StackPanel Grid.Column="1">
            <GridView x:Name="BookGrid" IsItemClickEnabled="True" ItemClick="BookGrid_ItemClick" />
            <Border x:Name="DetailPane">
                <StackPanel>
                    <Button Content="Close" Click="CloseDetailButton_Click" />
                    <Image x:Name="DetailCoverImage" />
                    <TextBox x:Name="DetailsTitleBox" />
                    <TextBox x:Name="DetailsAuthorsBox" />
                    <TextBox x:Name="DetailsSeriesBox" />
                    <TextBox x:Name="DetailsTagsBox" />
                    <TextBox x:Name="DetailsDescriptionBox" />
                    <Button Content="Save" Click="SaveDetailsButton_Click" />
                    <Button Content="Send" Click="SendToKindleButton_Click" />
                    <Button Content="Delete" Click="DeleteBookButton_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
