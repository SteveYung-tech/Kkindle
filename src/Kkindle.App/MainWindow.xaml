<Window
    x:Class="Kkindle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Kkindle.Core"
    xmlns:infra="using:Kkindle.Infrastructure"
    xmlns:local="using:Kkindle">

    <Grid x:Name="RootGrid"
          Background="{StaticResource PageBackgroundBrush}"
          SizeChanged="RootGrid_SizeChanged">
    <Grid.Resources>
        <DataTemplate x:Key="LibraryPresenceGlyphTemplate">
            <Grid Width="23" Height="21" IsHitTestVisible="False">
                <!-- PC only: a simple laptop outline. -->
                <Canvas Width="23"
                        Height="21"
                        Visibility="{Binding ComputerOnlyPresenceVisibility}">
                    <Border Width="17"
                            Height="12"
                            Canvas.Left="3"
                            Canvas.Top="2"
                            CornerRadius="1.5"
                            BorderBrush="#000000"
                            BorderThickness="1.6" />
                    <Path Data="M 1,15 L 22,15 L 20,19 L 3,19 Z"
                          Fill="#000000" />
                    <Rectangle Width="7"
                               Height="1.2"
                               Canvas.Left="8"
                               Canvas.Top="15"
                               Fill="#FFFFFF" />
                </Canvas>

                <!-- Kindle only: reader body, text page and home bar. -->
                <Grid Width="15"
                      Height="21"
                      Visibility="{Binding KindleOnlyPresenceVisibility}">
                    <Border CornerRadius="2.5"
                            BorderBrush="#000000"
                            BorderThickness="1.6">
                        <Grid>
                            <Border Margin="2.5,2.5,2.5,5"
                                    BorderBrush="#000000"
                                    BorderThickness="1.2">
                                <StackPanel Margin="2,2" Spacing="1.3">
                                    <Rectangle Height="1" Fill="#000000" />
                                    <Rectangle Height="1" Fill="#000000" />
                                    <Rectangle Width="5" Height="1" HorizontalAlignment="Left" Fill="#000000" />
                                    <Rectangle Height="1" Fill="#000000" />
                                </StackPanel>
                            </Border>
                            <Rectangle Width="5"
                                       Height="1.5"
                                       Margin="0,0,0,1.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Fill="#000000" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Both libraries: an open book displayed on a laptop. -->
                <Canvas Width="23"
                        Height="21"
                        Visibility="{Binding BothLibrariesPresenceVisibility}">
                    <Border Width="18"
                            Height="13"
                            Canvas.Left="2.5"
                            Canvas.Top="1"
                            CornerRadius="1.5"
                            BorderBrush="#000000"
                            BorderThickness="1.6" />
                    <Path Data="M 1,15 L 22,15 L 20,19 L 3,19 Z"
                          Fill="#000000" />
                    <Rectangle Width="7"
                               Height="1.2"
                               Canvas.Left="8"
                               Canvas.Top="15"
                               Fill="#FFFFFF" />
                    <Path Data="M 5,4 L 11.5,6 L 11.5,13 L 5,11 Z"
                          Fill="#FFFFFF"
                          Stroke="#000000"
                          StrokeThickness="1.3" />
                    <Path Data="M 11.5,6 L 18,4 L 18,11 L 11.5,13 Z"
                          Fill="#FFFFFF"
                          Stroke="#000000"
                          StrokeThickness="1.3" />
                    <Ellipse Width="2.5"
                             Height="1.5"
                             Canvas.Left="10.25"
                             Canvas.Top="12"
                             Fill="#000000" />
                </Canvas>
            </Grid>
        </DataTemplate>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="200" />
            <ColumnDefinition x:Name="MainContentColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Invisible drag strip with caption buttons embedded in the page. -->
        <Grid x:Name="WindowChromeLayer"
              Grid.Row="0"
              Grid.ColumnSpan="3"
              Height="38"
              VerticalAlignment="Top"
              Canvas.ZIndex="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragRegion" Background="Transparent" />
            <TextBlock x:Name="ReaderBrandText"
                       Grid.Column="0"
                       Text="Kreader"
                       Foreground="#000000"
                       FontSize="18"
                       FontWeight="Bold"
                       CharacterSpacing="60"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                <Button x:Name="ReaderZenTitleTocButton"
                        Content="极简目录"
                        Width="92"
                        Height="38"
                        FontSize="11"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        AutomationProperties.Name="切换极简目录"
                        ToolTipService.ToolTip="显示或隐藏禅模式极简目录"
                        Visibility="Collapsed"
                        Click="ReaderZenMinimalTocButton_Click" />
                <Button x:Name="ReaderZenTitleExitButton"
                        Content="退出禅模式"
                        Width="104"
                        Height="38"
                        FontSize="11"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        AutomationProperties.Name="退出禅模式"
                        ToolTipService.ToolTip="退出禅模式，恢复目录与阅读助手"
                        Visibility="Collapsed"
                        Click="ReaderExitZenButton_Click" />
                <Button x:Name="MinimizeWindowButton"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        Click="MinimizeWindowButton_Click"
                        AutomationProperties.Name="最小化">
                    <FontIcon Glyph="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        Click="MaximizeWindowButton_Click"
                        AutomationProperties.Name="最大化">
                    <FontIcon x:Name="MaximizeWindowGlyph" Glyph="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="CloseWindowButton"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        Click="CloseWindowButton_Click"
                        AutomationProperties.Name="关闭">
                    <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Left navigation -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Padding="18,24,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" Background="#000000">
                        <TextBlock Text="K" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="Kkindle" Foreground="#000000" FontSize="18" FontWeight="Bold" CharacterSpacing="60" />
                        <TextBlock Text="个人电子书架" Foreground="#5A5A5A" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,24,0,16"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <Button x:Name="BookManagementSectionButton"
                                    Style="{StaticResource SidebarSectionButtonStyle}"
                                    Click="SidebarSectionButton_Click"
                                    PointerEntered="SidebarSectionButton_PointerEntered"
                                    PointerMoved="SidebarSectionButton_PointerEntered"
                                    PointerExited="SidebarSectionButton_PointerExited"
                                    AutomationProperties.Name="书籍管理，已展开">
                                <Grid>
                                    <TextBlock Text="书籍管理" VerticalAlignment="Center" />
                                    <FontIcon x:Name="BookManagementChevron"
                                               Glyph="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="10" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="BookManagementChildren" Spacing="3">
                            <Button x:Name="AllBooksButton"
                                    AutomationProperties.Name="电脑书库"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Click="NavigationButton_Click">
                                <Grid HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="AllBooksLabelText"
                                               Text="电脑书库"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="SidebarCountText"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="KindleBooksButton"
                                    AutomationProperties.Name="Kindle书库"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Click="KindleBooksButton_Click">
                                <Grid HorizontalAlignment="Stretch">
                                    <TextBlock Text="Kindle书库"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="DeviceBookCountText"
                                               Text="0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="ZLibraryBooksButton"
                                    AutomationProperties.Name="Z-Library 在线书库"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Click="ZLibraryBooksButton_Click">
                                <TextBlock Text="Z-Library 在线书库" VerticalAlignment="Center" />
                            </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Button x:Name="DeviceManagementSectionButton"
                                    Style="{StaticResource SidebarSectionButtonStyle}"
                                    Click="SidebarSectionButton_Click"
                                    PointerEntered="SidebarSectionButton_PointerEntered"
                                    PointerMoved="SidebarSectionButton_PointerEntered"
                                    PointerExited="SidebarSectionButton_PointerExited"
                                    AutomationProperties.Name="设备管理，已收起">
                                <Grid>
                                    <TextBlock Text="设备管理" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DeviceManagementChevron" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="DeviceManagementChildren" Spacing="3" Visibility="Collapsed">
                                <Button x:Name="FontManagementNavigationButton" Content="字体管理" Style="{StaticResource SidebarButtonStyle}" Click="FontManagementButton_Click" />
                                <Button x:Name="DictionaryManagementNavigationButton" Content="字典管理" Style="{StaticResource SidebarButtonStyle}" Click="DictionaryManagementButton_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Button x:Name="ReadingSectionButton"
                                    Style="{StaticResource SidebarSectionButtonStyle}"
                                    Click="SidebarSectionButton_Click"
                                    PointerEntered="SidebarSectionButton_PointerEntered"
                                    PointerMoved="SidebarSectionButton_PointerEntered"
                                    PointerExited="SidebarSectionButton_PointerExited"
                                    AutomationProperties.Name="阅读资料，已收起">
                                <Grid>
                                    <TextBlock Text="阅读资料" VerticalAlignment="Center" />
                                    <FontIcon x:Name="ReadingChevron" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ReadingChildren" Spacing="3" Visibility="Collapsed">
                                <Button x:Name="ReaderNotesNavigationButton"
                                        Content="笔记与标注"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Click="ReaderNotesNavigationButton_Click" />
                                <Button x:Name="ReaderExportNavigationButton"
                                        Content="导出记录"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Click="ReaderExportNavigationButton_Click" />
                                <Button x:Name="ReadingDashboardNavigationButton"
                                        Content="阅读数据"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Click="ReadingDashboardButton_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Button x:Name="SystemSectionButton"
                                    Style="{StaticResource SidebarSectionButtonStyle}"
                                    Click="SidebarSectionButton_Click"
                                    PointerEntered="SidebarSectionButton_PointerEntered"
                                    PointerMoved="SidebarSectionButton_PointerEntered"
                                    PointerExited="SidebarSectionButton_PointerExited"
                                    AutomationProperties.Name="系统设置，已收起">
                                <Grid>
                                    <TextBlock Text="系统设置" VerticalAlignment="Center" />
                                    <FontIcon x:Name="SystemChevron" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="SystemChildren" Spacing="3" Visibility="Collapsed">
                                <Button x:Name="SettingsNavigationButton" Content="基础设置" Style="{StaticResource SidebarButtonStyle}" Click="SettingsButton_Click" />
                                <Button x:Name="KindleEmailSettingsNavigationButton" Content="Kindle 邮箱设置" Style="{StaticResource SidebarButtonStyle}" Click="KindleEmailSettingsButton_Click" />
                                <Button x:Name="ZLibraryAccountNavigationButton" Content="Z-Library 账号设置" Style="{StaticResource SidebarButtonStyle}" Click="ZLibraryAccountButton_Click" />
                                <Button x:Name="ReaderAiSettingsNavigationButton" Content="AI 助手设置" Style="{StaticResource SidebarButtonStyle}" Click="ReaderAiSettingsButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="DeviceStatusBox"
                        Grid.Row="2"
                        Padding="10"
                        Background="#FFFFFF"
                        BorderBrush="#000000"
                        BorderThickness="1"
                        CornerRadius="0"
                        Tapped="DeviceStatusBox_Tapped"
                        ToolTipService.ToolTip="点击选择或自定义设备型号（按串码记忆）；未连接时点击可重新检测 Kindle">
                    <StackPanel Spacing="5">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="KindleStatusText"
                                       Foreground="#000000"
                                       FontWeight="Bold"
                                       Text="正在检查设备…"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="EjectDeviceButton"
                                    Grid.Column="1"
                                    AutomationProperties.Name="弹出设备"
                                    Style="{StaticResource EjectButtonStyle}"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="未连接设备"
                                    Click="EjectDeviceButton_Click" />
                        </Grid>
                        <TextBlock x:Name="KindleConnectionText" Foreground="#5A5A5A" FontSize="10" />
                        <Grid x:Name="DeviceStorageBar" Height="10" Background="#FFFFFF" SizeChanged="DeviceStorageBar_SizeChanged">
                            <Rectangle x:Name="DeviceStorageUsedBar" HorizontalAlignment="Left" VerticalAlignment="Stretch" Fill="#000000" Width="0" />
                            <Border BorderBrush="#000000" BorderThickness="1" />
                        </Grid>
                        <TextBlock x:Name="DeviceStorageText" Text="无存储信息" Foreground="#5A5A5A" FontSize="10" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Rectangle Width="7" Height="7" Fill="#000000" VerticalAlignment="Center" />
                                <TextBlock Text="已用" FontSize="9" Foreground="#5A5A5A" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Rectangle Width="7" Height="7" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1" VerticalAlignment="Center" />
                                <TextBlock Text="剩余" FontSize="9" Foreground="#5A5A5A" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Window-level popup: offsets are calculated in RootGrid coordinates. -->
        <Popup x:Name="DeviceStatusPopup"
               IsLightDismissEnabled="False"
               ShouldConstrainToRootBounds="False">
            <StackPanel x:Name="DeviceStatusToast"
                        MaxWidth="360"
                        IsHitTestVisible="False">
                <Border Padding="8,7"
                        Background="#000000"
                        BorderBrush="#000000"
                        BorderThickness="1">
                    <TextBlock x:Name="DeviceConnectedToastText"
                               MaxWidth="342"
                               Text="设备已连接"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               Foreground="#FFFFFF"
                               FontSize="11" />
                </Border>
                <Polygon x:Name="DeviceStatusToastPointer"
                         Points="0,0 10,0 5,6"
                         Width="10"
                         Height="6"
                         Fill="#000000"
                         HorizontalAlignment="Left" />
            </StackPanel>
        </Popup>

        <!-- Library -->
        <Grid x:Name="LibraryPane"
              Grid.Row="0"
              Grid.Column="1"
              Padding="30,24,30,18"
              PointerPressed="LibraryPane_PointerPressed"
              AllowDrop="True"
              DragOver="LibraryPane_DragOver"
              DragLeave="LibraryPane_DragLeave"
              Drop="LibraryPane_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="本地" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="电脑书库"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="28"
                               FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="LibrarySummaryText"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource MutedInkBrush}"
                               Text="正在读取书库…" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,22,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         Height="38"
                         Padding="13,7"
                         PlaceholderText="搜索标题或作者"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#000000" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#000000" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#000000" />
                    </TextBox.Resources>
                </TextBox>
                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Left">
                    <Button x:Name="FilterButton"
                            Style="{StaticResource LibraryIconButtonStyle}"
                            Click="FilterButton_Click"
                            AutomationProperties.Name="筛选"
                            ToolTipService.ToolTip="筛选">
                        <SymbolIcon Symbol="Filter" />
                    </Button>
                    <Button x:Name="LibraryViewToggleButton"
                            Style="{StaticResource LibraryIconButtonStyle}"
                            AutomationProperties.Name="切换视图"
                            ToolTipService.ToolTip="切换视图">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem x:Name="LibraryViewGridItem"
                                                     Text="网格视图"
                                                     GroupName="LibraryViewMode"
                                                     Tag="Grid"
                                                     IsChecked="True"
                                                     Click="LibraryViewMenuItem_Click" />
                                <RadioMenuFlyoutItem x:Name="LibraryViewListItem"
                                                     Text="列表视图"
                                                     GroupName="LibraryViewMode"
                                                     Tag="List"
                                                     Click="LibraryViewMenuItem_Click" />
                                <RadioMenuFlyoutItem x:Name="LibraryViewCollectionsItem"
                                                     Text="收藏夹视图"
                                                     GroupName="LibraryViewMode"
                                                     Tag="Collections"
                                                     Click="LibraryViewMenuItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <SymbolIcon x:Name="LibraryViewToggleIcon" Symbol="ViewAll" />
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="#E2E2DE" VerticalAlignment="Center" Margin="2,0" />
                    <Button x:Name="LibraryImportButton"
                            Style="{StaticResource LibraryIconButtonStyle}"
                            AutomationProperties.Name="导入"
                            ToolTipService.ToolTip="导入">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="导入文件"
                                                Click="ImportFilesButton_Click" />
                                <MenuFlyoutItem Text="导入文件夹"
                                                Click="ImportFolderButton_Click" />
                                <MenuFlyoutItem Text="导入备份"
                                                Click="ImportBackupButton_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <SymbolIcon Symbol="OpenFile" />
                    </Button>
                    <Button Style="{StaticResource LibraryIconButtonStyle}"
                            Click="ExportBackupButton_Click"
                            AutomationProperties.Name="导出备份"
                            ToolTipService.ToolTip="导出备份">
                        <SymbolIcon Symbol="Upload" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="FilterPanel"
                    Grid.Row="2"
                    Margin="0,0,0,18"
                    Padding="12"
                    BorderBrush="#000000"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AuthorFilterBox"
                              Header="作者"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="TagFilterBox"
                              Grid.Column="1"
                              Header="标签"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="FormatFilterBox"
                              Grid.Column="2"
                              Header="格式"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="CategoryFilterBox"
                              Grid.Column="3"
                              Header="分类"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="ReadingStatusFilterBox"
                              Grid.Column="4"
                              Header="阅读状态"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="LibrarySortBox"
                              Grid.Column="5"
                              Header="排序"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <ComboBox x:Name="FavoritesOnlyFilterBox"
                              Grid.Column="6"
                              Header="收藏"
                              CornerRadius="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FilterComboBox_SelectionChanged" />
                    <Button Grid.Column="7"
                            Margin="0,22,0,0"
                            Content="清除筛选"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="ClearFiltersButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="CollectionBookHeader"
                        Grid.Row="0"
                        Margin="0,0,0,16"
                        Padding="0,0,0,12"
                        BorderBrush="#000000"
                        BorderThickness="0,0,0,1"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource QuietButtonStyle}"
                                Click="BackToCollectionsButton_Click"
                                AutomationProperties.Name="返回收藏夹">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Back" VerticalAlignment="Center" />
                                <TextBlock Text="返回收藏夹" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ActiveCollectionTitleText"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <GridView x:Name="BookGrid"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Books}"
                          IsItemClickEnabled="True"
                          ItemClick="BookGrid_ItemClick"
                          DoubleTapped="BookGrid_DoubleTapped"
                          PointerPressed="BookGrid_PointerPressed"
                          PointerMoved="BookGrid_PointerMoved"
                          PointerReleased="BookGrid_PointerReleased"
                          PointerCaptureLost="BookGrid_PointerCaptureLost"
                          KeyDown="BookGrid_KeyDown"
                          SelectionMode="None"
                          ItemContainerStyle="{StaticResource BookCardItemStyle}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:BookCardViewModel">
