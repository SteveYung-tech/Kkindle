        <!-- Custom monochrome folder-import format selection; consistent with
             the other overlays (white card, black borders, square corners). -->
        <Grid x:Name="ImportFormatSelectionOverlay"
              Grid.ColumnSpan="3"
              Canvas.ZIndex="105"
              Background="#66000000"
              Visibility="Collapsed"
              IsTabStop="True"
              KeyDown="ImportFormatSelectionOverlay_KeyDown">
            <Border Width="620"
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="28,24,28,22" Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10"
                                       Height="24"
                                       Margin="0,-2,0,0"
                                       Fill="#000000"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ImportFormatSelectionTitleText"
                                       Text="导入文件夹 · 选择格式补齐"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ImportFormatSelectionSummaryText"
                                   FontSize="15"
                                   LineHeight="23"
                                   TextWrapping="Wrap" />
                        <ScrollViewer x:Name="ImportFormatSelectionScroll"
                                      MaxHeight="360"
                                      VerticalScrollBarVisibility="Auto"
