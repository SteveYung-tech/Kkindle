<Window
    x:Class="Kkindle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Kkindle.Core"
    xmlns:local="using:Kkindle">

    <Grid x:Name="RootGrid" Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Padding="18,24,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" Background="#000000">
                        <TextBlock Text="K" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="Kkindle" Foreground="#000000" FontSize="18" FontWeight="Bold" CharacterSpacing="60" />
                        <TextBlock Text="个人电子书架" Foreground="#5A5A5A" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,24,0,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="3">
                            <TextBlock Text="书籍管理" Margin="10,0,0,4" Foreground="#5A5A5A" FontSize="11" FontWeight="Bold" />
                            <Button x:Name="AllBooksButton"
                                    AutomationProperties.Name="电脑书库"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="{StaticResource SelectedBackgroundBrush}"
                                    Foreground="#FFFFFF"
                                    Click="NavigationButton_Click">
                                <Grid Width="140">
                                    <TextBlock x:Name="AllBooksLabelText" Text="电脑书库" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="SidebarCountText" HorizontalAlignment="Right" Foreground="#FFFFFF" />
                                </Grid>
                            </Button>
                            <Button x:Name="KindleBooksButton" Content="Kindle 书籍" Style="{StaticResource SidebarButtonStyle}" Click="KindleBooksButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="设备管理" Margin="10,0,0,4" Foreground="#5A5A5A" FontSize="11" FontWeight="Bold" />
                            <Button x:Name="DeviceOverviewButton" Content="设备概览" Style="{StaticResource SidebarButtonStyle}" Click="DeviceOverviewButton_Click" />
                            <Button Content="字体管理 · 即将支持" Style="{StaticResource SidebarButtonStyle}" IsEnabled="False" />
                            <Button Content="字典管理 · 即将支持" Style="{StaticResource SidebarButtonStyle}" IsEnabled="False" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="阅读资料" Margin="10,0,0,4" Foreground="#5A5A5A" FontSize="11" FontWeight="Bold" />
                            <Button Content="笔记与标注 · 即将支持" Style="{StaticResource SidebarButtonStyle}" IsEnabled="False" />
                            <Button Content="导出记录 · 即将支持" Style="{StaticResource SidebarButtonStyle}" IsEnabled="False" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="系统" Margin="10,0,0,4" Foreground="#5A5A5A" FontSize="11" FontWeight="Bold" />
                            <Button Content="设置" Style="{StaticResource SidebarButtonStyle}" Click="SettingsButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="10" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" CornerRadius="0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="连接设备" FontSize="10" Foreground="#5A5A5A" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="KindleStatusText"
                                       Foreground="#000000"
                                       FontWeight="Bold"
                                       Text="正在检查设备…"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="EjectDeviceButton"
                                    Grid.Column="1"
                                    Width="25"
                                    Height="23"
                                    Padding="0"
                                    Content="▲"
                                    FontSize="10"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="弹出设备"
                                    Click="EjectDeviceButton_Click" />
                        </Grid>
                        <TextBlock x:Name="KindleConnectionText" Foreground="#5A5A5A" FontSize="10" />
                        <Grid x:Name="DeviceStorageBar" Height="10" Background="#FFFFFF" SizeChanged="DeviceStorageBar_SizeChanged">
                            <Rectangle x:Name="DeviceStorageUsedBar" HorizontalAlignment="Left" VerticalAlignment="Stretch" Fill="#000000" Width="0" />
                            <Border BorderBrush="#000000" BorderThickness="1" />
                        </Grid>
                        <TextBlock x:Name="DeviceStorageText" Text="无存储信息" Foreground="#5A5A5A" FontSize="10" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Rectangle Width="7" Height="7" Fill="#000000" />
                                <TextBlock Text="已用" FontSize="9" Foreground="#5A5A5A" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Rectangle Width="7" Height="7" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1" />
                                <TextBlock Text="剩余" FontSize="9" Foreground="#5A5A5A" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Library -->
        <Grid x:Name="LibraryPane" Grid.Column="1" Padding="30,24,30,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="本地" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="电脑书库"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="28"
                               FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="LibrarySummaryText"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource MutedInkBrush}"
                               Text="正在读取书库…" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="导入文件" Style="{StaticResource QuietButtonStyle}" Click="ImportFilesButton_Click" />
                    <Button Content="导入文件夹" Style="{StaticResource QuietButtonStyle}" Click="ImportFolderButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,22,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         Height="38"
                         Padding="13,7"
                         PlaceholderText="搜索标题或作者"
                         TextChanged="SearchBox_TextChanged" />
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        Content="筛选"
                        Style="{StaticResource QuietButtonStyle}"
                        Click="FilterButton_Click" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Content="网格" Style="{StaticResource QuietButtonStyle}" Click="GridViewButton_Click" />
                    <Button Content="列表" Style="{StaticResource QuietButtonStyle}" Click="ListViewButton_Click" />
                    <Button Content="更多" Style="{StaticResource QuietButtonStyle}" Click="MoreButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <GridView x:Name="BookGrid"
                          ItemsSource="{x:Bind ViewModel.Books}"
                          IsItemClickEnabled="True"
                          ItemClick="BookGrid_ItemClick"
                          SelectionMode="None"
                          HorizontalContentAlignment="Stretch">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:BookCardViewModel">
                            <Grid Width="154" Margin="0,0,18,22">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="214" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="#D9D9D9"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Placement="Right"
                                                 CornerRadius="0"
                                                 Padding="0"
                                                 Background="#FFFFFF"
                                                 BorderBrush="#000000"
                                                 BorderThickness="1">
                                            <StackPanel Width="280" Padding="16" Spacing="7">
                                                <Border Background="#000000" Padding="7,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="本地书籍" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Authors}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                                <Rectangle Height="1" Fill="#000000" Margin="0,3" />
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="格式" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                                        <TextBlock Text="{x:Bind FormatLabel}" FontWeight="Bold" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="文件" FontSize="10" Foreground="{StaticResource MutedInkBrush}" />
                                                        <TextBlock Text="{x:Bind FileCountLabel}" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{x:Bind SeriesLabel}" FontSize="12" />
                                                <TextBlock Text="{x:Bind TagsLabel}" FontSize="12" />
                                                <TextBlock Text="{x:Bind DescriptionLabel}"
                                                           Margin="0,2,0,0"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                    <Grid>
                                        <TextBlock Text="BOOK"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#5A5A5A"
                                                   FontSize="17"
                                                   CharacterSpacing="160" />
                                        <Image Source="{x:Bind CoverImage}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,9,2,0" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Foreground="{StaticResource InkBrush}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2" />
                                    <TextBlock Text="{x:Bind Authors}"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind FormatLabel}"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="10" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <ListView x:Name="BookList"
                          Visibility="Collapsed"
                          ItemsSource="{x:Bind ViewModel.Books}"
                          SelectionChanged="BookList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:BookCardViewModel">
                            <Grid Padding="8,9" MinHeight="66">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="48" Background="#D9D9D9" BorderBrush="#000000" BorderThickness="1" CornerRadius="0">
                                    <Image Source="{x:Bind CoverImage}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind FileCountLabel}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Authors}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind FormatLabel}" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <ProgressBar x:Name="TaskProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="3" />
                <TextBlock x:Name="TaskStatusText"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="11"
                           HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <!-- Kindle device -->
        <Grid x:Name="DevicePage" Grid.Column="1" Visibility="Collapsed" Padding="30,24,30,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Background="#000000" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="设备" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="DevicePageTitleText" Text="Kindle 书籍" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="DeviceNameText" Text="未检测到设备" Foreground="{StaticResource MutedInkBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="刷新设备" Style="{StaticResource QuietButtonStyle}" Click="RefreshDeviceButton_Click" />
                    <Button Content="返回书架" Click="AllBooksButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="#000000" Padding="16" BorderBrush="#000000" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="存储空间" Foreground="#BFBFBF" FontSize="11" />
                        <TextBlock x:Name="DeviceCapacityText" Text="—" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" MinWidth="150" Background="#FFFFFF" Padding="16" BorderBrush="#000000" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="可见书籍" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                        <TextBlock x:Name="DeviceBookCountText" Text="0 本" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <ListView x:Name="DeviceBookList" Grid.Row="2" ItemsSource="{x:Bind DeviceBooks}" SelectionMode="None">
                <ListView.Header>
                    <Grid Padding="12,8" Background="#D9D9D9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文件" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="格式" FontWeight="Bold" />
                        <TextBlock Grid.Column="2" Text="大小" FontWeight="Bold" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:KindleBook">
                        <Grid Padding="8,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Format}" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="DeviceReadOnlyNote" Grid.Row="3"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource MutedInkBrush}"
                       Text="MTP 模式当前只读显示 documents；发送与删除将在传输校验完成后开放。" />
        </Grid>

        <!-- Book details -->
        <Border x:Name="DetailPane"
                Grid.Column="2"
                Visibility="Collapsed"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Padding="24" Spacing="13">
                    <Button Content="关闭" HorizontalAlignment="Right" Style="{StaticResource QuietButtonStyle}" Click="CloseDetailButton_Click" />
                    <Border Height="250" Background="#D9D9D9" BorderBrush="#000000" BorderThickness="1" CornerRadius="0">
                        <Image x:Name="DetailCoverImage" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="书籍信息" FontSize="20" FontWeight="Bold" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="标题" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsTitleBox" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="作者" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsAuthorsBox" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="系列" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsSeriesBox" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="标签" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsTagsBox" PlaceholderText="多个标签用逗号分隔" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="简介" FontSize="11" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="DetailsDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                    </StackPanel>
                    <Button Content="保存修改" Click="SaveDetailsButton_Click" />
                    <Button Content="发送到 Kindle" Style="{StaticResource QuietButtonStyle}" Click="SendToKindleButton_Click" />
                    <Button Content="从书库删除" Style="{StaticResource QuietButtonStyle}" Click="DeleteBookButton_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
