                    </StackPanel>
                    <Grid Grid.Row="1"
                          Padding="28,18,28,22"
                          Background="#FFFFFF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ImportFormatSelectionPrimaryButton"
                                Content="导入"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="ImportFormatSelectionPrimaryButton_Click" />
                        <Button Grid.Column="2"
                                Content="取消"
                                Style="{StaticResource QuietButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="ImportFormatSelectionCancelButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="TaskProgressPopup"
                Grid.ColumnSpan="3"
                Width="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,30"
                Padding="16"
                Background="#FFFFFF"
                BorderBrush="#000000"
                BorderThickness="2"
                CornerRadius="0"
                Canvas.ZIndex="75"
                IsHitTestVisible="False"
                Visibility="{Binding Visibility, ElementName=TaskProgress}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="任务进度"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <Border Grid.Row="1"
                        Height="10"
                        Margin="0,13,0,0"
                        Padding="1"
                        Background="#FFFFFF"
                        BorderBrush="#000000"
                        BorderThickness="1">
                    <ProgressBar x:Name="TaskProgress"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Background="Transparent"
                                 Foreground="#000000"
                                 CornerRadius="0"
                                 Visibility="Collapsed" />
                </Border>
                <TextBlock x:Name="TaskStatusText"
                           Grid.Row="2"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="11"
                           MaxLines="2"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border x:Name="BookConversionPopup"
                Grid.ColumnSpan="3"
                Width="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,30"
                Padding="16"
                Background="#FFFFFF"
                BorderBrush="#000000"
                BorderThickness="2"
                CornerRadius="0"
                Canvas.ZIndex="80"
                Visibility="Collapsed"
                Tapped="BookConversionPopup_Tapped">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="BookConversionPopupTitleText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BookConversionPopupFormatText"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <Button x:Name="BookConversionBackgroundButton"
                                Content="后台"
                                Padding="8,4"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BookConversionBackgroundButton_Click" />
                        <Button x:Name="BookConversionCancelButton"
                                Content="取消"
                                Padding="8,4"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BookConversionCancelButton_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:RectangularProgressBar x:Name="BookConversionPopupProgress"
                                                  Height="10"
                                                  Margin="0,0,8,0"
                                                  Minimum="0"
                                                  Maximum="100" />
                    <TextBlock x:Name="BookConversionPopupPercentageText"
                               Grid.Column="1"
                               Foreground="#000000"
                               FontSize="10"
                               FontWeight="SemiBold"
                               MinWidth="28"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="BookConversionPopupMessageText"
                           Grid.Row="2"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="11"
                           MaxLines="2"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border x:Name="TransferToast"
                Grid.ColumnSpan="3"
                Width="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,30"
                Padding="16"
                Background="#FFFFFF"
                BorderBrush="#000000"
                BorderThickness="2"
                CornerRadius="0"
                Canvas.ZIndex="90"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel Spacing="7">
                <TextBlock x:Name="TransferToastTitleText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TransferToastMessageText"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="11"
                           MaxLines="2"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="TransferToastProgress"
                             Height="5"
                             Minimum="0"
                             Maximum="100"
                             Foreground="#000000"
                             Background="#D9D9D9"
                             Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Fully custom monochrome message dialog; replaces WinUI ContentDialog. -->
        <Grid x:Name="MessageOverlay"
              Grid.ColumnSpan="3"
              Canvas.ZIndex="110"
              Background="#66000000"
              Visibility="Collapsed"
              IsTabStop="True"
              KeyDown="MessageOverlay_KeyDown">
            <Border Width="560"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#000000"
                    BorderThickness="2"
                    CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="28,24,28,22" Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="10"
                                       Height="24"
                                       Margin="0,-2,0,0"
                                       Fill="#000000"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="MessageTitleText"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="MessageBodyText"
                                   FontSize="15"
                                   LineHeight="23"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Grid Grid.Row="1"
                          Padding="28,18,28,22"
                          Background="#FFFFFF">
                        <Button x:Name="MessageOkButton"
                                Content="知道了"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="MessageOkButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
